def smart_probability(p, side, ctx, dist_atr, rr):
    """Probabilitas dari faktor struktur + supply-demand. v16: SELALU dicampur dengan data belajar
    (hasil nyata + sinyal bayangan) sesuai jumlah datanya, maksimal SMART_BLEND_MAX."""
    pl, nn = LEARNER.p_win(p["code_out"], side, ctx["regime"], int(p["trig"]), epb_of(p["ep"]))
    h = SMART_BASE_P
    h += 0.10 * min(float(p["zone_st"]), 10.0) / 10.0
    h += PRIO_P.get(p["prio"], 0.0)
    if p["code"] == "SR":
        h += 0.012 * min(int(p["ep"]), 5)
    if p["code"] == "SD" and int(p["ep"]) == 0:
        h += 0.03                                  # zona supply-demand segar
    if p["code"] == "BR":
        h -= BR_P_PENALTY
    h += 0.02 * min(int(p.get("conf", 0)), 3) + min(0.05, 0.004 * float(p.get("combo_w", 0.0)))
    h += 0.04 if p["anchored"] else 0.0
    h += BACK_P * float(p.get("back", 0.0))
    h += 0.03 if p["htf_ok"] else -0.03
    h += 0.02 if p["bias_ok"] else 0.0
    h -= 0.05 if p["counter"] else 0.0
    h += PAT_CONF_P * float(p.get("pat", 0.0))
    pa, _ = pd_adj(side, ctx["pdp"])
    h += 0.006 * pa
    ra, _ = regime_adj(p["code_out"], ctx["regime"])
    h += 0.004 * ra
    if rr >= 2.0:
        h += 0.03
    elif rr >= MIN_RR:
        h += 0.01
    else:
        h -= 0.04
    h -= 0.02 * min(max(0.0, dist_atr - 1.0), 3.0)
    h = min(0.80, max(0.25, h))
    w = min(SMART_BLEND_MAX, nn / (nn + SMART_BLEND_N))
    return min(0.85, max(0.15, (1.0 - w) * h + w * pl)), nn

