def build_zones(m1, m5, m15, a):
    """v24: sama dengan versi lama, ditambah field 'tf' (timeframe tertinggi pembentuk zona)."""
    pts = collect_pivots(m1, 1) + collect_pivots(m5, 5) + collect_pivots(m15, 15) + daily_points(m15)
    if not pts:
        return []
    a5 = float(atr(m5).iloc[-1]) if m5 is not None else 0.0
    az = max(a5, a * 1.5) if a5 > 0 else a * 2.0
    pts.sort(key=lambda x: x[0])
    tol = ZONE_TOL_A5 * az
    groups, cur = [], [pts[0]]
    for q in pts[1:]:
        if q[0] - cur[-1][0] <= tol and q[0] - cur[0][0] <= 2 * tol:
            cur.append(q)
        else:
            groups.append(cur)
            cur = [q]
    groups.append(cur)
    ref = m5 if m5 is not None else m1
    H5, L5, C5 = ref.high.values[-300:], ref.low.values[-300:], ref.close.values[-300:]
    zones = []
    for g in groups:
        prices = [x[0] for x in g]
        wts = [max(x[1], 1e-6) for x in g]
        mid = float(np.average(prices, weights=wts))
        w = max(max(prices) - min(prices), ZONE_MIN_W_A5 * az)
        w = min(w, ZONE_MAX_W_A5 * az)
        lo, hi = mid - w / 2, mid + w / 2
        st = sum(x[1] for x in g)
        ntf = len({x[3] for x in g})
        tfmax = max(x[3] for x in g)
        if ntf >= 3:
            st += 2.5
        elif ntf == 2:
            st += 1.5
        if abs(mid - round(mid / 10) * 10) <= tol:
            st += 2
        elif abs(mid - round(mid / 5) * 5) <= tol:
            st += 1
        if min(x[2] for x in g) <= 120:
            st += 1
        touch = (H5 >= lo) & (L5 <= hi)
        ep = (int(np.sum(touch[1:] & ~touch[:-1])) + int(touch[0])) if len(touch) else 0
        if ep >= 2:
            st += min(ZONE_EP_CAP, ZONE_EP_BONUS * ep)
        sgn = np.sign(C5 - mid)
        crosses = int(np.sum(sgn[1:] * sgn[:-1] < 0))
        st -= min(ZONE_CHOP_CAP, ZONE_CHOP_STEP * max(0, crosses - ZONE_CHOP_FREE_M5))
        zones.append({"lo": float(lo), "hi": float(hi), "mid": float(mid), "st": float(max(st, 0.0)),
                      "touches": len(g), "tfs": ntf, "ep": int(ep),
                      "htf": bool(any(x[3] >= 5 for x in g)),
                      "tf": "M15" if tfmax >= 15 else "M5" if tfmax >= 5 else "M1"})
    return zones


_plan_ob_v23 = plan_ob


def plan_ob(H, L, O, C, Av, n):
    """OB+FVG dipotong ke sisi DEKAT harga (ruang bullish: sisi atas) maksimal ZONE_CAP_OB_ATR x ATR."""
    a = float(Av[min(n, len(Av)) - 1])
    cap = ZONE_CAP_OB_ATR * a
    out = []
    for zl, zh in _plan_ob_v23(H, L, O, C, Av, n):
        if cap > 0 and zh - zl > cap:
            zl = zh - cap
        out.append((float(zl), float(zh)))
    return out


