def bot_step():
    """v20: pembatalan limit karena jeda/pause tidak lagi memblokir area (block=False)."""
    refresh_diag()
    mt5.symbol_select(SYMBOL, True)
    tick = mt5.symbol_info_tick(SYMBOL)
