def limit_guard(tick):
    """Return 'cancelled' | 'commit' | None.
    commit = aman, limit dibiarkan terisi (tidak dibatalkan karena fluktuasi P)."""
    if not GUARD_ON:
        return None
    tk = PENDING["order"]
    if not tk or not LAST_CTX:
        return None
    if not mt5.orders_get(ticket=tk):
        return None
    now = time.time()
    snap = PENDING.get("snap") or {}
    side = PENDING["side"]
    buy = side == "BUY"
    a = float(snap.get("atr") or LAST_CTX["a"])
    lvl = float(PENDING["entry"])
    px = float(tick.ask if buy else tick.bid)
    dist = (px - lvl) if buy else (lvl - px)
    thr = guard_threshold()
    P = PLAN_ACTIVE if (PLAN_ACTIVE is not None and PLAN_ACTIVE.get("id") == PENDING.get("plan")) else None
    if PENDING.get("touched"):
        if now - PENDING["touch_t"] < PENDING_TOUCH_GRACE_SEC - 0.5:
            return "commit"
        g = guard_eval(side, lvl, a, tick, P)
        if g["net"] < thr:
            return "commit"
    else:
        if dist > GUARD_NEAR_ATR * a:
            return None
        if dist <= 0:
            return "commit"
        g = guard_eval(side, lvl, a, tick, P)
        GUARD["last"] = {"side": side, "lvl": round(lvl, 2), "net": round(g["net"], 2),
                         "risk": round(g["risk"], 2), "hold": round(g["hold"], 2),
                         "why": g["why"][:3], "hwhy": g["hwhy"][:3], "t": int(now)}
        if now - GUARD["log_t"] >= 10:
            GUARD["log_t"] = now
            log(f"[PENJAGA] limit {side} {lvl:.2f} jarak {dist:.2f}: risiko tembus {g['net'] * 100:.0f}% "
                f"(ambang {thr * 100:.0f}%) | tembus: {', '.join(g['why'][:2]) or '-'} | "
                f"tahan: {', '.join(g['hwhy'][:2]) or '-'}")
        if g["net"] < thr:
            return "commit" if dist <= GUARD_COMMIT_ATR * a else None
    plan_id = PENDING.get("plan")
    reason = ", ".join(g["why"][:3]) or "tekanan searah tembusan"
    if cancel_pending(f"penjaga limit: risiko tembus {g['net'] * 100:.0f}% >= {thr * 100:.0f}% ({reason})",
                      force=True, block=False):
        GUARD["susp"] = {"plan": plan_id, "side": side, "lvl": lvl, "t": now, "net": g["net"]}
        guard_shadow(snap, lvl, g["net"])
        return "cancelled"
    return None

