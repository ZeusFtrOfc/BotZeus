def guard_feed(tick):
    now = time.time()
    GUARD_TICKS.append((now, float(tick.bid), float(tick.ask)))
    cut = now - GUARD_SPEED_SEC * 3
    while GUARD_TICKS and GUARD_TICKS[0][0] < cut:
        GUARD_TICKS.pop(0)


def guard_speed(buy, a):
    """Seberapa cepat harga bergerak MENUJU level dalam GUARD_SPEED_SEC terakhir (x ATR)."""
    if len(GUARD_TICKS) < 5 or not a > 0:
        return 0.0
    cur = GUARD_TICKS[-1]
    then = next((x for x in GUARD_TICKS if x[0] >= cur[0] - GUARD_SPEED_SEC), None)
    if then is None:
        return 0.0
    return max(0.0, (then[2] - cur[2]) / a) if buy else max(0.0, (cur[1] - then[1]) / a)


def guard_eval(side, lvl, a, tick, plan=None):
    """Nilai risiko harga menembus level limit sekarang. Return dict(net, risk, hold, why, hwhy, dist)."""
    buy = side == "BUY"
    sg = 1 if buy else -1
    px = float(tick.ask if buy else tick.bid)
    out = {"dist": (px - lvl) if buy else (lvl - px), "net": 0.0, "risk": 0.0, "hold": 0.0,
           "why": [], "hwhy": []}
    r = mt5.copy_rates_from_pos(SYMBOL, mt5.TIMEFRAME_M1, 0, 70)
    if r is None or len(r) < 40 or not a > 0:
        return out
    df = pd.DataFrame(r)
    cl, fm = df.iloc[:-1], df.iloc[-1]
    H, L, O, C = mirror_df(cl, buy)
    V = cl.tick_volume.values.astype(float)
    risk, hold, why, hwhy = approach_risk(H, L, O, C, V, a, len(C) - 1)
    R, Hd = [risk], [hold]

    # candle yang sedang berjalan (live)
    fh = float(fm["high"]) if buy else -float(fm["low"])
    fl_ = float(fm["low"]) if buy else -float(fm["high"])
    fo = float(fm["open"]) * sg
    pm = sg * px
    frng = max(fh - fl_, 1e-9)
    fd = (fo - pm) / a
    clv = (pm - fl_) / frng
    age = float(tick.time) - float(fm["time"])
    if fd >= 1.0 and clv <= 0.25 and age >= 4:
        R.append(min(0.5, 0.25 * fd))
        why.append(f"candle berjalan menekan {fd:.1f} ATR tanpa pantulan")
    if fd >= 0.5 and (pm - fl_) >= 0.5 * a:
        Hd.append(0.3)
        hwhy.append("pantulan terlihat di candle berjalan")
    sp = guard_speed(buy, a)
    if sp >= 0.6:
        R.append(min(0.45, 0.3 * sp))
        why.append(f"harga melaju {sp:.1f} ATR dalam {GUARD_SPEED_SEC:.0f} detik")

    # pembalikan, order-flow, prediksi arah
    opp = "SELL" if buy else "BUY"
    ro, rw = rev_score(opp)
    if ro >= 0.15:
        R.append(0.6 * ro)
        why.append(f"pola pembalikan {opp} {ro * 100:.0f}% ({', '.join(rw[:2])})")
    try:
        fl, _ = v17_flow(cl, buy, a)
        if fl <= -0.35:
            R.append(min(0.3, -0.25 * fl))
            why.append(f"order-flow melawan ({fl:+.2f})")
    except Exception:
        pass
    fa = fc_align(side)
    if fa <= -0.3:
        R.append(0.3 * -fa)
        why.append(f"prediksi arah melawan ({fa:+.2f})")
    if plan:
        bk = min(float(plan.get("back", 0.0) or 0.0), 1.0)
        if bk > 0:
            Hd.append(0.25 * bk)
            hwhy.append("area penting di belakang zona")
        if float(plan.get("strength", 0.0) or 0.0) >= 80:
            Hd.append(0.15)
            hwhy.append("area sangat kuat")
    risk_all, hold_all = _noisy_or(R), _noisy_or(Hd)
    out.update(risk=risk_all, hold=hold_all, why=why, hwhy=hwhy,
               net=max(0.0, min(1.0, risk_all - GUARD_HOLD_W * hold_all)))
    return out


