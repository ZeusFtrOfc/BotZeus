_exit_signals_v19 = exit_signals


def exit_signals(p, tick, a):
    """Smart exit: prediksi arah yang berbalik melawan posisi menjadi sinyal tambahan."""
    score, why, kinds = _exit_signals_v19(p, tick, a)
    try:
        side = "BUY" if p.type == mt5.POSITION_TYPE_BUY else "SELL"
        fa = fc_align(side)
        if fa <= -FC_EXIT_THR:
            w = min(1.5, 2.5 * abs(fa))
            score += w
