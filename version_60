def conviction(s):
    """Keyakinan 0..1: probabilitas (40%), kekuatan area (35%), jumlah kelompok bukti independen (25%)."""
    p = float(s.get("p", 0.0))
    st = float(s.get("strength", 0.0))
    g = int((s.get("smart") or {}).get("groups", 0))
    c = (0.40 * _c((p - 58.0) / 22.0, 0.0, 1.0) + 0.35 * _c((st - 55.0) / 40.0, 0.0, 1.0)
         + 0.25 * _c((g - 2.0) / 3.0, 0.0, 1.0))
    return float(c)


def relax_room_gate(setups, ctx):
    """Area sangat kuat tidak dibuang hanya karena ruang ke area lawan sempit (range antar-dua area kuat).
    Bot tidak memakai TP tetap, jadi ruang cukup jika >= max(ROOM_STRONG_MIN_RR x SL, ROOM_STRONG_MIN_ATR x ATR)."""
    a = float(ctx["a"])
    for s in setups:
        s["conv"] = round(conviction(s), 2)
        if not any(g.startswith("ruang sempit") for g in s["gates"]):
            continue
        if float(s.get("strength", 0.0)) < ROOM_STRONG_STRENGTH or float(s["pw"]) < ROOM_STRONG_P:
            continue
        room = float(s["rr"]) * float(s["sl_d"])
        need = max(ROOM_STRONG_MIN_RR * float(s["sl_d"]), ROOM_STRONG_MIN_ATR * a)
        if room >= need:
            s["gates"] = [g for g in s["gates"] if not g.startswith("ruang sempit")]
            s["room_ok"] = True
            s["tags"] = list(s["tags"]) + [
                f"ruang {room:.2f} USD cukup untuk area sangat kuat (konviksi {s['conv'] * 100:.0f}%)"]
            s["eligible"] = not [g for g in s["gates"] if ROOM_HARD or not g.startswith("ruang")]


def pattern_against(s, ctx):
    """Tolak entry yang melawan chart pattern terkunci, KECUALI penolakan tepat di neckline oleh area kuat.
    - Pola sudah breakout: sisi lawan ditolak.
    - Pola garis (wedge/segitiga/channel): aturan lama (BUY tidak boleh di atas garis bawah pola berbias SELL, dst).
    - Pola reversal (DB/TB/IHS) yang masih terbentuk: sisi lawan ditolak di TENGAH pola, tetapi di neckline
      (dalam NECK_REJECT_ATR) dan area kekuatan >= NECK_REJECT_MIN_STRENGTH diizinkan (tolakan dari neckline)."""
    if not PAT_AGAINST_ON:
        return None
    side = s["side"]
    buy = side == "BUY"
    mid = (float(s["zone_lo"]) + float(s["zone_hi"])) / 2.0
    t_now = int(ctx["T"][-1]) + 60
    strength = float(s.get("strength", 0.0))
    for tf, Lk in list(PAT_LOCK.items()):
        if float(Lk.get("quality", 0)) < PAT_AGAINST_MIN_Q:
            continue
        bias = Lk.get("bias")
        if bias not in ("BUY", "SELL") or bias == side:
            continue
        a_tf = next((float(x["a"]) for x in ctx["tfs"] if x["name"] == tf), float(ctx["a"]))
        nm = Lk["name"]
        if Lk["dir"] != 0:
            return f"melawan breakout {nm} [{tf}] ke arah {bias}"
        if Lk["kind"] == "lines":
            u, l = _line_at(Lk["up"], t_now), _line_at(Lk["lo"], t_now)
            if buy and mid > l - PAT_ESCAPE_ATR * a_tf:
                return f"BUY melawan pola {nm} [{tf}] berbias SELL, cari area SELL di garis atas pola"
            if (not buy) and mid < u + PAT_ESCAPE_ATR * a_tf:
                return f"SELL melawan pola {nm} [{tf}] berbias BUY, cari area BUY di garis bawah pola"
        else:
            ext = Lk.get("ext")
            if ext is None:
                continue
            nk = _line_at(Lk["neck"], t_now)
            if bias == "BUY" and (not buy) and ext - 0.2 * a_tf <= mid <= nk + 0.5 * a_tf:
                at_neck = mid >= nk - NECK_REJECT_ATR * a_tf
                if not (at_neck and strength >= NECK_REJECT_MIN_STRENGTH):
                    return f"SELL melawan pola {nm} [{tf}] berbias BUY (di tengah pola, bukan di neckline)"
            if bias == "SELL" and buy and nk - 0.5 * a_tf <= mid <= ext + 0.2 * a_tf:
                at_neck = mid <= nk + NECK_REJECT_ATR * a_tf
                if not (at_neck and strength >= NECK_REJECT_MIN_STRENGTH):
                    return f"BUY melawan pola {nm} [{tf}] berbias SELL (di tengah pola, bukan di neckline)"
    return None


def limit_level(P, a, live=False):
    """Level limit. Makin yakin (conviction) makin dangkal dari tepi zona supaya lebih mudah terisi.
    v17: menempel ke magnet (POC/HVN/VWAP/likuiditas) di jendela itu.
    live=True (hanya dari arm_entry/place_limit): jika harga SUDAH melewati level dan konviksi tinggi,
    pasang limit 'penangkap wick' sedikit lebih dalam di dalam zona, sehingga entry tidak terlewat."""
    zlo, zhi = float(P["zone_lo"]), float(P["zone_hi"])
    w = max(zhi - zlo, 0.1 * a)
    conv = conviction(P)
    frac = LIMIT_DEPTH_BY_CODE.get(P.get("code"), LIMIT_DEPTH_FRAC)
    back = min(float(P.get("back", 0.0) or 0.0), 1.0)
    frac *= (1.0 - 0.35 * back) * (1.0 - LIMIT_CONV_SHALLOW * conv)
    dmax = LIMIT_DEPTH_MAX_ATR * a * (1.0 - LIMIT_CONV_SHALLOW * conv)
    depth = min(frac * w, dmax)
    buy = P["side"] == "BUY"
    lvl = (zhi - depth) if buy else (zlo + depth)
    lvl = min(max(lvl, zlo), zhi)

    smx = LAST_CTX.get("smx") if LAST_CTX else None
    if V17_ON and V17_LIMIT_SNAP and smx:
        try:
            lo_w, hi_w = (max(zlo, zhi - dmax), zhi) if buy else (zlo, min(zhi, zlo + dmax))
            cands = [c for c in v17_limit_candidates(P, a, smx, lo_w, hi_w) if c[1] >= V17_LIMIT_MIN_W]
            if cands:
                edge = zhi if buy else zlo
                best = max(cands, key=lambda c: (round(c[1], 2), -abs(c[0] - edge)))
                lvl = min(max(best[0], zlo), zhi)
        except Exception:
            log_exc("limit_snap")

    if live and conv >= LIMIT_CATCH_CONV:
        try:
            tk = mt5.symbol_info_tick(SYMBOL)
            if tk is not None:
                px = float(tk.ask if buy else tk.bid)
                inside = zlo - 0.1 * a <= px <= zhi + 0.1 * a
                passed = (px <= lvl + LIMIT_MIN_GAP) if buy else (px >= lvl - LIMIT_MIN_GAP)
                if inside and passed:
                    gap = max(LIMIT_MIN_GAP * 3, LIMIT_CATCH_ATR * a)
                    alt = max(px - gap, zlo) if buy else min(px + gap, zhi)
                    if abs(px - alt) >= LIMIT_MIN_GAP * 2:
                        return alt
        except Exception:
            log_exc("limit_catch")
    return lvl


# ---------------------------------------------------------------- SMART EXIT
def exit_signals(p, tick, a):
    """Skor tanda pembalikan terhadap arah posisi. Return (skor, daftar alasan, set jenis sinyal)."""
    buy = p.type == mt5.POSITION_TYPE_BUY
    r = mt5.copy_rates_from_pos(SYMBOL, mt5.TIMEFRAME_M1, 0, 45)
    if r is None or len(r) < 20:
        return 0.0, [], set()
    df = pd.DataFrame(r)
    cl, fm = df.iloc[:-1], df.iloc[-1]
    H, L, O, C = mirror_df(cl, buy)          # ruang "posisi = long"; pembalikan = sinyal bearish
    T = cl.time.values
    k = len(C) - 1
    sg = 1 if buy else -1
    px = float(tick.bid if buy else tick.ask)
    entry = float(p.price_open)
    opp = "SELL" if buy else "BUY"
    score, why, kinds = 0.0, [], set()

    def add(kind, w, txt):
        nonlocal score
        score += w
        kinds.add(kind)
        why.append(f"{txt} (+{w:g})")

    fresh = float(T[k]) + 60 > float(p.time)          # candle tutup SETELAH posisi dibuka
    body = float(abs(C[k] - O[k]))
    rng = max(float(H[k] - L[k]), 1e-9)
    up_wick = float(H[k] - max(O[k], C[k]))
    pushed_high = float(H[k]) >= float(H[max(0, k - 6):k].max()) - 0.25 * a

    # 1) penolakan wick di pucuk
    if (fresh and pushed_high and up_wick >= EXIT_WICK_ATR * a
            and up_wick >= EXIT_WICK_RATIO * max(body, 0.05 * a)
            and (float(C[k] - L[k]) / rng) <= EXIT_WICK_CLOSE_FRAC):
        add("wick", 2.0, f"penolakan wick {up_wick / a:.1f} ATR di pucuk")

    # 2) engulfing berlawanan
    if (fresh and C[k] < O[k] and float(O[k] - C[k]) >= EXIT_ENG_BODY_ATR * a
            and C[k - 1] > O[k - 1] and C[k] < L[k - 1]):
        add("eng", 2.0, "engulfing berlawanan arah")

    # 3) momentum berbalik
    if fresh:
        two = (C[k] < O[k] and C[k - 1] < O[k - 1]
               and float((O[k] - C[k]) + (O[k - 1] - C[k - 1])) >= EXIT_MOM_ATR * a)
        one = C[k] < O[k] and float(O[k] - C[k]) >= 1.2 * a
        if two or one:
            add("mom", 1.5, "momentum berbalik (candle melawan kuat)")

    # 4) wick pada candle yang masih berjalan (live)
    if buy:
        fh, fo = float(fm.high), float(fm.open)
    else:
        fh, fo = -float(fm.low), -float(fm.open)
    lp = sg * px
    age_f = float(state.get("srv") or time.time()) - float(fm.time)
    if ("wick" not in kinds and age_f >= 8 and fh - max(fo, lp) >= EXIT_LIVE_WICK_ATR * a
            and fh - lp >= 0.5 * a and fh >= float(H[-6:].max()) - 0.25 * a):
        add("live", 1.5, "wick penolakan pada candle berjalan")

    # 5) harga di area S/R kuat yang berlawanan arah
    best = None
    for z in (LAST_CTX.get("strong") or []):
        if z["st"] < EXIT_ZONE_MIN_ST:
            continue
        if buy:
            ok = z["lo"] > entry + 0.1 * a and z["lo"] - EXIT_ZONE_NEAR_ATR * a <= px <= z["hi"] + 0.2 * a
        else:
            ok = z["hi"] < entry - 0.1 * a and z["lo"] - 0.2 * a <= px <= z["hi"] + EXIT_ZONE_NEAR_ATR * a
        if ok and (best is None or z["st"] > best["st"]):
            best = z
    if best is not None:
        add("zone", 2.0 if best["st"] >= 8 else 1.5,
            f"harga di {'resistance' if buy else 'support'} kuat {best['lo']:.2f}-{best['hi']:.2f} (st {best['st']:.0f})")

    # 6) CHoCH M1 berlawanan setelah posisi dibuka
    for ch in CHOCH.get("M1", []):
        if ch["side"] == opp and int(ch["t2"]) + 60 > int(p.time):
            add("choch", 2.0, f"{ch['label']} M1 setelah entry")
            break

    # 7) konsensus MTF berbalik
    cons = float(LAST_CTX.get("cons", 0.0)) * sg
    if cons <= EXIT_CONS:
        add("cons", 1.0, f"konsensus MTF berlawanan ({cons:+.2f})")

    # 8) chart pattern berlawanan
    t_now = int(T[-1]) + 60
    for tf, Lk in list(PAT_LOCK.items()):
        if float(Lk.get("quality", 0)) < 60 or Lk.get("bias") != opp:
            continue
        a_tf = next((float(x["a"]) for x in LAST_CTX.get("tfs", []) if x["name"] == tf), a)
        if Lk.get("dir"):
            add("pat", 1.5, f"breakout {Lk['name']} [{tf}] ke arah {opp}")
            break
        if Lk.get("kind") == "lines":
            if buy and px >= _line_at(Lk["up"], t_now) - 0.3 * a_tf:
                add("pat", 1.5, f"harga di garis atas {Lk['name']} [{tf}]")
                break
            if (not buy) and px <= _line_at(Lk["lo"], t_now) + 0.3 * a_tf:
                add("pat", 1.5, f"harga di garis bawah {Lk['name']} [{tf}]")
                break

    # 9) kolam likuiditas tujuan tercapai
    smx = LAST_CTX.get("smx")
    if smx:
        for pl in smx.get("pools", []):
            if buy and pl["kind"] == "H" and pl["p"] > entry and pl["p"] - 0.3 * a <= px <= pl["p"] + 0.6 * a:
                add("liq", 1.0, f"likuiditas atas {pl['p']:.2f} tercapai")
                break
            if (not buy) and pl["kind"] == "L" and pl["p"] < entry and pl["p"] - 0.6 * a <= px <= pl["p"] + 0.3 * a:
                add("liq", 1.0, f"likuiditas bawah {pl['p']:.2f} tercapai")
                break

    # 10) order-flow melawan
    try:
        fl, _ = v17_flow(cl, buy, a)
        if fl <= -0.35:
            add("flow", 1.0, f"order-flow melawan ({fl:+.2f})")
    except Exception:
        pass
    return score, why, kinds


def smart_exit(p, move, peak):
    """Tutup posisi profit jika tanda pembalikan cukup banyak dan cukup kuat. Return True jika ditutup."""
    if not EXIT_SMART_ON or not LAST_CTX:
        return False
    now = time.time()
    if now - EXIT_STATE.get(p.ticket, 0.0) < EXIT_CHECK_SEC:
        return False
    EXIT_STATE[p.ticket] = now
    srv = float(state.get("srv") or now)
    if srv - float(p.time) < EXIT_MIN_AGE_SEC or move < EXIT_MIN_PROFIT_USD:
        return False
    tick = mt5.symbol_info_tick(SYMBOL)
    if tick is None:
        return False
    a = float(LAST_CTX["a"])
    score, why, kinds = exit_signals(p, tick, a)
    if peak >= EXIT_GIVEBACK_MIN_USD and (peak - move) / peak >= EXIT_GIVEBACK_FRAC:
        score += 1.0
        kinds.add("giveback")
        why.append(f"profit turun {(peak - move) / peak * 100:.0f}% dari puncak (+1)")
    candle_kinds = {"wick", "eng", "mom", "live", "choch"}
    if score < EXIT_SCORE or len(kinds) < EXIT_MIN_SIGNALS or not (kinds & candle_kinds):
        return False
    ok, msg = close_position(p.ticket)
    _plan_log(now, "-", f"SMART EXIT #{p.ticket} profit {move / PIP_USD:.0f} pips, skor {score:.1f}: "
                        + "; ".join(why[:6]) + f" -> {msg}")
    return bool(ok)


def manage_positions():
    """Tiap siklus: smart exit (prediksi pembalikan), time stop, lalu SL+ bertangga dari profit puncak."""
    info = mt5.symbol_info(SYMBOL)
    if info is None:
        return
    min_dist = (info.trade_stops_level or 0) * info.point
    srv = float(state.get("srv") or time.time())
    for p in mt5.positions_get(symbol=SYMBOL) or []:
        if p.magic != MAGIC:
            continue
        risk = pos_risk(getattr(p, "identifier", p.ticket))
        buy = p.type == mt5.POSITION_TYPE_BUY
        move = (p.price_current - p.price_open) if buy else (p.price_open - p.price_current)
        peak = peak_favorable(p)
        try:
            if smart_exit(p, move, peak):
                continue
        except Exception:
            log_exc("smart_exit")
        off = ladder_offset(peak, risk)
        if TIME_STOP_MIN and (srv - p.time) / 60.0 >= TIME_STOP_MIN and move < TIME_STOP_R * risk and off is None:
            ok, msg = close_position(p.ticket)
            log(f"TIME STOP #{p.ticket} setelah {TIME_STOP_MIN} menit (gerak {move:.2f}): {msg}")
            continue
        if off is None:
            continue
        target = p.price_open + off if buy else p.price_open - off
        if buy and p.price_current - target < min_dist:
            continue
        if (not buy) and target - p.price_current < min_dist:
            continue
        better = (target > p.sl) if buy else (p.sl == 0 or target < p.sl)
        if not better or (p.sl and abs(target - p.sl) < 0.02):
            continue
        res = mt5.order_send({"action": mt5.TRADE_ACTION_SLTP, "symbol": SYMBOL, "position": p.ticket,
                              "sl": round(target, info.digits), "tp": p.tp})
        if res and res.retcode == mt5.TRADE_RETCODE_DONE:
            log(f"SL+ #{p.ticket}: {p.sl:.2f} -> {target:.2f} (profit puncak {peak / PIP_USD:.0f} pips, "
                f"SL di +{off / PIP_USD:.0f} pips)")

