def _rec_trig(t, m):
    """1 jika trade dibuka dengan konfirmasi candle (engulfing), 0 jika hanya sentuh zona."""
    txt = (str(m.get("trigger") or "") + " " + " ".join(t.get("tags") or [])).lower()
    return 1 if ("engulfing" in txt or "konfirmasi" in txt) else 0


class Learner:
    """Probabilitas menang TERKALIBRASI dari hasil nyata + sinyal bayangan.
    Bucket: C (kode), CS (kode+arah), CR (kode+rezim), CT (kode+konfirmasi), CE (kode+jumlah tes),
    CD (kode+arah+posisi di range), CQ (kode+band kekuatan). Tiap bucket di-shrink ke induknya dengan K."""
    K = 6.0
 
    def __init__(self):
        self.b = {}
        self.g = [0.0, 0.0, 0.0]
        self.stats, self.blocked = {}, {}
        self.n_real = 0
        self.n_cur = 0
        self.aw, self.al = 0.75, -1.0
 
    def _pg(self):
        return (self.g[1] + 3.0) / (self.g[0] + 6.0)
 
    def _p(self, key, prior):
        acc = self.b.get(key)
        if not acc:
            return prior
        return (acc[1] + self.K * prior) / (acc[0] + self.K)
 
    def rebuild(self, trades, shadows=()):
        recs = []
        n_cur = 0
        for t in trades:
            if not t.get("code") or t.get("r") is None:
                continue
            m = db["meta"].get(str(t["ticket"])) or {}
            cur = m.get("ver") == BOT_VER
            n_cur += 1 if cur else 0
            recs.append(dict(t=t.get("close_time") or 0, code=t["code"], side=t.get("side") or "",
                             regime=t.get("regime") or m.get("regime"), trig=_rec_trig(t, m),
                             epb=epb_of(m.get("ep")), pdb=m.get("pdb"), stb=m.get("stb"),
                             win=1 if float(t["r"]) >= LEARN_WIN_R else 0,
                             r=float(t["r"]), w=1.0 if cur else OLD_VER_W, real=True))
        for s in shadows:
            if not s.get("code") or s.get("r") is None:
                continue
            cur = s.get("ver") == BOT_VER
            recs.append(dict(t=s.get("close_time") or 0, code=s["code"], side=s.get("side") or "",
                             regime=s.get("regime"), trig=None, epb=None,
                             pdb=s.get("pdb"), stb=s.get("stb"),
                             win=1 if float(s["r"]) >= LEARN_WIN_R else 0, r=float(s["r"]),
                             w=SHADOW_W * (1.0 if cur else OLD_VER_W), real=False))
        recs.sort(key=lambda x: x["t"])
        m_all = len(recs)
        b, g = {}, [0.0, 0.0, 0.0]
        win_w, loss_w = [0.0, 0.0], [0.0, 0.0]
        stats = {}
        for j, x in enumerate(recs):
            w = (0.5 ** ((m_all - 1 - j) / LEARN_HALF_LIFE)) * x["w"]
            keys = [("C", x["code"]), ("CS", x["code"], x["side"])]
            if x["regime"]:
                keys.append(("CR", x["code"], x["regime"]))
            if x["trig"] is not None:
                keys.append(("CT", x["code"], x["trig"]))
            if x["epb"]:
                keys.append(("CE", x["code"], x["epb"]))
            if x["pdb"]:
                keys.append(("CD", x["code"], x["side"], x["pdb"]))
            if x["stb"]:
                keys.append(("CQ", x["code"], x["stb"]))
            for k in keys:
                acc = b.setdefault(k, [0.0, 0.0, 0.0])
                acc[0] += w
                acc[1] += w * x["win"]
                acc[2] += w * x["r"]
            g[0] += w
            g[1] += w * x["win"]
            g[2] += w * x["r"]
            if x["win"]:
                win_w[0] += w
                win_w[1] += w * x["r"]
            else:
                loss_w[0] += w
                loss_w[1] += w * x["r"]
            st = stats.setdefault(x["code"], {"n": 0, "real": 0})
            st["n"] += 1
            st["real"] += 1 if x["real"] else 0
        for code, st in stats.items():
            acc = b.get(("C", code), [0.0, 0.0, 0.0])
            st["sw"], st["sn"], st["sr"] = acc[0], acc[1], acc[2]
            st["avg_r"] = round(acc[2] / acc[0], 2) if acc[0] > 0 else 0.0
        self.b, self.g, self.stats = b, g, stats
        self.n_real = sum(1 for x in recs if x["real"])
        self.n_cur = n_cur
        self.aw = (win_w[1] + 2.0 * 1.0) / (win_w[0] + 2.0)
        self.al = (loss_w[1] - 2.0 * 1.0) / (loss_w[0] + 2.0)
        blk = {}
        pg = self._pg()
        for code, st in stats.items():
            pc = self._p(("C", code), pg)
            if st["real"] >= BLOCK_MIN_N and pc < 0.30:
                blk[code] = round(pc, 2)
            for side in ("BUY", "SELL"):
                acc = b.get(("CS", code, side))
                if acc and acc[0] >= 8:
                    ps = self._p(("CS", code, side), pc)
                    if ps < 0.30:
                        blk[f"{code} {side}"] = round(ps, 2)
        self.blocked = blk
 
    def p_win(self, code, side="", regime=None, trig=None, epb=None):
        pc = self._p(("C", code), self._pg())
        parts = [self._p(("CS", code, side), pc)]
        if regime:
            parts.append(self._p(("CR", code, regime), pc))
        if trig is not None:
            parts.append(self._p(("CT", code, trig), pc))
        if epb:
            parts.append(self._p(("CE", code, epb), pc))
        p = sum(parts) / len(parts)
        n = int(self.b.get(("C", code), [0.0])[0])
        return min(0.95, max(0.05, p)), n
 
    def ctx_delta(self, code, side, pdb, stb):
        """Koreksi probabilitas (+/- LEARN_CTX_CAP) dari pelajaran bucket posisi-range dan kekuatan.
        Misal: SELL di area premium (X3) historis sering menang -> delta positif. Data sedikit = delta kecil."""
        pc = self._p(("C", code), self._pg())
        parts = []
        if pdb:
            parts.append(self._p(("CD", code, side, pdb), pc))
        if stb:
            parts.append(self._p(("CQ", code, stb), pc))
        if not parts:
            return 0.0
        d = sum(parts) / len(parts) - pc
        return max(-LEARN_CTX_CAP, min(LEARN_CTX_CAP, LEARN_CTX_W * d))
 
    def estimate(self, code, score=0, regime=None, side=None, trig=None, ep=None):
        return self.p_win(code, side or "", regime, trig, epb_of(ep))
 
    LCB_Z = 1.0
 
    def lcb_of(self, code, p):
        sw = self.b.get(("C", code), [0.0])[0]
        return p - self.LCB_Z * math.sqrt(max(p * (1.0 - p), 1e-6) / (sw + 2.0))
 
    def ev_r(self, p, cost_r=0.0):
        return p * self.aw + (1.0 - p) * self.al - cost_r

LEARNER = Learner()


def strat_summary(trades):
    agg = {}
    for t in trades:
        c = t.get("code")
        if not c:
            continue
        a = agg.setdefault(c, {"n": 0, "wins": 0, "net": 0.0, "sumR": 0.0})
        a["n"] += 1
        a["net"] += t["profit"]
        a["wins"] += 1 if t["profit"] > 0 else 0
        if t.get("r") is not None:
            a["sumR"] += t["r"]
    for c in LEARNER.stats:
        agg.setdefault(c, {"n": 0, "wins": 0, "net": 0.0, "sumR": 0.0})
    out = []
    for c, a in agg.items():
        p, _ = LEARNER.estimate(c, 75)
        s = LEARNER.stats.get(c, {})
        n = a["n"]
        out.append({"code": c, "n": n, "winrate": round(a["wins"] / n * 100, 1) if n else 0,
                    "net": round(a["net"], 2), "avg_r": round(a["sumR"] / n, 2) if n else 0,
                    "p_est": round(p * 100, 1), "blocked": c in LEARNER.blocked,
                    "n_virtual": s.get("n", 0) - s.get("real", 0)})
    out.sort(key=lambda x: -x["net"])
    return out


def probation_ok(code):
