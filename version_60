            x.update(cv=float(cv), cv_raw=float(raw), cv_t=now, cv_parts=parts, cv_notes=notes, tier=tier_of(cv))
            if cv >= COMMIT_MIN_CV:
                x["cv_ok_since"] = x.get("cv_ok_since") or now
