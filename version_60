AUTH_FAILS = {}   # ip -> [jumlah_gagal, waktu_terakhir]


def _auth_blocked(ip):
    rec = AUTH_FAILS.get(ip)
    if not rec:
        return False
    if time.time() - rec[1] > AUTH_BLOCK_SEC:
        AUTH_FAILS.pop(ip, None)
        return False
    return rec[0] >= AUTH_MAX_FAIL


def _auth_fail(ip):
    rec = AUTH_FAILS.setdefault(ip, [0, 0.0])
    rec[0] += 1
    rec[1] = time.time()
    if rec[0] == AUTH_MAX_FAIL:
        log(f"[AUTH] IP {ip} diblokir {AUTH_BLOCK_SEC // 60} menit karena {AUTH_MAX_FAIL}x gagal login")


class H(BaseHTTPRequestHandler):
    """Dashboard terbuka untuk semua yang tahu alamatnya.
    Tidak ada pengecekan Host/Origin/IP.
    OPEN_ALL=True : semua endpoint terbuka tanpa login.
    OPEN_ALL=False: GET terbuka, POST (tombol aksi) wajib login Basic Auth."""

    protocol_version = "HTTP/1.0"

    def log_message(self, *a):
        pass

    def _cors(self):
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type, Authorization")

    def _send(self, body, ctype, code=200):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Cache-Control", "no-store")
        self._cors()
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _json(self, fn):
        for _ in range(3):
            try:
                return json.dumps(fn()).encode()
            except RuntimeError:
                time.sleep(0.02)
        return json.dumps(fn()).encode()

    def _auth_ok(self):
        """Dipakai hanya untuk POST saat OPEN_ALL = False."""
        if OPEN_ALL:
            return True
        ip = self.client_address[0]
        if _auth_blocked(ip):
            self._send(b'{"ok":false,"msg":"terlalu banyak percobaan, coba lagi nanti"}',
                       "application/json", 429)
            return False
        hdr = self.headers.get("Authorization") or ""
        ok = False
        if hdr.startswith("Basic "):
            try:
                user, _, pw = base64.b64decode(hdr[6:]).decode("utf-8").partition(":")
                ok = (hmac.compare_digest(user.encode(), DASH_USER.encode())
                      and hmac.compare_digest(pw.encode(), DASH_PASS.encode()))
            except Exception:
                ok = False
        if not ok:
            if hdr:
                _auth_fail(ip)
            self.send_response(401)
            self.send_header("WWW-Authenticate", 'Basic realm="Bot XAUUSD"')
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.send_header("Cache-Control", "no-store")
            self._cors()
            body = b"Login diperlukan"
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return False
        AUTH_FAILS.pop(ip, None)
        return True

    def do_OPTIONS(self):
        self.send_response(204)
        self._cors()
        self.send_header("Content-Length", "0")
        self.end_headers()

    def do_GET(self):
        try:
            if self.path.startswith("/api/candles"):
                qs = self.path.split("?", 1)[1] if "?" in self.path else ""
                q = dict(x.split("=", 1) for x in qs.split("&") if "=" in x)
                try:
                    n = int(q.get("n", 150))
                except ValueError:
                    n = 150
                self._send(self._json(lambda: candles_payload(q.get("tf", "M1").upper(), n)),
                           "application/json")
            elif self.path.startswith("/api/plan"):
                self._send(self._json(plan_payload), "application/json")
            elif self.path.rstrip("/") == "/plan":
                self.send_response(302)
                self.send_header("Location", "/")
                self.send_header("Content-Length", "0")
                self.end_headers()
            elif self.path.startswith("/api/data"):
                self._send(self._json(build_payload), "application/json")
            else:
                f = os.path.join(BASE_DIR, "index.html")
                if not os.path.exists(f):
                    self._send(b"index.html tidak ditemukan di folder bot",
                               "text/plain; charset=utf-8", 404)
                    return
                with open(f, "rb") as fh:
                    self._send(fh.read(), "text/html; charset=utf-8")
        except Exception:
            log_exc("http_get")
            try:
                self._send(b'{"ok":false}', "application/json", 500)
            except Exception:
                pass

    def do_POST(self):
        if not self._auth_ok():
            return
        try:
            n = int(self.headers.get("Content-Length", 0) or 0)
            data = json.loads(self.rfile.read(n) or b"{}")
        except Exception:
            data = {}
        path = self.path.split("?")[0]
        try:
            if path == "/api/toggle":
                state["enabled"] = not state["enabled"]
                with dblock:
                    db["settings"]["enabled"] = state["enabled"]
                    save_db()
                msg = ("Bot dilanjutkan, order baru aktif" if state["enabled"]
                       else "Bot dijeda, tidak ada order baru (posisi lama dan limit yang sudah tersentuh tetap dikelola)")
                resp = {"ok": True, "msg": msg, "enabled": state["enabled"]}
            elif path == "/api/close":
                ok, msg = close_position(int(data.get("ticket", 0)))
                resp = {"ok": ok, "msg": msg}
            elif path == "/api/close_all":
                ok, msg = close_all_positions()
                resp = {"ok": ok, "msg": msg}
            elif path == "/api/journal":
                ok, msg, entry = save_journal_entry(data)
                resp = {"ok": ok, "msg": msg, "entry": entry}
            else:
                resp = {"ok": False, "msg": "endpoint tidak dikenal"}
        except Exception as e:
            resp = {"ok": False, "msg": f"error: {e}"}
        self._send(json.dumps(resp).encode(), "application/json")


