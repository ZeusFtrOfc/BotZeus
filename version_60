def mtf_consensus(ctx):
    """Konsensus arah -1..+1 dari tren H1/M15/M5/M1, struktur M15/M5/M1, dan chart pattern terkunci
    (pola yang masih terbentuk maupun yang sudah breakout). Rising wedge di M5/M15 = suara SELL."""
    if not CONS_ON:
        return 0.0, ""
    comp = [("H1", _sg(ctx["t60"]), CONS_W["t60"]), ("M15", _sg(ctx["htf"]), CONS_W["htf"]),
            ("M5", _sg(ctx["t5"]), CONS_W["t5"]), ("M1", _sg(ctx["trend"]), CONS_W["t1"]),
            ("str-M15", _sg(ctx["st15"]["s"]), CONS_W["s15"]),
            ("str-M5", _sg(ctx["st5"]["s"]), CONS_W["s5"]),
            ("str-M1", _sg(ctx["st1"]["s"]), CONS_W["s1"])]
    num = sum(s * w for _, s, w in comp)
    den = sum(w for _, _, w in comp)
    parts = [f"{n}{'+' if s > 0 else '-'}" for n, s, _ in comp if s]
    for tf, Lk in list(PAT_LOCK.items()):
        b = _sg(Lk.get("bias"))
        if not b:
            continue
        w = CONS_PAT_W.get(tf, 1.0) * min(1.0, float(Lk.get("quality", 0)) / 100.0)
        if Lk.get("dir"):
            w *= 1.5                                   # pola sudah breakout = bukti lebih kuat
        num += b * w
        den += w
        parts.append(f"{Lk['name']} {tf} {'BUY' if b > 0 else 'SELL'}")
    cons = max(-1.0, min(1.0, num / den)) if den > 0 else 0.0
    return cons, f"konsensus MTF {cons:+.2f} (" + ", ".join(parts[:8]) + ")"
 
 
