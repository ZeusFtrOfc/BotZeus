def _say(msg, status=None):
    """Perbarui status dashboard tiap saat, tetapi catat ke log hanya saat JENIS pesan berubah
    (angka diabaikan), plus satu pengingat tiap 60 detik dengan angka terbaru."""
    key = re.sub(r"\d+(?:\.\d+)?", "#", msg)
    now = time.time()
    if key != ENTRY_NOTE.get("k") or now - ENTRY_NOTE.get("t", 0.0) >= 60:
        ENTRY_NOTE["k"] = key
        ENTRY_NOTE["t"] = now
        log(f"[ENTRY] {msg}")
    ENTRY_NOTE["m"] = msg
    if PLAN_ACTIVE is not None and status:
        PLAN_ACTIVE["status"] = status
        set_view(PLAN_ACTIVE["id"], status=status, aksi=msg)
    return msg

def compute_lockwhy(ranked_all, a, thr_pct):
    """Isi s['lockwhy'] untuk tampilan dan log."""
    on = learning_on()
    now = time.time()
    for s in ranked_all:
        why = ""
        if s["eligible"]:
            sc, need = stable_count(s, a), stable_need(s, now)
            if on and s["ev"] < ENTRY_MIN_EV:
                why = f"EV {s['ev']:+.2f}R di bawah {ENTRY_MIN_EV}, tidak dikunci"
            elif on and s["p"] < thr_pct:
                why = f"probabilitas {s['p']:.0f}% < {thr_pct:.0f}% untuk dikunci"
            elif sc < need:
                why = f"menunggu stabil {sc}/{need} candle"
            else:
                why = "siap dikunci" + ("" if on else " (mode belajar: filter P/EV off)")
            if not s["room_ok"]:
                why += " (ruang ke zona lawan sempit, tetap diizinkan)"
        s["lockwhy"] = why

def detect_choch(df, cfg, name):
    """CHoCH valid di satu timeframe. Return list dict, dari yang terlama ke terbaru.
    BULLISH (DOWN -> UP): downtrend LH+LL, close menembus LH terakhir dengan displacement.
    BEARISH (UP -> DOWN): uptrend HH+HL, close menembus HL terakhir ke bawah dengan displacement.
    Setiap level hanya menghasilkan satu CHoCH (fired), dan di-reset saat pivot high baru terbentuk."""
    out = []
    if df is None or len(df) < 60:
        return out
    H, L, O, C = df.high.values, df.low.values, df.open.values, df.close.values
    T = df.time.values
    A = atr(df).values
    n = cfg["n"]
    last_k = len(C) - 1
    ph, pl = pivots(H, L, n)
    events = sorted([(i + n, "H", i, float(p)) for i, p in ph] +
                    [(i + n, "L", i, float(p)) for i, p in pl])
    last_h = prev_h = last_l = prev_l = None
    trend, fired, ei = None, False, 0
    for k in range(n, len(C)):
        # 1) terima pivot yang terkonfirmasi pada candle k lalu tentukan struktur
        while ei < len(events) and events[ei][0] <= k:
            _, kind, i, p = events[ei]
            ei += 1
            if kind == "H":
                prev_h, last_h = last_h, (i, p)
                fired = False                       # level baru: boleh memicu CHoCH lagi
            else:
                prev_l, last_l = last_l, (i, p)
            trend = None
            if last_h and prev_h and last_l and prev_l:
                lh = last_h[1] < prev_h[1]
                ll = last_l[1] < prev_l[1]
                hh = last_h[1] > prev_h[1]
                hl = last_l[1] > prev_l[1]
                if lh and (ll or not CHOCH_NEED_BOTH):
                    trend = "DOWN"
                elif hh and (hl or not CHOCH_NEED_BOTH):
                    trend = "UP"
        # 2) cek break oleh candle k
        if trend is None or fired or last_h is None or last_l is None:
            continue
        a_k = float(A[k]) if A[k] > 0 else 1.0
        body = float(C[k] - O[k])
        leg = abs(last_h[1] - last_l[1])
        if leg < cfg["leg_atr"] * a_k:
            continue
        if trend == "DOWN":
            level = last_h[1]
            ok = body >= cfg["body_atr"] * a_k and float(C[k]) - level >= cfg["break_atr"] * a_k
            side, label, piv = "BUY", "CHoCH bullish", last_h
        else:
            level = last_l[1]
            ok = -body >= cfg["body_atr"] * a_k and level - float(C[k]) >= cfg["break_atr"] * a_k
            side, label, piv = "SELL", "CHoCH bearish", last_l
        if not ok or last_k - k > cfg["max_age"]:
            continue
        fired = True
        out.append({
            "tf": name, "side": side, "label": label,
            "t1": int(T[piv[0]]), "t2": int(T[k]),        # pivot level -> candle pemicu
            "p": round(level, 2), "pc": round(float(C[k]), 2),
            "body_atr": round(body / a_k, 2), "leg_atr": round(leg / a_k, 2),
            "age": int(last_k - k),
        })
    return out


def update_choch(m1, m5):
    """Hitung CHoCH M1 dan M5 untuk tampilan dashboard. Log hanya CHoCH yang baru muncul."""
    for name, df in (("M1", m1), ("M5", m5)):
        try:
            res = detect_choch(df, CHOCH_CFG[name], name)[-CHOCH_KEEP:]
        except Exception:
            log_exc(f"choch {name}")
            continue
        CHOCH[name] = res
        for ch in res:
            key = (ch["tf"], ch["t2"], ch["side"])
            if key not in CHOCH_SEEN:
                CHOCH_SEEN.add(key)
                log(f"[CHOCH] {ch['tf']} {ch['label']} level {ch['p']:.2f}, "
                    f"close {ch['pc']:.2f}, body {ch['body_atr']} ATR, kaki {ch['leg_atr']} ATR")
        if len(CHOCH_SEEN) > 500:
            CHOCH_SEEN.clear()
            
