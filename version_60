TF_W = {1: 1.0, 5: 2.0, 15: 3.0}


def collect_pivots(df, mult):
    out = []
    if df is None:
        return out
    H, L = df.high.values, df.low.values
    A = atr(df).values
    nn = len(df)
    ph, pl = pivots(H, L, PIV)
    for kind, lst in (("H", ph), ("L", pl)):
        for i, p in lst:
            ai = A[i] if A[i] > 0 else 1.0
            if kind == "H":
                seg = L[i + 1:i + 11]
                react = (p - seg.min()) / ai if len(seg) else 0.0
            else:
                seg = H[i + 1:i + 11]
                react = (seg.max() - p) / ai if len(seg) else 0.0
            age = (nn - i) * mult
            rec = 0.5 + 0.5 * math.exp(-age / ZONE_DECAY)
            w = TF_W[mult] * rec * (0.8 + 0.3 * min(react, 3.0))
            out.append((p, w, age, mult))
    return out


def daily_points(m15):
    if m15 is None:
        return []
    t = m15.time.values // 86400
    prev = t[t < t[-1]]
    if len(prev) == 0:
        return []
    mask = t == prev.max()
    return [(float(m15.high.values[mask].max()), PDHL_WEIGHT, 600, 15),
            (float(m15.low.values[mask].min()), PDHL_WEIGHT, 600, 15)]


def build_zones(m1, m5, m15, a):
    """Zona S/R dari pivot M1/M5/M15 + harian yang digabung. Lebar dibatasi ATR M5,
    diberi bonus jika teruji, dan penalti jika sering tembus (chop)."""
    pts = collect_pivots(m1, 1) + collect_pivots(m5, 5) + collect_pivots(m15, 15) + daily_points(m15)
    if not pts:
        return []
    a5 = float(atr(m5).iloc[-1]) if m5 is not None else 0.0
    az = max(a5, a * 1.5) if a5 > 0 else a * 2.0
    pts.sort(key=lambda x: x[0])
    tol = ZONE_TOL_A5 * az
    groups, cur = [], [pts[0]]
    for q in pts[1:]:
        if q[0] - cur[-1][0] <= tol and q[0] - cur[0][0] <= 2 * tol:
            cur.append(q)
        else:
            groups.append(cur)
            cur = [q]
    groups.append(cur)
    ref = m5 if m5 is not None else m1
    H5, L5, C5 = ref.high.values[-300:], ref.low.values[-300:], ref.close.values[-300:]
    zones = []
    for g in groups:
        prices = [x[0] for x in g]
        wts = [max(x[1], 1e-6) for x in g]
        mid = float(np.average(prices, weights=wts))
        w = max(max(prices) - min(prices), ZONE_MIN_W_A5 * az)
        w = min(w, ZONE_MAX_W_A5 * az)
        lo, hi = mid - w / 2, mid + w / 2
        st = sum(x[1] for x in g)
        ntf = len({x[3] for x in g})
        if ntf >= 3:
            st += 2.5
        elif ntf == 2:
            st += 1.5
        if abs(mid - round(mid / 10) * 10) <= tol:
            st += 2
        elif abs(mid - round(mid / 5) * 5) <= tol:
            st += 1
        if min(x[2] for x in g) <= 120:
            st += 1
        touch = (H5 >= lo) & (L5 <= hi)
        ep = (int(np.sum(touch[1:] & ~touch[:-1])) + int(touch[0])) if len(touch) else 0
        if ep >= 2:
            st += min(ZONE_EP_CAP, ZONE_EP_BONUS * ep)
        sgn = np.sign(C5 - mid)
        crosses = int(np.sum(sgn[1:] * sgn[:-1] < 0))
        st -= min(ZONE_CHOP_CAP, ZONE_CHOP_STEP * max(0, crosses - ZONE_CHOP_FREE_M5))
        zones.append({"lo": float(lo), "hi": float(hi), "mid": float(mid), "st": float(max(st, 0.0)),
                      "touches": len(g), "tfs": ntf, "ep": int(ep),
                      "htf": bool(any(x[3] >= 5 for x in g))})
    return zones


