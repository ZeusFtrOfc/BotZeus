def arm_entry(tick):
    """Jangan pasang (ulang) limit selama bukti pembalikan lawan kuat atau fokus belum lolos syarat."""
    P = PLAN_ACTIVE
    if P is not None and not P.get("exec") and not PENDING["order"] and not cache["open"]:
        side = P["side"]
        opp_side = "SELL" if side == "BUY" else "BUY"
        ev, rw = rev_score(opp_side)
        if ev >= rev_veto_thr(side):
            return _say(f"limit tidak dipasang: tanda pembalikan {opp_side} {ev * 100:.0f}% "
                        f"({', '.join(rw[:2])})", "FOKUS")
        pmin = (V17_MIN_P if V17_MIN_P is not None else SMART_MIN_P) * 100.0 - LIMIT_P_TOL
        if float(P.get("p", 100.0)) < pmin or P.get("eligible") is False:
            return _say(f"limit tidak dipasang: P {P.get('p')}% / syarat fokus belum lolos", "FOKUS")
    return _arm_entry_orig(tick)


# ---- smart exit v19: pola pembalikan ikut jadi sinyal + early cut posisi rugi
_exit_signals_v18 = exit_signals


def exit_signals(p, tick, a):
    score, why, kinds = _exit_signals_v18(p, tick, a)
    buy = p.type == mt5.POSITION_TYPE_BUY
    opp = "SELL" if buy else "BUY"
    ev, rw = rev_score(opp, after_t=float(p.time))
    if ev >= 0.15:
        w = min(2.5, 3.5 * ev)
        score += w
        kinds.add("rev")
        why.append(f"pola pembalikan {opp} {ev * 100:.0f}%: {', '.join(rw[:3])} (+{w:.1f})")
    return score, why, kinds


def smart_exit(p, move, peak):
    """Tutup posisi profit saat tanda pembalikan cukup kuat; tutup dini posisi rugi jika pembalikan
    yang terbentuk SETELAH entry sangat kuat. Return True jika ditutup."""
    if not EXIT_SMART_ON or not LAST_CTX:
        return False
    now = time.time()
    if now - EXIT_STATE.get(p.ticket, 0.0) < EXIT_CHECK_SEC:
        return False
    EXIT_STATE[p.ticket] = now
    srv = float(state.get("srv") or now)
    age = srv - float(p.time)
    buy = p.type == mt5.POSITION_TYPE_BUY
    opp = "SELL" if buy else "BUY"

    if move < 0:                                          # ---- early cut
        if not EARLY_CUT_ON or age < EARLY_CUT_MIN_AGE_SEC:
            return False
        risk = pos_risk(getattr(p, "identifier", p.ticket))
        if -move > EARLY_CUT_MAX_LOSS_FRAC * risk:
            return False                                  # sudah dekat SL, biarkan SL bekerja
        ev, rw = rev_score(opp, after_t=float(p.time))
        if ev < EARLY_CUT_REV:
            return False
        ok, msg = close_position(p.ticket)
        _plan_log(now, "-", f"EARLY CUT #{p.ticket} rugi {move / PIP_USD:.0f} pips: pembalikan {opp} "
                            f"{ev * 100:.0f}% setelah entry ({', '.join(rw[:3])}) -> {msg}")
        return bool(ok)

    if age < EXIT_MIN_AGE_SEC or move < EXIT_MIN_PROFIT_USD:    # ---- exit saat profit
        return False
    tick = mt5.symbol_info_tick(SYMBOL)
    if tick is None:
        return False
    a = float(LAST_CTX["a"])
    score, why, kinds = exit_signals(p, tick, a)
    if peak >= EXIT_GIVEBACK_MIN_USD and (peak - move) / peak >= EXIT_GIVEBACK_FRAC:
        score += 1.0
        kinds.add("giveback")
        why.append(f"profit turun {(peak - move) / peak * 100:.0f}% dari puncak (+1)")
    candle_kinds = {"wick", "eng", "mom", "live", "choch", "rev"}
    if score < EXIT_SCORE or len(kinds) < EXIT_MIN_SIGNALS or not (kinds & candle_kinds):
        return False
    ok, msg = close_position(p.ticket)
    _plan_log(now, "-", f"SMART EXIT #{p.ticket} profit {move / PIP_USD:.0f} pips, skor {score:.1f}: "
                        + "; ".join(why[:6]) + f" -> {msg}")
    return bool(ok)

