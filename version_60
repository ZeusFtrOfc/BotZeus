def match_focus(P, setups, a):
    """Fokus sniper tidak gugur hanya karena detektor sesaat tidak melihat area itu. Selama area masih hidup di
    registry, datanya dipakai (gerbang lunak dibuang, hanya gerbang keselamatan yang dibawa)."""
    m = _match_focus_v24(P, setups, a)
    if P is None or not P.get("sniper"):
        return m
    x = _area_by_id(P.get("aid"))
    base = m if m is not None else (x.get("setup") if x else None)
    if base is None or x is None:
        return m
    out = dict(base)
    hard = [g for g in (base.get("gates") or []) if g.startswith(SNIPER_HARD)]
    out.update(gates=hard, eligible=not hard, room_ok=True, p=round(x["ps"], 1),
               pw=round(x["ps"] / 100.0, 4), strength=round(x["ss"], 1))
    return out


