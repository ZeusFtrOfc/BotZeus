def pick_fill(info):
    fm = info.filling_mode
    return mt5.ORDER_FILLING_FOK if fm & 1 else mt5.ORDER_FILLING_IOC if fm & 2 else mt5.ORDER_FILLING_RETURN


def pick_order_mode(info, req):
    """Cari filling mode yang diterima broker untuk request tertentu (FOK > IOC > RETURN sesuai broker).
    Return (mode, hasil_check). Mode None jika semua ditolak."""
    fm = info.filling_mode
    modes = []
    if fm & 1:
        modes.append(mt5.ORDER_FILLING_FOK)
    if fm & 2:
        modes.append(mt5.ORDER_FILLING_IOC)
    modes.append(mt5.ORDER_FILLING_RETURN)
    last = None
    for m in modes:
        chk = mt5.order_check(dict(req, type_filling=m))
        last = chk
        if chk is not None and chk.retcode in (0, 10009):
            return m, chk
    return None, last


def pick_fill_market(info):
    """Order market: utamakan IOC, lalu FOK."""
    fm = info.filling_mode
    return mt5.ORDER_FILLING_IOC if fm & 2 else mt5.ORDER_FILLING_FOK if fm & 1 else mt5.ORDER_FILLING_RETURN

def cancel_pending(why, force=False, block=True):
    """Batalkan limit yang belum terisi. Jika harga sudah menyentuh level (touched) dan tidak dipaksa,
    limit DIPERTAHANKAN. Return True jika limit berhasil dibatalkan."""
    ticket = PENDING["order"]
    if not ticket:
        return False
    if PENDING.get("touched") and not force:
        return False
    with mt5lock:
        res = mt5.order_send({"action": mt5.TRADE_ACTION_REMOVE, "order": ticket})
    if res and res.retcode == mt5.TRADE_RETCODE_DONE:
        if block:
            block_area(PENDING["side"], PENDING["zlo"], PENDING["zhi"], PENDING_REBLOCK_SEC)
        EXEC_STATS["cancelled"] += 1
        _plan_log(time.time(), PENDING.get("plan") or "-", f"PESANAN #{ticket} dibatalkan: {why}")
        PENDING.update(order=None, plan=None, touched=False, touch_t=0.0, snap=None)
        if PLAN_ACTIVE is not None:
            for k in ("limit", "limit_sl", "limit_sl_d"):
                PLAN_ACTIVE.pop(k, None)
            if not PLAN_ACTIVE.get("exec"):
                _say(f"pesanan dibatalkan ({why})", "FOKUS")
        return True
    log(f"[ORDER] gagal membatalkan #{ticket}: {res.retcode if res else mt5.last_error()}")
    return False


def manage_pending(tick):
    """Tiap siklus: pantau pesanan limit.
    - Harga tembus SL sebelum terisi: batalkan.
    - Belum tersentuh: batal jika fokus gugur/diganti atau kedaluwarsa.
    - Sudah tersentuh: jika fokus masih ada dan belum terisi setelah grace time, fallback ke market.
    - Pesanan hilang karena terisi: simpan meta supaya Learner dan SL+ bertangga memakai data yang benar."""
    ticket = PENDING["order"]
    if not ticket:
        return
    now = time.time()
    srv = float(state.get("srv") or now)
    buy = PENDING["side"] == "BUY"
    if mt5.orders_get(ticket=ticket):
        pending_touch_update(tick)
        if (buy and tick.bid <= PENDING["sl"]) or ((not buy) and tick.ask >= PENDING["sl"]):
            cancel_pending("harga menembus SL sebelum terisi", force=True)
            return
        focus_ok = PLAN_ACTIVE is not None and PLAN_ACTIVE.get("id") == PENDING["plan"]
        if PENDING.get("touched"):
            if not focus_ok:
                cancel_pending("fokus gugur (area tembus) saat level disentuh, tidak dipaksa masuk",
                               force=True, block=False)
                return
            if now - PENDING["touch_t"] >= PENDING_TOUCH_GRACE_SEC:
                info = mt5.symbol_info(SYMBOL)
                if info is not None:
                    pending_market_fallback(tick, info)
            return
        if srv >= PENDING["exp"]:
            cancel_pending("kedaluwarsa, harga tidak sampai level", force=True, block=False)
            return
        if not focus_ok:
            cancel_pending("fokus gugur atau diganti area lain sebelum level tersentuh",
                           force=True, block=False)
        return
    # pesanan sudah tidak ada: terisi, atau dihapus/kedaluwarsa oleh broker
    filled = []
    for _ in range(5):
        filled = [p for p in (mt5.positions_get(symbol=SYMBOL) or [])
                  if p.magic == MAGIC and getattr(p, "identifier", p.ticket) == ticket]
        if filled:
            break
        time.sleep(0.1)
    if filled:
        EXEC_STATS["filled_pending"] += 1
        try:
            save_pending_meta(filled[0])
        except Exception:
            log_exc("save_pending_meta")
        if PLAN_ACTIVE is not None and PLAN_ACTIVE.get("id") == PENDING["plan"]:
            PLAN_ACTIVE["exec"] = True
            _say("posisi terisi", "TEREKSEKUSI")
        _plan_log(now, PENDING.get("plan") or "-", f"PESANAN #{ticket} terisi, posisi berjalan")
    else:
        block_area(PENDING["side"], PENDING["zlo"], PENDING["zhi"], PENDING_REBLOCK_SEC)
        _plan_log(now, PENDING.get("plan") or "-", f"PESANAN #{ticket} tidak ada lagi (kedaluwarsa atau dihapus broker)")
        if PLAN_ACTIVE is not None and not PLAN_ACTIVE.get("exec"):
            for k in ("limit", "limit_sl", "limit_sl_d"):
                PLAN_ACTIVE.pop(k, None)
            _say("pesanan hilang dari broker, analisis ulang", "FOKUS")
    PENDING.update(order=None, plan=None, touched=False, touch_t=0.0, snap=None)


def pending_touch_update(tick):
    """Tandai limit sebagai 'tersentuh' saat harga mencapai levelnya (BUY: ask <= level, SELL: bid >= level)."""
    if not PENDING["order"] or PENDING.get("touched"):
        return
    lvl = float(PENDING["entry"])
    hit = (float(tick.ask) <= lvl) if PENDING["side"] == "BUY" else (float(tick.bid) >= lvl)
    if hit:
        PENDING["touched"] = True
        PENDING["touch_t"] = time.time()
        log(f"[ORDER] harga menyentuh limit #{PENDING['order']} di {lvl:.2f}, menunggu terisi")


def save_pending_meta(pos):
    """Simpan meta untuk posisi hasil limit, setara dengan yang ditulis open_market,
    supaya Learner (ver, regime, ep, trigger) dan pos_risk (sl_dist) bekerja."""
    snap = PENDING.get("snap") or {}
    pid = int(getattr(pos, "identifier", pos.ticket))
    if pos.sl:
        sl_d = abs(float(pos.price_open) - float(pos.sl))
    else:
        sl_d = float(snap.get("limit_sl_d") or SL_USD)
    tags = [t for t in (snap.get("tags") or []) if not str(t).startswith("konfirmasi")]
    meta = {"code": snap.get("code") or PENDING.get("code", ""), "side": PENDING["side"],
            "score": int(snap.get("score", 0)), "p": snap.get("p"), "ev": snap.get("ev"),
            "n_learn": snap.get("n", 0), "tags": tags, "regime": snap.get("regime"),
            "planned": PENDING.get("plan"), "zone_lo": PENDING["zlo"], "zone_hi": PENDING["zhi"],
            "entry": float(pos.price_open), "sl_dist": round(sl_d, 3), "lot": float(pos.volume),
            "atr": snap.get("atr"), "anchored": bool(snap.get("anchored")), "td_bias": snap.get("bias"),
            "ep": snap.get("ep"), "open_ts": int(srv_now()), "trigger": "limit di area",
            "prio": snap.get("prio"), "ver": BOT_VER, "rr": snap.get("rr"),
            "strength": snap.get("strength"),
            "pdb": snap.get("pdb"), "stb": snap.get("stb"), "tf": snap.get("tf"),
            "login": cache["account"].get("login", 0), "symbol": SYMBOL}
    db_put_meta(pid, meta)


def pending_market_fallback(tick, info):
    """Limit sudah disentuh tetapi belum terisi setelah PENDING_TOUCH_GRACE_SEC: batalkan limit lalu
    buka MARKET dengan SL struktur yang sama. Dibatalkan jika harga sudah terlalu dalam menembus area,
    dan limit dipertahankan jika harga sudah memantul menjauh (tidak dikejar)."""
    ticket = PENDING["order"]
    snap = PENDING.get("snap")
    if not ticket or not snap:
        return
    if any(p.magic == MAGIC for p in (mt5.positions_get(symbol=SYMBOL) or [])):
        return                                    # mungkin sudah terisi, biar siklus berikut yang menangani
    buy = PENDING["side"] == "BUY"
    a = float(snap["atr"])
    lvl = float(PENDING["entry"])
    width = max(float(snap["zone_hi"]) - float(snap["zone_lo"]), 0.1 * a)
    px = float(tick.ask if buy else tick.bid)
    away = (px - lvl) if buy else (lvl - px)      # >0: harga sudah memantul menjauh dari level
    deep = -away                                  # >0: harga menembus lebih dalam dari level
    if away > ENTRY_MAX_CHASE_ATR * a:
        PENDING["touched"] = False                # bounce tanpa terisi: pertahankan limit, tunggu sentuhan lagi
        return
    if deep > ENTRY_MAX_DEPTH * width:
        cancel_pending("level tersentuh tetapi harga sudah terlalu dalam di area, tidak dipaksa masuk",
                       force=True)
        return
    if not cancel_pending("fallback market: level tersentuh tetapi belum terisi", force=True, block=False):
        return
    EXEC_STATS["fallback_market"] += 1
    open_market(dict(snap, tk="fallback: limit tersentuh"), snap, info)
    if snap.get("exec") and PLAN_ACTIVE is not None and PLAN_ACTIVE.get("id") == snap.get("id"):
        PLAN_ACTIVE["exec"] = True

def arm_entry(tick):
    P = PLAN_ACTIVE
    if P is None:
        return _say(idle_reason())
    if P.get("exec"):
        return _say(f"strategi {P['name']} sudah dieksekusi")
    if cache["open"]:
        return _say("posisi aktif, menunggu posisi tutup")
    if PENDING["order"]:
        return _say(f"limit #{PENDING['order']} menunggu harga ke {PENDING['entry']:.2f}", "PESANAN")
    if not LAST_CTX:
        return _say("menunggu data analisis pertama")
 
    a = float(P["atr"])
    buy = P["side"] == "BUY"
    now = time.time()
    ask, bid = float(tick.ask), float(tick.bid)
    px = ask if buy else bid
    zlo, zhi = float(P["zone_lo"]), float(P["zone_hi"])
    width = max(zhi - zlo, 0.1 * a)
    edge = float(P["entry"])
    dist = (px - edge) if buy else (edge - px)
    lim = limit_level(P, a, live=True)
    dist_lim = (px - lim) if buy else (lim - px)
    stat_in = "DI AREA" if dist <= 0 else "FOKUS"
 
    if ROOM_HARD and not P.get("room_ok", True):
        return _say(f"ruang ke zona lawan kuat hanya {P.get('rr', 0):.1f}R < {MIN_RR}R, tidak entry", stat_in)
    hard = [g for g in (P.get("gates") or []) if not g.startswith(SOFT_GATES)]
    if hard:
        return _say("syarat belum lolos: " + "; ".join(hard[:2]), "FOKUS")
    if learning_on() and (P["pw"] < ENTRY_MIN_P or P["ev"] < ENTRY_MIN_EV):
        return _say(f"probabilitas {P['pw'] * 100:.0f}% / EV {P['ev']:+.2f}R di bawah syarat entry", stat_in)
    mm = mm_blocked(P["side"], zlo, zhi, srv_now())
    if mm:
        return _say(f"memori kesalahan: {mm}", "FOKUS")
    info = mt5.symbol_info(SYMBOL)
    if info is None:
        return _say("info simbol tidak tersedia")
    spread = ask - bid
    if spread > MAX_SPREAD or spread > MAX_SPREAD_R * SL_USD:
        return _say(f"spread {spread:.2f} terlalu lebar, menunggu", stat_in)
 
    # (jalur market-konfirmasi hanya aktif jika LIMIT_ONLY = False)
    if not LIMIT_ONLY and P.get("trig") and dist <= CONFIRM_ENTRY_MAX_ATR * a:
        if -dist > ENTRY_MAX_DEPTH * width:
            return _say("harga sudah terlalu dalam di area, tidak dikejar", "DI AREA")
        if approach_impulse(LAST_CTX["m1"], buy, a):
            return _say("harga melaju impulsif ke area (risiko jebol), tidak entry", stat_in)
        if now - ENTRY_LAST["t"] < ENTRY_RETRY_SEC:
            return _say("menunggu jeda percobaan order berikutnya")
        ENTRY_LAST["t"] = now
        return open_market(dict(P, tk=P.get("tk") or "konfirmasi area"), P, info)
 
    if not LIMIT_ON:
        return _say("LIMIT_ON mati, tidak ada entry", stat_in)
    strength = float(P.get("strength", 0.0))
    if strength < LIMIT_MIN_STRENGTH:
        return _say(f"kekuatan area {strength:.0f} < {LIMIT_MIN_STRENGTH:.0f}, limit tidak dipasang", stat_in)
    if dist_lim > LIMIT_PLACE_ATR * a:
        return _say(f"menunggu harga mendekat ke level limit {lim:.2f} (jarak {dist_lim:.2f} USD)", "FOKUS")
    if dist_lim <= LIMIT_MIN_GAP:
        return _say("harga sudah di level limit, menunggu retest (limit tidak bisa dipasang di belakang harga)", "DI AREA")
    if approach_impulse(LAST_CTX["m1"], buy, a):
        return _say("harga melaju impulsif ke area (risiko jebol), limit tidak dipasang", "FOKUS")
    if now - ENTRY_LAST["t"] < ENTRY_RETRY_SEC:
        return _say("menunggu jeda percobaan order berikutnya")
    ENTRY_LAST["t"] = now
    return place_limit(P, tick, info)

def place_limit(P, tick, info):
    """Pasang BUY/SELL LIMIT di level limit_level() dengan SL struktur dari level itu.
    Limit disimpan di PENDING lengkap dengan snapshot fokus untuk fallback market dan meta."""
    buy = P["side"] == "BUY"
    d = info.digits
    a = float(P["atr"])
    zlo, zhi = float(P["zone_lo"]), float(P["zone_hi"])
    lvl = round(limit_level(P, a, live=True), d)
    sl_px, sl_d, ok = structural_sl(P["side"], zlo, zhi, lvl, a)
    if not ok:
        return _say(f"SL struktur {sl_d:.2f} USD terlalu lebar untuk limit di {lvl:.2f}, tidak dipasang", "FOKUS")
    ask, bid = float(tick.ask), float(tick.bid)
    gap = max((info.trade_stops_level or 0) * info.point, LIMIT_MIN_GAP)
    if buy and lvl > ask - gap:
        return _say(f"level limit {lvl:.2f} terlalu dekat dengan harga {ask:.2f} (batas broker), menunggu", "DI AREA")
    if (not buy) and lvl < bid + gap:
        return _say(f"level limit {lvl:.2f} terlalu dekat dengan harga {bid:.2f} (batas broker), menunggu", "DI AREA")
    vol = calc_lot(sl_d, info)
    comment = f"{P['code']}{int(P['score'])} r{sl_d:.2f}"[:31]
    req = {"action": mt5.TRADE_ACTION_PENDING, "symbol": SYMBOL, "volume": vol,
           "type": mt5.ORDER_TYPE_BUY_LIMIT if buy else mt5.ORDER_TYPE_SELL_LIMIT,
           "price": lvl, "sl": round(sl_px, d), "tp": 0.0, "deviation": ENTRY_DEVIATION,
           "magic": MAGIC, "comment": comment, "type_time": mt5.ORDER_TIME_GTC}
    with mt5lock:
        mode, chk = pick_order_mode(info, req)
        if mode is None:
            EXEC_STATS["rejected"] += 1
            return _say(f"limit ditolak broker (check): {getattr(chk, 'retcode', '?')} {getattr(chk, 'comment', '')}")
        res = mt5.order_send(dict(req, type_filling=mode))
    if res is None or res.retcode != mt5.TRADE_RETCODE_DONE:
        EXEC_STATS["rejected"] += 1
        err = f"{res.retcode} {getattr(res, 'comment', '')}" if res is not None else str(mt5.last_error())
        return _say(f"order limit gagal: {err}")

    P.update(limit=lvl, limit_sl=round(sl_px, d), limit_sl_d=float(sl_d))
    PENDING.update(order=int(res.order), plan=P["id"], side=P["side"], entry=lvl, sl=round(sl_px, d),
                   code=P["code"], exp=srv_now() + PENDING_EXPIRE_MIN * 60, zlo=zlo, zhi=zhi,
                   touched=False, touch_t=0.0, snap=dict(P))
    EXEC_STATS["placed"] += 1
    pips = round(sl_d / PIP_USD)
    _plan_log(time.time(), P["id"],
              f"LIMIT #{res.order} {P['side']} {lvl:.2f}, SL {sl_px:.2f} ({pips} pips), {vol} lot, "
              f"{P['name']} [{P['tf']}], kekuatan {P.get('strength', 0):.0f}, P {P['p']}%, EV {P['ev']:+.2f}R")
    return _say(f"{P['side']} LIMIT {lvl:.2f}, SL {sl_px:.2f} ({pips} pips), {vol} lot", "PESANAN")


def open_market(f, P, info):
    """Buka posisi MARKET dengan SL struktur dari harga fill. Requote diulang,
    posisi diverifikasi, dan ditutup jika SL tidak bisa dipasang."""
    buy = P["side"] == "BUY"
    d = info.digits
    zlo, zhi, a = float(P["zone_lo"]), float(P["zone_hi"]), float(P["atr"])
    comment = f"{f['code']}{int(f['score'])}"[:31]
    res, last_err = None, ""
    for _ in range(ORDER_RETRIES + 1):
        tk = mt5.symbol_info_tick(SYMBOL)
        if tk is None:
            last_err = "tidak ada tick"
            time.sleep(0.2)
            continue
        price = float(tk.ask if buy else tk.bid)
        sl_px, sl_d, ok = structural_sl(P["side"], zlo, zhi, price, a)
        if not ok:
            return _say(f"SL struktur {sl_d:.2f} USD terlalu lebar dari harga {price:.2f}, tidak masuk")
        vol = calc_lot(sl_d, info)
        req = {"action": mt5.TRADE_ACTION_DEAL, "symbol": SYMBOL, "volume": vol,
               "type": mt5.ORDER_TYPE_BUY if buy else mt5.ORDER_TYPE_SELL,
               "price": price, "sl": round(sl_px, d), "tp": 0.0,
               "deviation": ENTRY_DEVIATION, "magic": MAGIC, "comment": comment,
               "type_time": mt5.ORDER_TIME_GTC, "type_filling": pick_fill_market(info)}
        with mt5lock:
            chk = mt5.order_check(req)
            if chk is not None and chk.retcode not in (0, 10009):
                EXEC_STATS["rejected"] += 1
                return _say(f"order ditolak broker (check): {chk.retcode} {getattr(chk, 'comment', '')}")
            res = mt5.order_send(req)
        if res is None:
            last_err = str(mt5.last_error())
            continue
        if res.retcode == mt5.TRADE_RETCODE_DONE:
            break
        last_err = f"{res.retcode} {getattr(res, 'comment', '')}"
        if res.retcode not in (10004, 10020, 10021):
            break
        time.sleep(0.15)
    if res is None or res.retcode != mt5.TRADE_RETCODE_DONE:
        EXEC_STATS["rejected"] += 1
        return _say(f"order market gagal: {last_err}")

    pos_id = int(res.order)
    try:
        if res.deal:
            dl = mt5.history_deals_get(ticket=res.deal)
            if dl:
                pos_id = int(dl[0].position_id)
    except Exception:
        pass
    pos = None
    for _ in range(10):
        got = mt5.positions_get(ticket=pos_id)
        if got:
            pos = got[0]
            break
        time.sleep(0.1)
    if pos is None:
        mine = [p for p in (mt5.positions_get(symbol=SYMBOL) or []) if p.magic == MAGIC]
        if mine:
            pos = max(mine, key=lambda p: p.time)
            pos_id = int(getattr(pos, "identifier", pos.ticket))
    fill = float(pos.price_open) if pos is not None else float(res.price)

    sl_f, sd_f, ok_f = structural_sl(P["side"], zlo, zhi, fill, a)
    if not ok_f:
        if pos is not None:
            close_position(pos.ticket)
        return _say(f"SL struktur di harga fill {fill:.2f} terlalu lebar, posisi ditutup")
    want = round(sl_f, d)

    if pos is not None and (not pos.sl or abs(pos.sl - want) > 0.02):
        ok = False
        for _ in range(3):
            r2 = mt5.order_send({"action": mt5.TRADE_ACTION_SLTP, "symbol": SYMBOL,
                                 "position": pos.ticket, "sl": want, "tp": pos.tp})
            if r2 and r2.retcode == mt5.TRADE_RETCODE_DONE:
                ok = True
                break
            time.sleep(0.2)
        if not ok and not pos.sl:
            log(f"PERINGATAN: SL gagal dipasang di #{pos.ticket}, posisi ditutup demi keamanan")
            close_position(pos.ticket)
            return _say("SL gagal dipasang, posisi ditutup demi keamanan")

    meta = {"code": f["code"], "side": P["side"], "score": int(f["score"]), "p": f["p"],
            "ev": f["ev"], "n_learn": f["n"], "tags": list(f["tags"]), "regime": f["regime"],
            "planned": P["id"], "zone_lo": f["zone_lo"], "zone_hi": f["zone_hi"],
            "entry": fill, "sl_dist": sd_f, "lot": vol, "atr": f["atr"],
            "anchored": bool(f["anchored"]), "td_bias": f["bias"], "ep": f.get("ep"),
            "open_ts": int(srv_now()), "trigger": f.get("tk", ""), "prio": f.get("prio"),
            "ver": BOT_VER, "rr": f.get("rr"),
            "login": cache["account"].get("login", 0), "symbol": SYMBOL}
    db_put_meta(pos_id, meta)
    P["exec"] = True
    msg = (f"{P['side']} MARKET {fill:.2f}, SL {want:.2f} ({round(sd_f / PIP_USD)} pips), "
           f"{vol} lot, {f.get('tk', '')}")
    _plan_log(time.time(), P["id"],
              f"OPEN #{pos_id} {msg}, {f['name']} [{f['tf']}], P {f['p']}%, EV {f['ev']:+.2f}R")
    try:
        refresh_cache(force=True)
    except Exception:
        log_exc("refresh_cache_after_open")
    return _say(msg, "TEREKSEKUSI")

def approach_impulse(m1, buy, a):
    """True jika 3 candle M1 tutup terakhir melaju searah menuju zona dengan gerak besar (risiko jebol)."""
    if not IMPULSE_ATR:
        return False
    C = m1.close.values
    if len(C) < 5:
        return False
    move = (C[-4] - C[-1]) if buy else (C[-1] - C[-4])      # BUY: harga turun ke zona. SELL: naik ke zona
    return move > IMPULSE_ATR * a


def pos_risk(ticket):
    """Jarak SL awal (dolar) posisi ini dari metadata. Fallback SL_USD."""
    with dblock:
        m = db["meta"].get(str(ticket)) or {}
    try:
        return float(m.get("sl_dist") or SL_USD)
    except Exception:
        return SL_USD


def manage_positions():
    """Tiap siklus: time stop, lalu SL+ bertangga dari profit puncak (skala mengikuti jarak SL). SL hanya bergerak searah profit."""
    info = mt5.symbol_info(SYMBOL)
    if info is None:
        return
    min_dist = (info.trade_stops_level or 0) * info.point
    srv = float(state.get("srv") or time.time())
    for p in mt5.positions_get(symbol=SYMBOL) or []:
        if p.magic != MAGIC:
            continue
        risk = pos_risk(getattr(p, "identifier", p.ticket))
        buy = p.type == mt5.POSITION_TYPE_BUY
        move = (p.price_current - p.price_open) if buy else (p.price_open - p.price_current)
        peak = peak_favorable(p)
        off = ladder_offset(peak, risk)
        if TIME_STOP_MIN and (srv - p.time) / 60.0 >= TIME_STOP_MIN and move < TIME_STOP_R * risk and off is None:
            ok, msg = close_position(p.ticket)
            log(f"TIME STOP #{p.ticket} setelah {TIME_STOP_MIN} menit (gerak {move:.2f}): {msg}")
            continue
        if off is None:
            continue
        target = p.price_open + off if buy else p.price_open - off
        if buy and p.price_current - target < min_dist:
            continue
        if (not buy) and target - p.price_current < min_dist:
            continue
        better = (target > p.sl) if buy else (p.sl == 0 or target < p.sl)
        if not better or (p.sl and abs(target - p.sl) < 0.02):
            continue
        res = mt5.order_send({"action": mt5.TRADE_ACTION_SLTP, "symbol": SYMBOL, "position": p.ticket,
                              "sl": round(target, info.digits), "tp": p.tp})
        if res and res.retcode == mt5.TRADE_RETCODE_DONE:
            log(f"SL+ #{p.ticket}: {p.sl:.2f} -> {target:.2f} (profit puncak {peak / PIP_USD:.0f} pips, "
                f"SL di +{off / PIP_USD:.0f} pips)")

def close_position(ticket):
    with mt5lock:
        pos = mt5.positions_get(ticket=ticket)
        if not pos:
            return False, f"Posisi #{ticket} tidak ditemukan (mungkin sudah tertutup)"
        p = pos[0]
        if p.magic != MAGIC:
            return False, "Posisi ini bukan milik bot"
        tick, info = mt5.symbol_info_tick(p.symbol), mt5.symbol_info(p.symbol)
        if tick is None or info is None:
            return False, "Tidak ada harga dari broker, coba lagi"
        buy = p.type == mt5.POSITION_TYPE_BUY
        req = {"action": mt5.TRADE_ACTION_DEAL, "symbol": p.symbol, "volume": p.volume,
               "type": mt5.ORDER_TYPE_SELL if buy else mt5.ORDER_TYPE_BUY,
               "position": p.ticket, "price": tick.bid if buy else tick.ask,
               "deviation": 30, "magic": MAGIC, "comment": "close-dashboard",
               "type_time": mt5.ORDER_TIME_GTC, "type_filling": pick_fill(info)}
        res = mt5.order_send(req)
        if res and res.retcode == mt5.TRADE_RETCODE_DONE:
            refresh_cache(force=True)
            return True, f"Posisi #{ticket} ditutup"
        return False, f"Gagal menutup #{ticket}: {res.retcode if res else mt5.last_error()}"


def close_all_positions():
    with mt5lock:
        tickets = [p.ticket for p in (mt5.positions_get(symbol=SYMBOL) or []) if p.magic == MAGIC]
        if not tickets:
            return False, "Tidak ada posisi terbuka"
        done, errs = 0, []
        for t in tickets:
            ok, msg = close_position(t)
            if ok:
                done += 1
            else:
                errs.append(msg)
    if errs:
        return False, f"{done} ditutup, {len(errs)} gagal. {errs[0]}"
    return True, f"{done} posisi ditutup"


def cancel_stale_pending():
    """Saat startup: hapus pesanan limit lama milik bot (status internalnya sudah hilang)."""
    for o in mt5.orders_get(symbol=SYMBOL) or []:
        if o.magic == MAGIC:
            with mt5lock:
                res = mt5.order_send({"action": mt5.TRADE_ACTION_REMOVE, "order": o.ticket})
            log(f"[START] pesanan lama #{o.ticket} dihapus: {res.retcode if res else mt5.last_error()}")


