def market_structure(df, n=PIV):
    """HH+HL = UP, LH+LL = DOWN, selain itu RANGE. Plus BOS/CHoCH dari close terakhir."""
    out = {"s": "?", "note": "", "hi": 0.0, "lo": 0.0}
    if df is None:
        return out
    H, L, C = df.high.values, df.low.values, df.close.values
    ph, pl = pivots(H, L, n)
    if len(ph) < 2 or len(pl) < 2:
        out["s"] = "RANGE"
        return out
    up = ph[-1][1] > ph[-2][1] and pl[-1][1] > pl[-2][1]
    dn = ph[-1][1] < ph[-2][1] and pl[-1][1] < pl[-2][1]
    s = "UP" if up else "DOWN" if dn else "RANGE"
    note = ""
    if s == "DOWN" and C[-1] > ph[-1][1]:
        note = "CHoCH bullish"
    elif s == "UP" and C[-1] < pl[-1][1]:
        note = "CHoCH bearish"
    elif s == "UP" and C[-1] > ph[-1][1]:
        note = "BOS bullish"
    elif s == "DOWN" and C[-1] < pl[-1][1]:
        note = "BOS bearish"
    return {"s": s, "note": note, "hi": round(float(ph[-1][1]), 2), "lo": round(float(pl[-1][1]), 2)}


def struct_adj(side, st5, st15, st1=None, flip=False):
    buy = side == "BUY"
    want = "UP" if buy else "DOWN"
    choch_same = "CHoCH bullish" if buy else "CHoCH bearish"
    adj, tags = 0, []
    items = [("M5", st5, 2, 3), ("M15", st15, 3, 0)]
    if st1 is not None:
        items.append(("M1", st1, 2, 2))
    for nm, st, w, choch_bonus in items:
        if flip and nm == "M15":
            continue                      # sengaja melawan M15, struktur M15 tidak menghukum
        if st["s"] == want:
            adj += w
            tags.append(f"struktur {nm} {st['s']}")
        elif st["s"] != "RANGE":
            adj -= w
            tags.append(f"struktur {nm} berlawanan")
        if choch_bonus and st["note"] == choch_same:
            adj += choch_bonus
            tags.append(f"CHoCH {nm} searah")
    return adj, tags


def pd_adj(side, pct):
    if side == "BUY":
        if pct <= 40:
            return 3, "area discount"
        if pct >= 70:
            return -4, "area premium (beli mahal)"
        return 0, None
    if pct >= 60:
        return 3, "area premium"
    if pct <= 30:
        return -4, "area discount (jual murah)"
    return 0, None


def score_setup(base, code_out, side, ctx):
    """Skor konteks. Mode normal: ikut tren multi-TF. Mode flip: M5/M1 yang menilai, M15/H1 tidak menghukum."""
    score, tags = base, []
    flip = bool(ctx.get("flip")) and side == ctx.get("allowed")
    if ctx["trend"] == side:
        score += 15
        tags.append("searah tren M1")
    elif ctx["trend"] != "FLAT":
        score -= 12
        tags.append("lawan tren M1")
    if flip:
        score += FLIP_SCORE_BONUS
        tags.append("pembalikan step-down M5/M1 (CHoCH)")
    else:
        if ctx["htf"] == side:
            score += 5
            tags.append("searah M15")
        elif ctx["htf"] != "FLAT":
            score -= 8
            tags.append("lawan M15")
        if ctx["t60"] == side:
            score += 4
        elif ctx["t60"] != "FLAT":
            score -= 6
        if ctx["htf"] not in (side, "FLAT") and ctx["t60"] not in (side, "FLAT"):
            score -= 8
            tags.append("lawan M15+H1")
    if ctx["t5"] == side:
        score += 3
    elif ctx["t5"] != "FLAT":
        score -= 4
    ra, rt = regime_adj(code_out, ctx["regime"])
    score += ra + ctx["s_adj"]
    if rt:
        tags.append(rt)
    sa, stags = struct_adj(side, ctx["st5"], ctx["st15"], ctx.get("st1"), flip)
    pa, ptag = pd_adj(side, ctx["pdp"])
    score += sa + pa
    tags += stags + ([ptag] if ptag else [])
    return score, tags


def prem_disc(m15, px):
    """Posisi harga (0-100%) dalam range 24 jam (96 candle M15)."""
    if m15 is None:
        return 50.0
    seg = m15.iloc[-96:]
    hi, lo = float(seg.high.max()), float(seg.low.min())
    return float((px - lo) / (hi - lo) * 100) if hi > lo else 50.0


def bias_of(t5, htf, t60, st5, st15):
    sg = {"BUY": 1, "UP": 1, "SELL": -1, "DOWN": -1}
    sc = (2 * sg.get(htf, 0) + 2 * sg.get(t60, 0) + 2 * sg.get(st15["s"], 0)
          + sg.get(t5, 0) + sg.get(st5["s"], 0))
    if sc >= BIAS_MIN:
        return "BUY", int(sc)
    if sc <= -BIAS_MIN:
        return "SELL", int(sc)
    return "NETRAL", int(sc)


FLIP_HOLD = {"side": None, "until": 0.0}


def trend_direction(htf, st15, t60, st5=None):
    """Arah dasar dari M15. Jika EMA M15 dan struktur M15 bertentangan, struktur M5 yang memutuskan
    (hanya jika searah salah satunya). M15 FLAT: pakai struktur M15, lalu H1."""
    m = {"UP": "BUY", "DOWN": "SELL"}
    s15 = m.get(st15["s"])
    if htf in ("BUY", "SELL"):
        if s15 and s15 != htf:
            s5 = m.get(st5["s"]) if st5 else None
            return s5 if s5 in (htf, s15) else None
        return htf
    if s15:
        return s15
    if t60 in ("BUY", "SELL"):
        return t60
    return None


FOLLOW_INFO = {"why": "", "m5s": 0, "m1s": 0, "weak": False, "votes": 0}


def follow_trend(htf, st15, t60, st5, st1):
    """Step-down M15 > M5 > M1. Return (sisi_diizinkan, flip, arah_dasar).
    v10: M15 CHoCH/BOS yang melawan arah dasar menghentikan pencarian setup sampai ada flip."""
    base = trend_direction(htf, st15, t60, st5)
    now = time.time()
    if base is None:
        FOLLOW_INFO.update(why="Tren M15 belum jelas, bot tidak mencari setup.", m5s=0, m1s=0,
                           weak=False, votes=0)
        return None, False, None
    mp = {"UP": "BUY", "DOWN": "SELL"}
    votes = sum([htf == base, mp.get(st15["s"]) == base, t60 == base, mp.get(st5["s"]) == base])
    opp = "SELL" if base == "BUY" else "BUY"
    choch = "CHoCH bullish" if opp == "BUY" else "CHoCH bearish"
    bos_opp = "BOS bullish" if opp == "BUY" else "BOS bearish"
    cont = "BOS bullish" if base == "BUY" else "BOS bearish"
    want = "UP" if opp == "BUY" else "DOWN"

    m5s = (2 if st5["note"] in (choch, bos_opp) else 0) + (1 if st5["s"] == want else 0)
    m1s = (2 if st1["note"] in (choch, bos_opp) else 0) + (1 if st1["s"] == want else 0)

    if FLIP_HOLD["side"] == base or st5["note"] == cont:
        FLIP_HOLD.update(side=None, until=0.0)
    trigger = (m5s >= 2 and m1s >= 1) or m5s >= 3 or (m5s >= 1 and m1s >= 3)
    if trigger:
        FLIP_HOLD.update(side=opp, until=now + FLIP_HOLD_MIN * 60)
    flip = FLIP_HOLD["side"] == opp and now < FLIP_HOLD["until"]
    weak = (not flip) and votes < 2

    m15_against = st15.get("note") in (choch, bos_opp)
    if m15_against and not flip:
        FOLLOW_INFO.update(
            why=(f"M15 {st15['note']} melawan arah {base}. Bot tidak mencari setup {base} "
                 f"sampai struktur baru terbentuk."),
            m5s=m5s, m1s=m1s, weak=True, votes=votes)
        return None, False, base

    if flip:
        why = (f"Tren M15 {base}, tetapi M5 (skor {m5s}) dan M1 (skor {m1s}) membentuk pembalikan, "
               f"jadi bot fokus mencari area {opp}.")
    elif m1s >= 2 and m5s == 0:
        why = (f"Mengikuti tren M15 {base}. M1 membentuk CHoCH tetapi M5 belum, "
               f"dianggap koreksi, bot tetap mencari area {base}.")
    else:
        why = f"Mengikuti tren M15 {base}, M5 dan M1 belum berbalik, bot hanya mencari area {base}."
    if weak:
        why += (f" Tren lemah (hanya {votes} dari 4 sumber searah): hanya area berjangkar M5/M15 "
                f"dengan probabilitas lebih tinggi yang dikunci.")
    FOLLOW_INFO.update(why=why, m5s=m5s, m1s=m1s, weak=weak, votes=votes)
    return (opp if flip else base), bool(flip), base

def v8_probability(code, score, regime, conf, htf_ok, zone_st, dist_atr, combo_w, anchored, bias_ok,
                   ep=0, prio=5):
    p, nn = LEARNER.estimate(code, score, regime)
    p += 0.02 * min(conf, 3) + min(0.06, 0.004 * combo_w)
    p += 0.015 if htf_ok else -0.01
    p += 0.004 * min(zone_st, 10)
    p += 0.012 * min(ep, 5)                  # area sering diretest = reaksi harga sudah terbukti
    p += 0.03 if bias_ok else 0.0
    p += 0.03 if anchored else 0.0
    p += PRIO_P.get(prio, 0.0)
    p -= 0.015 * max(0.0, dist_atr - 1.5)
    return min(0.75, max(0.15, p)), nn


def same_area(c, o, a):
