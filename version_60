# --- breakout engine
BRK_ON = True
BRK_TFS = ("M1", "M5", "M15")
BRK_MAX_AGE_SEC = {"M1": 150, "M5": 300, "M15": 600}
BRK_BODY_ATR = 0.6
BRK_MIN_SCORE = 3.0
BRK_AGAINST_EXTRA = 0.8         # breakout melawan bias pola butuh skor lebih tinggi
BRK_MIN_KINDS = 2               # minimal 2 jenis bukti dari: body/wick, volume, engulfing, pembalikan
BRK_MAX_CHASE_ATR = 1.0
BRK_ROOM_ATR = 0.8
BRK_OPP_VETO = 0.60
BRK_FAKE_ON = True
BRK_FAKE_PIERCE_ATR = 0.08
BRK_MIN_Q = 60.0
BRK_RETRY_SEC = 10
BRK_DONE = {}
