#      validasi limit, early cut. TEMPEL DI BAWAH BLOK v18.
# =====================================================================
REV_ON = True
REV_MAX_AGE_M1 = 8              # pola M1 berlaku maks sekian candle
REV_MAX_AGE_M5 = 3              # pola M5 berlaku maks sekian candle
REV_M5_MULT = 1.4               # pola M5 lebih berbobot daripada M1
REV_ZONE_MIN_ST = 5.0           # area S/R dianggap kuat jika st >= ini
REV_NOZONE_MULT = 0.6           # bobot pola di luar area kuat
REV_VETO = 0.50                 # bukti pembalikan lawan >= ini = setup ditolak
REV_VETO_AFTER_LOSS = 0.35      # ambang lebih ketat jika baru kalah di arah yang sama
REV_LOSS_WINDOW = 1200          # detik: jendela "baru kalah"
REV_P_OWN = 0.08                # tambahan P jika bukti searah
REV_P_OPP = 0.16                # pengurang P jika bukti berlawanan
REV_RANK = 25.0                 # pengaruh bukti ke peringkat
REV_ROOM_STRICT = 0.30          # ada bukti lawan sebesar ini: pelonggaran ruang v18 dicabut
TRAP_LIFE = 600                 # detik: umur bukti "jebakan breakout gagal"
TRAP_W = 0.40
REV_TRAP_TF = {"M1": 0.8, "M5": 1.0, "M15": 1.2}
LIMIT_P_TOL = 2.0               # limit dibatalkan jika P < ambang - toleransi ini (poin %)
LIMIT_INVALID_SEC = 12          # fokus harus tidak lolos selama ini baru limit dibatalkan
EARLY_CUT_ON = True             # False = matikan penutupan dini posisi rugi
EARLY_CUT_REV = 0.65            # bukti pembalikan (setelah entry) minimal untuk early cut
EARLY_CUT_MIN_AGE_SEC = 10
EARLY_CUT_MAX_LOSS_FRAC = 0.85  # hanya jika kerugian < sekian x jarak SL

TRAPS = []
REV_CACHE = {"k": None, "v": None}
REV_LOG = {"sig": "", "t": 0.0}
PEND_BAD = {"id": None, "t": 0.0}


def _rev_patterns(df, buy, a, max_age):
    """Pola pembalikan di 'ruang bullish' (SELL dicerminkan): bukti harga akan NAIK.
    Return [dict(kind, w, age, t, low, txt)]; 'low' ada di ruang cermin. Pola yang low-nya sudah ditembus lagi dibuang."""
    H, L, O, C = mirror_df(df, buy)
    T = df.time.values
    n = len(C)
    out = []
    if n < 25 or not a > 0:
        return out
    for age in range(0, max_age + 1):
        k = n - 1 - age
        if k < 12:
            break
        body = float(C[k] - O[k])
        ab = abs(body)
        rng = max(float(H[k] - L[k]), 1e-9)
        lw = float(min(O[k], C[k]) - L[k])
        drop = float(H[k - 8:k].max() - L[k])
        drop_ok = drop >= 1.2 * a
        prior_low = float(L[k - 8:k].min())
        found = []

        # 1) wick penolakan bawah (hammer), +sweep jika menembus low sebelumnya
        if (drop_ok and rng >= 0.45 * a and lw >= 0.45 * rng and lw >= 1.8 * max(ab, 0.05 * a)
                and (float(C[k] - L[k]) / rng) >= 0.6 and float(L[k]) <= prior_low + 0.15 * a):
            sweep = float(L[k]) < prior_low - 0.03 * a
            found.append(("hammer", 0.30 + (0.10 if sweep else 0.0), float(L[k]),
                          "wick penolakan bawah" + (" + sweep" if sweep else "")))

        # 2) bullish engulfing
        if (drop_ok and body >= 0.30 * a and C[k - 1] < O[k - 1] and float(O[k - 1] - C[k - 1]) >= 0.12 * a
                and O[k] <= C[k - 1] + 0.05 * a and C[k] >= O[k - 1]):
            strong = float(C[k]) > float(H[k - 1])
            found.append(("engulf", 0.30 + (0.05 if strong else 0.0), float(min(L[k], L[k - 1])),
                          "bullish engulfing"))

        # 3) morning star
        b1 = float(O[k - 2] - C[k - 2])
        b2 = abs(float(C[k - 1] - O[k - 1]))
        drop_ms = float(H[k - 10:k - 2].max() - L[k - 2:k + 1].min())
        if (drop_ms >= 1.2 * a and b1 >= 0.5 * a and b2 <= 0.35 * b1 and L[k - 1] <= C[k - 2] + 0.1 * a
                and body >= 0.4 * a and C[k] >= (O[k - 2] + C[k - 2]) / 2.0):
            found.append(("star", 0.35 + (0.05 if C[k] >= O[k - 2] else 0.0), float(L[k - 2:k + 1].min()),
                          "morning star"))

        # 4) CISD: close di atas open dari rangkaian candle turun (delivery) terakhir
        if body > 0:
            i, bad = k - 1, 0
            while i >= k - 10:
                if C[i] < O[i]:
                    i -= 1
                    continue
                if bad == 0 and float(C[i] - O[i]) <= 0.25 * a and i - 1 >= 0 and C[i - 1] < O[i - 1]:
                    bad += 1
                    i -= 1
                    continue
                break
            first = i + 1
            nbear = int(sum(1 for j in range(first, k) if C[j] < O[j]))
            if nbear >= 2 and first <= k - 2:
                run_open = float(O[first])
                run_drop = run_open - float(L[first:k + 1].min())
                if float(C[k]) > run_open and run_drop >= 1.0 * a:
                    found.append(("cisd", 0.35 + (0.05 if body >= 0.5 * a else 0.0),
                                  float(L[first:k + 1].min()), "CISD naik"))

        # 5) displacement
        if drop_ok and body >= 1.0 * a and C[k] > H[k - 1]:
            found.append(("disp", 0.15, float(L[k]), "displacement naik"))

        for kind, w, low, txt in found:
            later = L[k + 1:]
            if len(later) and float(later.min()) < low - 0.15 * a:
                continue                                  # pola sudah gagal (low ditembus lagi)
            out.append(dict(kind=kind, w=w, age=age, t=int(T[k]), low=low, txt=txt))
    return out

def rev_text(txt, buy):
    """Terjemahkan teks pola dari ruang bullish ke arah sebenarnya (SELL)."""
    if buy:
        return txt
    for x, y in (("wick penolakan bawah", "wick penolakan atas"),
                 ("bullish engulfing", "bearish engulfing"),
                 ("morning star", "evening star"),
                 ("CISD naik", "CISD turun"),
                 ("displacement naik", "displacement turun")):
        txt = txt.replace(x, y)
    return txt

def rev_all(ctx):
    """Hitung semua bukti pembalikan (M1 + M5) sekali per candle, per sisi (BUY = bukti harga naik)."""
    m5 = next((tf for tf in ctx["tfs"] if tf["name"] == "M5"), None)
    if m5 is None:
        return REV_CACHE["v"]
    key = (int(ctx["T"][-1]), int(m5["df"].time.values[-1]))
    if REV_CACHE["k"] == key and REV_CACHE["v"] is not None:
        return REV_CACHE["v"]
    zones = ctx.get("strong") or []
    res = {"BUY": [], "SELL": []}
    for side in ("BUY", "SELL"):
        buy = side == "BUY"
        sg = 1 if buy else -1
        best = {}
        for nm, df, a_tf, mult, max_age in (
                ("M1", ctx["m1"], float(ctx["a"]), 1.0, REV_MAX_AGE_M1),
                ("M5", m5["df"], float(m5["a"]), REV_M5_MULT, REV_MAX_AGE_M5)):
            if not a_tf > 0:
                continue
            for pt in _rev_patterns(df, buy, a_tf, max_age):
                real_ext = sg * pt["low"]
                at_zone = any(z["st"] >= REV_ZONE_MIN_ST and z["lo"] - 0.4 * a_tf <= real_ext <= z["hi"] + 0.4 * a_tf
                              for z in zones)
                dec = 1.0 - 0.7 * pt["age"] / (max_age + 1)
                e = min(0.9, pt["w"] * mult * dec * (1.0 if at_zone else REV_NOZONE_MULT))
                it = dict(tf=nm, kind=pt["kind"], e=e, tc=pt["t"] + TF_SEC[nm],
                          txt=f"{rev_text(pt['txt'], buy)} {nm}" + (" di area kuat" if at_zone else ""))
                k2 = (nm, pt["kind"])
                if k2 not in best or it["e"] > best[k2]["e"]:
                    best[k2] = it                         # satu bukti terbaik per jenis per timeframe
        res[side] = list(best.values())
    REV_CACHE["k"], REV_CACHE["v"] = key, res
    return res


def rev_score(side, after_t=None):
    """Skor bukti harga akan bergerak KE ARAH `side` (0..1) dan alasannya.
    after_t: hanya hitung pola yang candle-nya TUTUP setelah waktu ini (mis. waktu posisi dibuka)."""
    if not REV_ON or not LAST_CTX:
        return 0.0, []
    try:
        data = rev_all(LAST_CTX)
    except Exception:
        log_exc("rev_all")
        return 0.0, []
    if not data:
        return 0.0, []
    es = [(x["e"], x["txt"]) for x in data[side] if after_t is None or x["tc"] > after_t]
    now = srv_now()
    TRAPS[:] = [t for t in TRAPS if now - t["t"] <= TRAP_LIFE]
    for tr in TRAPS:
        if tr["bias"] != side or (after_t is not None and tr["t"] <= after_t):
            continue
        age = now - tr["t"]
        e = TRAP_W * REV_TRAP_TF.get(tr["tf"], 0.8) * min(1.0, tr["q"] / 100.0) * (1.0 - age / TRAP_LIFE)
        if e > 0.02:
            es.append((e, f"jebakan {tr['name']} {tr['tf']} (breakout gagal)"))
    prod = 1.0
    for e, _ in es:
        prod *= (1.0 - e)
    return float(1.0 - prod), [t for _, t in sorted(es, reverse=True)[:4]]


def rev_veto_thr(side):
    """Ambang veto. Lebih ketat jika baru kalah di arah yang sama."""
    trades = cache.get("trades") or []
    if trades:
        last = trades[-1]
        if (last["profit"] < 0 and last["side"] == side
                and srv_now() - float(last.get("close_time") or 0) <= REV_LOSS_WINDOW):
            return REV_VETO_AFTER_LOSS
    return REV_VETO


def _log_rev(ev):
    sig = "|".join(f"{sd}:{int(v[0] * 10)}" for sd, v in ev.items())
    now = time.time()
    top = max(v[0] for v in ev.values())
    if top >= 0.30 and (sig != REV_LOG["sig"] or now - REV_LOG["t"] >= 120):
        REV_LOG.update(sig=sig, t=now)
        log("[REVERSAL] " + " | ".join(
            f"harga naik {v[0] * 100:.0f}% ({', '.join(v[1][:3])})" if sd == "BUY"
            else f"harga turun {v[0] * 100:.0f}% ({', '.join(v[1][:3])})"
            for sd, v in ev.items() if v[0] >= 0.15))
    elif top < 0.30:
        REV_LOG["sig"] = sig


def apply_reversal(setups, ctx):
    """Sesuaikan probabilitas, peringkat, dan gerbang tiap setup dengan bukti pembalikan."""
    if not REV_ON or not setups:
        return
    try:
        rev_all(ctx)
    except Exception:
        log_exc("rev_all")
        return
    ev = {sd: rev_score(sd) for sd in ("BUY", "SELL")}
    _log_rev(ev)
    ctx["rev"] = {sd: round(v[0], 2) for sd, v in ev.items()}
    cost_usd = float(ctx["spread"]) + SLIPPAGE_USD + FEE_USD
    pmin = V17_MIN_P if V17_MIN_P is not None else (SMART_MIN_P if SMART_MODE else eff_min_p(MIN_P))
    for s in setups:
        side = s["side"]
        opp_side = "SELL" if side == "BUY" else "BUY"
        own, ownw = ev[side]
        opp, oppw = ev[opp_side]
        s["rev_own"], s["rev_opp"] = round(own, 2), round(opp, 2)
        if own < 0.05 and opp < 0.05:
            continue
        pw = min(0.92, max(0.15, float(s["pw"]) + REV_P_OWN * own - REV_P_OPP * opp))
        e = LEARNER.ev_r(pw, cost_usd / max(float(s["sl_d"]), 0.5))
        gates = [g for g in s["gates"] if not g.startswith("probabilitas")]
        if pw < pmin:
            gates.append(f"probabilitas {pw * 100:.0f}% < {pmin * 100:.0f}%")
        thr = rev_veto_thr(side)
        if opp >= thr:
            gates.append(f"tanda pembalikan {opp_side} kuat ({opp * 100:.0f}% >= {thr * 100:.0f}%): "
                         + ", ".join(oppw[:3]))
        room = float(s["rr"]) * float(s["sl_d"])
        if (opp >= REV_ROOM_STRICT and opp > own + 0.05
                and room < MIN_RR * float(s["sl_d"])
                and not any(g.startswith("ruang sempit") for g in gates)):
            gates.append(f"ruang sempit: {s['rr']:.1f}R < {MIN_RR}R (ada tanda pembalikan {opp_side})")
            s["room_ok"] = False
        tags = list(s["tags"])
        if own >= 0.15:
            tags.append(f"bukti pembalikan searah {own * 100:.0f}%: {', '.join(ownw[:2])}")
        if opp >= 0.15:
            tags.append(f"bukti pembalikan LAWAN {opp * 100:.0f}%: {', '.join(oppw[:2])}")
        s.update(pw=pw, p=round(pw * 100.0, 1), ev=round(e, 2), gates=gates, tags=tags,
                 rank=round(float(s["rank"]) + REV_RANK * (own - opp), 2),
                 eligible=not [g for g in gates if ROOM_HARD or not g.startswith("ruang")])
    setups.sort(key=lambda s: (not s["eligible"], -s["rank"]))


