def approach_risk(H, L, O, C, V, a, k):
    """Risiko harga MENEMBUS limit, dari candle TERTUTUP sampai indeks k. Ruang 'bullish':
    BUY = limit di bawah harga yang sedang turun; SELL sudah dicerminkan (mirror_df).
    Return (risk 0..1, hold 0..1, alasan_risiko, alasan_tahan)."""
    if k < 14 or not a > 0 or len(C) <= k:
        return 0.0, 0.0, [], []
    R, Hd, why, hwhy = [], [], [], []
    rng = lambda i: max(float(H[i] - L[i]), 1e-9)

    # --- bukti TEMBUS
    drive = float(C[k - 3] - C[k]) / a
    nbear = sum(1 for i in (k - 2, k - 1, k) if C[i] < O[i])
    path = sum(rng(i) for i in (k - 2, k - 1, k))
    eff = max(0.0, float(O[k - 2] - C[k])) / path
    if drive >= 1.0 and nbear >= 2:
        R.append(0.6 * min(1.0, (drive - 1.0) / 2.5) * (0.5 + 0.5 * min(eff, 1.0)) + 0.05)
        why.append(f"dorongan {drive:.1f} ATR menuju level")
    for age, dec in ((0, 1.0), (1, 0.7)):
        i = k - age
        body = float(O[i] - C[i])
        if body >= 0.8 * a and float(C[i] - L[i]) / rng(i) <= 0.3:
            R.append(0.45 * dec)
            why.append("candle searah tembusan kuat, close di ujung")
        if (C[i] < O[i] and C[i - 1] > O[i - 1] and body >= 0.4 * a
                and O[i] >= C[i - 1] - 0.05 * a and C[i] <= O[i - 1]):
            R.append(0.5 * dec)
            why.append("engulfing searah tembusan")
    for age, dec in ((0, 1.0), (1, 0.8), (2, 0.6)):
        i = k - age
        body = abs(float(C[i] - O[i]))
        uw = float(H[i] - max(O[i], C[i]))
        if (uw >= 0.4 * a and uw >= 1.5 * max(body, 0.05 * a) and float(C[i] - L[i]) / rng(i) <= 0.4
                and float(H[i]) >= float(H[i - 5:i].max()) - 0.3 * a):
            R.append(0.35 * dec)
            why.append("penolakan wick dari sisi harga datang (tekanan searah tembusan)")
            break
    vr = float(V[k - 2:k + 1].mean()) / (float(V[k - 12:k - 2].mean()) + 1e-9)
    lw_avg = sum(float(min(O[i], C[i]) - L[i]) / rng(i) for i in (k - 2, k - 1, k)) / 3.0
    if vr >= 1.3 and lw_avg <= 0.2 and nbear >= 2:
        R.append(0.3)
        why.append("volume naik tanpa serapan (tanpa wick penahan)")

    # --- bukti TAHAN
    for age, dec in ((0, 1.0), (1, 0.8), (2, 0.6)):
        i = k - age
        body = abs(float(C[i] - O[i]))
        lw_ = float(min(O[i], C[i]) - L[i])
        if lw_ >= 0.4 * a and lw_ >= 1.5 * max(body, 0.05 * a) and float(C[i] - L[i]) / rng(i) >= 0.6:
            Hd.append(0.4 * dec)
            hwhy.append("penolakan wick di sisi level (penahan)")
            break
    for age, dec in ((0, 1.0), (1, 0.7)):
        i = k - age
        body = float(C[i] - O[i])
        if body >= 0.3 * a and C[i - 1] < O[i - 1] and C[i] >= O[i - 1] and O[i] <= C[i - 1] + 0.05 * a:
            Hd.append(0.45 * dec)
            hwhy.append("engulfing pantul")
            break
    prior = float(C[k - 6] - C[k - 2]) / a
    if prior >= 1.0 and rng(k) <= 0.5 * a and rng(k - 1) <= 0.6 * a and V[k] <= V[k - 1] * 1.05:
        Hd.append(0.3)
        hwhy.append("dorongan melambat")
    if vr >= 1.5 and abs(drive) <= 0.3:
        Hd.append(0.35)
        hwhy.append("serapan: volume tinggi, gerak kecil")
    return _noisy_or(R), _noisy_or(Hd), why, hwhy


def _shadow_fill(s, T, Ll, Hh, spr, Cc):
    """Return (indeks_fill, harga, status). status: filled | void | wait.
    void jika: melewati SHADOW_FILL_MAX_MIN menit, close menembus sisi jauh zona sebelum terisi,
    atau candle sudah di luar jendela data. Meniru limit nyata."""
    buy = s["side"] == "BUY"
    lvl = float(s["entry"])
    a = float(s.get("atr") or 1.0)
    zlo, zhi = s.get("zone_lo"), s.get("zone_hi")
    ob = int(s["open_bar"])
    if ob < int(T[0]):
        return None, None, "void"
    t_exp = ob + SHADOW_FILL_MAX_MIN * 60
    for i in np.where(T > ob)[0]:
        if int(T[i]) > t_exp:
            return None, None, "void"
        if buy:
            if Ll[i] + spr <= lvl:
                return int(i), lvl, "filled"
        elif Hh[i] >= lvl:
            return int(i), lvl, "filled"
        if zlo is not None and zhi is not None:
            if buy and Cc[i] < float(zlo) - FOCUS_BREAK_ATR * a:
                return None, None, "void"
            if (not buy) and Cc[i] > float(zhi) + FOCUS_BREAK_ATR * a:
                return None, None, "void"
    return None, None, "wait"


def _sim_core(s, start, fill_px, T, Hh, Ll, Cc, spr, steps, gap):
    """Satu varian tangga. Candle fill hanya dipakai untuk cek SL (high candle itu bisa terjadi
    SEBELUM fill, jadi tidak dipakai menaikkan SL+, sama seperti peak_favorable di bot nyata)."""
    buy = s["side"] == "BUY"
    entry = float(fill_px)
    risk = float(s["sl_dist"])
    sl = entry - risk if buy else entry + risk
    ext = entry
    n = len(T)
    for i in range(start, n):
        if buy:
            if Ll[i] <= sl:
                return (sl - entry) / risk, int(T[i])
        elif Hh[i] + spr >= sl:
            return (entry - sl) / risk, int(T[i])
        if i == start:
            continue
        if buy:
            ext = max(ext, float(Hh[i]))
            move = ext - entry
        else:
            ext = min(ext, float(Ll[i]) + spr)
            move = entry - ext
        off = ladder_offset_cfg(move, risk, steps, gap)
        if off is not None:
            cand = entry + off if buy else entry - off
            sl = max(sl, cand) if buy else min(sl, cand)
    if n - start >= SHADOW_EXPIRE_BARS:
        last = float(Cc[-1])
        mv = (last - entry) if buy else (entry - last - spr)
        return max(-1.0, mv / risk), int(T[-1])
    return None, None


def sim_variants(s, T, Hh, Ll, Cc, spr):
    """Return (status, idx_fill, {varian: (r, close_time)}). status: wait | void | open | done."""
    idx, px, st = _shadow_fill(s, T, Ll, Hh, spr, Cc)
    if st != "filled":
        return st, None, None
    out = {}
    for name, cfg in LADDER_VARIANTS.items():
        r, ct = _sim_core(s, idx, px, T, Hh, Ll, Cc, spr, cfg["steps"], cfg["gap"])
        if r is None:
            return "open", idx, None
        out[name] = (r, ct)
    return "done", idx, out


