def ladder_offset_cfg(profit, risk, steps_cfg, gap_pips):
    """Profit puncak (dolar) -> offset SL dari open (dolar) untuk satu konfigurasi tangga."""
    k = (float(risk) / SL_USD) if risk and SL_USD > 0 else 1.0
    k = max(0.5, min(k, 3.0))
    steps = sorted((p * PIP_USD * k, o * PIP_USD * k) for p, o in steps_cfg)
    if not steps or profit < steps[0][0]:
        return None
    last_p, last_o = steps[-1]
    if profit >= last_p:
        return max(last_o, profit - gap_pips * PIP_USD * k)
    off = steps[0][1]
    for p0, o0 in steps:
        if profit >= p0:
            off = o0
    return off


def ladder_offset(profit, risk=None):
