# ===================================================================== peramal arah
FC_COLS = ["r1", "r3", "r5", "r15", "r60", "d20", "x2050", "x50200", "s50",
           "rsi", "clv", "body", "vflow", "pos60", "mr"]


def fc_features(df):
    """Fitur arah (hanya memakai data sampai candle itu, tanpa melihat ke depan)."""
    C = df["close"].astype(float)
    H = df["high"].astype(float)
    L = df["low"].astype(float)
    O = df["open"].astype(float)
    V = df["tick_volume"].astype(float) + 1.0
    A = atr(df).replace(0, np.nan)
    f = pd.DataFrame(index=df.index)
    for k in (1, 3, 5, 15, 60):
        f[f"r{k}"] = ((C - C.shift(k)) / A).clip(-6, 6)
    e20, e50, e200 = ema(C, 20), ema(C, 50), ema(C, 200)
    f["d20"] = ((C - e20) / A).clip(-6, 6)
    f["x2050"] = ((e20 - e50) / A).clip(-6, 6)
    f["x50200"] = ((e50 - e200) / A).clip(-10, 10)
    f["s50"] = ((e50 - e50.shift(10)) / A).clip(-4, 4)
    f["rsi"] = (rsi(C) - 50.0) / 50.0
    rng = (H - L).replace(0, np.nan)
    f["clv"] = ((2 * C - H - L) / rng).fillna(0.0)
    f["body"] = ((C - O) / A).clip(-3, 3)
    vr = np.log(V / V.rolling(20).mean()).clip(-1.5, 1.5)
    f["vflow"] = vr * np.sign(C - O)
    hi60, lo60 = H.rolling(60).max(), L.rolling(60).min()
    f["pos60"] = ((C - lo60) / (hi60 - lo60).replace(0, np.nan)) - 0.5
    sd30 = C.rolling(30).std().replace(0, np.nan)
    f["mr"] = ((C - C.rolling(30).mean()) / sd30).clip(-4, 4)
    return f[FC_COLS].replace([np.inf, -np.inf], np.nan)


class DirectionForecaster:
    """Regresi logistik: P(harga menyentuh +k ATR lebih dulu daripada -k ATR dalam N menit).
    Dilatih dari riwayat MT5, diuji pada data terbaru yang tidak ikut dilatih, dan dicek ulang
    terhadap hasil nyata. Jika tidak terbukti punya keunggulan, pengaruhnya otomatis 0."""

    def __init__(self):
        self.w, self.b, self.mu, self.sd = None, 0.0, None, None
        self.base, self.rel, self.skill, self.acc, self.rows = 0.5, 0.0, 0.0, 0.0, 0
        self.t, self.bar = 0.0, 0
        self.p, self.raw, self.dir, self.live_f = 0.5, 0.0, 0.0, 1.0
        self.pend, self.res, self.lbl = [], [], ""

    @staticmethod
    def _sig(z):
        return 1.0 / (1.0 + np.exp(-np.clip(z, -30, 30)))

    def _fit(self, X, y, w):
        m, d = X.shape
        Xb = np.hstack([X, np.ones((m, 1))])
        ws = w / w.mean()
        th = np.zeros(d + 1)
        for _ in range(FC_ITERS):
            p = self._sig(Xb @ th)
            g = Xb.T @ (ws * (p - y)) / m
            g[:-1] += FC_L2 * th[:-1]
            th -= FC_LR * g
        return th

    def train(self):
        self.t = time.time()
        r = mt5.copy_rates_from_pos(SYMBOL, mt5.TIMEFRAME_M1, 1, FC_TRAIN_BARS)
        if r is None or len(r) < FC_MIN_ROWS + 300:
            return
        df = pd.DataFrame(r)
        f = fc_features(df)
        H, L, C = (df[c].values.astype(float) for c in ("high", "low", "close"))
        A = atr(df).values
        n, N, k = len(df), FC_HORIZON, FC_BARRIER_ATR
        up = np.full(n, N + 1)
        dn = np.full(n, N + 1)
        for h in range(1, N + 1):
            hu = np.zeros(n, bool)
            hd = np.zeros(n, bool)
            hu[:n - h] = H[h:] >= C[:n - h] + k * A[:n - h]
            hd[:n - h] = L[h:] <= C[:n - h] - k * A[:n - h]
            up = np.where(hu & (up > N), h, up)
            dn = np.where(hd & (dn > N), h, dn)
        y = np.full(n, np.nan)
        y[up < dn] = 1.0
        y[dn < up] = 0.0
        y[n - N:] = np.nan                       # ekor belum punya masa depan lengkap
        ok = f.notna().all(axis=1).values & ~np.isnan(y)
        ok[:250] = False                         # pemanasan EMA
        idx = np.where(ok)[0]
        if len(idx) < FC_MIN_ROWS:
            return
        X, yy = f.values[idx].astype(float), y[idx]
        wt = 0.5 ** ((n - 1 - idx) / FC_HALF_LIFE)
        cut = int(len(idx) * 0.75)               # kronologis: 75% latih, 25% uji
        mu, sd = X[:cut].mean(0), X[:cut].std(0) + 1e-9
        th = self._fit((X[:cut] - mu) / sd, yy[:cut], wt[:cut])
        pv = self._sig(((X[cut:] - mu) / sd) @ th[:-1] + th[-1])
        base = float(np.average(yy[:cut], weights=wt[:cut]))

        def ll(p_, y_):
            p_ = np.clip(p_, 1e-6, 1 - 1e-6)
            return float(-np.mean(y_ * np.log(p_) + (1 - y_) * np.log(1 - p_)))

        ll_m, ll_b = ll(pv, yy[cut:]), ll(np.full(len(pv), base), yy[cut:])
        skill = (ll_b - ll_m) / ll_b
        conf = np.abs(pv - base) >= 0.5 * FC_SPAN
        acc = float(np.mean((pv[conf] > base) == (yy[cut:][conf] > 0.5))) if conf.sum() >= 30 else 0.0
        mu, sd = X.mean(0), X.std(0) + 1e-9      # latih ulang di seluruh data
        th = self._fit((X - mu) / sd, yy, wt)
        self.w, self.b, self.mu, self.sd = th[:-1].copy(), float(th[-1]), mu, sd
        self.base, self.skill, self.acc, self.rows = base, float(skill), acc, int(len(idx))
        self.rel = float(max(0.0, min(1.0, (skill - FC_SKILL_MIN) / (FC_SKILL_FULL - FC_SKILL_MIN))))
        log(f"[FORECAST] model dilatih {len(idx)} baris: keunggulan uji {skill * 100:+.2f}% logloss, "
            f"akurasi yakin {acc * 100:.0f}%, bobot kepercayaan {self.rel:.2f}"
            + ("" if self.rel > 0 else " (belum terbukti, prediksi tidak dipakai)"))

    def predict(self, df):
        if self.w is None:
            return None
        row = fc_features(df).iloc[-1]
        if row.isna().any():
            return None
        x = (row.values.astype(float) - self.mu) / self.sd
        return float(self._sig(self.b + float(self.w @ x)))

    def _live(self, m1, raw):
        """Cocokkan prediksi lama dengan hasil nyata, lalu catat prediksi baru."""
        T, H, L, C = m1.time.values, m1.high.values, m1.low.values, m1.close.values
        A = atr(m1).values
        keep = []
        for q in self.pend:
            idx = np.where(T > q["t"])[0]
            if len(idx) < FC_HORIZON:
                keep.append(q)
                continue
            uf = df_ = None
            for i in idx[:FC_HORIZON]:
                if uf is None and H[i] >= q["c"] + FC_BARRIER_ATR * q["a"]:
                    uf = int(i)
                if df_ is None and L[i] <= q["c"] - FC_BARRIER_ATR * q["a"]:
                    df_ = int(i)
            out = None
            if uf is not None and (df_ is None or uf < df_):
                out = 1
            elif df_ is not None and (uf is None or df_ < uf):
                out = 0
            if out is not None and abs(q["raw"]) >= FC_LIVE_CONF:
                self.res.append(1 if (out == 1) == (q["raw"] > 0) else 0)
                self.res = self.res[-200:]
        self.pend = keep
        self.pend.append(dict(t=int(T[-1]), c=float(C[-1]), a=float(A[-1]), raw=float(raw)))
        self.pend = self.pend[-60:]
        if len(self.res) >= FC_LIVE_MIN_N:
            acc = sum(self.res) / len(self.res)
            self.live_f = float(max(0.0, min(1.0, (acc - 0.45) / 0.10)))
        else:
            self.live_f = 1.0

    def update(self, ctx):
        if not FC_ON:
            self.dir = 0.0
            return
        bar = int(ctx["T"][-1])
        if bar == self.bar:
            return
        if self.w is None or time.time() - self.t >= FC_RETRAIN_SEC:
            try:
                self.train()
            except Exception:
                log_exc("fc_train")
        self.bar = bar
        p = self.predict(ctx["m1"])
        if p is None:
            self.p, self.raw, self.dir = 0.5, 0.0, 0.0
            return
        self.p = p
        self.raw = float(max(-1.0, min(1.0, (p - self.base) / FC_SPAN)))
        try:
            self._live(ctx["m1"], self.raw)
        except Exception:
            log_exc("fc_live")
        self.dir = float(self.raw * self.rel * self.live_f)
        lbl = "NAIK" if self.dir >= FC_LABEL_THR else "TURUN" if self.dir <= -FC_LABEL_THR else "NETRAL"
        if lbl != self.lbl:
            self.lbl = lbl
            log(f"[FORECAST] arah {FC_HORIZON} menit: {lbl} (P naik {p * 100:.0f}%, dir {self.dir:+.2f}, "
                f"kepercayaan {self.rel * self.live_f:.2f})")

    def public(self):
        d = {"on": FC_ON, "p_up": round(self.p, 3), "dir": round(self.dir, 2), "raw": round(self.raw, 2),
             "label": self.lbl or "NETRAL", "reliability": round(self.rel, 2), "live_factor": round(self.live_f, 2),
             "skill_pct": round(self.skill * 100, 2), "acc_confident": round(self.acc * 100, 1),
             "live_n": len(self.res),
             "live_acc": round(sum(self.res) / len(self.res) * 100, 1) if self.res else None,
             "rows": self.rows, "horizon_min": FC_HORIZON, "barrier_atr": FC_BARRIER_ATR,
             "note": "" if self.rel > 0 else "belum ada keunggulan statistik, prediksi tidak mempengaruhi keputusan",
             "target": None}
        try:
            if LAST_CTX and abs(self.dir) >= FC_LABEL_THR:
                px = float(LAST_CTX["m1"].close.iloc[-1])
                a = float(LAST_CTX["a"])
                zs = [z for z in LAST_CTX.get("strong", []) if z["st"] >= SR_MIN_ST]
                if self.dir > 0:
                    c = [z["lo"] for z in zs if z["lo"] > px + 0.1 * a]
                    d["target"] = round(min(c), 2) if c else None
                else:
                    c = [z["hi"] for z in zs if z["hi"] < px - 0.1 * a]
                    d["target"] = round(max(c), 2) if c else None
        except Exception:
            pass
        return d


FC = DirectionForecaster()


def fc_align(side):
    """-1..+1: positif jika prediksi searah dengan sisi trade."""
    if not FC_ON:
        return 0.0
    return FC.dir if side == "BUY" else -FC.dir


# ===================================================================== kalibrator + edge book
class EdgeBook:
    """Belajar dari sinyal bayangan + trade asli:
    1) kalibrasi: probabilitas yang diklaim vs hasil sebenarnya (koreksi maks +/- CAL_MAX),
    2) edge per (kode, arah): rata-rata R. Terbukti negatif = dimute, terbukti positif = naik peringkat."""

    def __init__(self):
        self.t, self.sig = 0.0, None
        self.tab, self.bins, self.n, self.muted = {}, {}, 0, []

    def maybe_rebuild(self):
        now = time.time()
        if now - self.t < EDGE_REBUILD_SEC:
            return
        self.t = now
        recs = []
        with dblock:
            for s in db["shadow"]:
                if s.get("done") and s.get("r") is not None and s.get("code"):
                    p = s.get("p_raw", s.get("p"))
                    recs.append((float(s.get("close_time") or 0), s["code"], s.get("side", ""),
                                 None if p is None else float(p) / 100.0, float(s["r"]), SHADOW_W))
            meta = db["meta"]
            with lock:
                trades = list(cache["trades"])
            for t in trades:
                if not t.get("code") or t.get("r") is None:
                    continue
                m = meta.get(str(t["ticket"])) or {}
                p = m.get("p_raw", m.get("p", t.get("p")))
                recs.append((float(t.get("close_time") or 0), t["code"], t.get("side", ""),
                             None if p is None else float(p) / 100.0, float(t["r"]), 1.0))
        recs.sort(key=lambda x: x[0])
        N = len(recs)
        tab, bins, ncal = {}, {}, 0
        for j, (_, code, side, p, r, sw) in enumerate(recs):
            w = (0.5 ** ((N - 1 - j) / EDGE_HALF_LIFE)) * sw
            a = tab.setdefault((code, side), [0.0, 0.0])
            a[0] += w
            a[1] += w * r
            if p is not None:
                i = min(len(CAL_EDGES) - 2, max(0, bisect.bisect_right(CAL_EDGES, p) - 1))
                b = bins.setdefault(i, [0.0, 0.0, 0.0])
                b[0] += w
                b[1] += w * (1.0 if r >= LEARN_WIN_R else 0.0)
                b[2] += w * p
                ncal += 1
        self.tab, self.bins, self.n = tab, bins, ncal
        muted = sorted(f"{c} {s}" for (c, s), a in tab.items()
                       if a[0] >= EDGE_MIN_N and a[1] / (a[0] + EDGE_K) <= EDGE_MUTE_R)
        sig = (N, tuple(muted))
        if sig != self.sig:
            self.sig, self.muted = sig, muted
            adj = ", ".join(
                f"bin{CAL_EDGES[i]:.2f}:{(b[1] / b[0] - b[2] / b[0]) * 100:+.0f}%"
                for i, b in sorted(bins.items()) if b[0] >= CAL_BIN_MIN)
            log(f"[BELAJAR] {N} data (bayangan+asli). Dimute: {', '.join(muted) or '-'}. "
                f"Selisih hasil-vs-klaim per bin: {adj or 'belum cukup data'}")

    def calibrate(self, p):
        if self.n < CAL_MIN_N:
            return p
        i = min(len(CAL_EDGES) - 2, max(0, bisect.bisect_right(CAL_EDGES, p) - 1))
        b = self.bins.get(i)
        if not b or b[0] < CAL_BIN_MIN:
            return p
        d = (b[1] / b[0] - b[2] / b[0]) * b[0] / (b[0] + CAL_K)
        return p + max(-CAL_MAX, min(CAL_MAX, d))

    def status(self, code, side):
        a = self.tab.get((code, side))
        if not a:
            return 0.0, 0.0, False
        m = a[1] / (a[0] + EDGE_K)
        return m, a[0], bool(a[0] >= EDGE_MIN_N and m <= EDGE_MUTE_R)

    def boost(self, code, side):
        m, n, _ = self.status(code, side)
        if n < EDGE_BOOST_MIN_N:
            return 0.0
        return float(max(-1.0, min(1.0, m / 0.4)) * EDGE_RANK)


EDGE = EdgeBook()


def conviction(s):
    """Keyakinan 0..1: probabilitas (40%), kekuatan area (35%), kelompok bukti (25%), +/-0.15 dari prediksi arah."""
    p = float(s.get("p", 0.0))
    st = float(s.get("strength", 0.0))
    g = int((s.get("smart") or {}).get("groups", 0))
    c = (0.40 * _c((p - 58.0) / 22.0, 0.0, 1.0) + 0.35 * _c((st - 55.0) / 40.0, 0.0, 1.0)
         + 0.25 * _c((g - 2.0) / 3.0, 0.0, 1.0))
    c += 0.15 * float(s.get("fc_al", 0.0))
    return float(_c(c, 0.0, 1.0))


def apply_v20(setups, ctx):
    """Dipanggil setelah seluruh penilaian lama: prediksi arah, kalibrasi, edge book."""
    try:
        FC.update(ctx)
    except Exception:
        log_exc("fc_update")
    try:
        EDGE.maybe_rebuild()
    except Exception:
        log_exc("edge_rebuild")
    ctx["fc"] = FC.dir
    if not setups:
        return
    cost_usd = float(ctx["spread"]) + SLIPPAGE_USD + FEE_USD
    pmin = V17_MIN_P if V17_MIN_P is not None else (SMART_MIN_P if SMART_MODE else eff_min_p(MIN_P))
    for s in setups:
        side = s["side"]
        fa = fc_align(side)
        s["fc_al"] = round(fa, 2)
        raw = min(0.92, max(0.15, float(s["pw"]) + FC_P * fa))
        s["p_raw"] = round(raw * 100.0, 1)                 # dipakai kalibrator (sebelum dikoreksi)
        pw = min(0.92, max(0.15, EDGE.calibrate(raw)))
        ev = LEARNER.ev_r(pw, cost_usd / max(float(s["sl_d"]), 0.5))
        gates = [g for g in s["gates"] if not g.startswith("probabilitas")]
        if pw < pmin:
            gates.append(f"probabilitas {pw * 100:.0f}% < {pmin * 100:.0f}%")
        if FC_ON and fa <= -FC_VETO:
            gates.append(f"prediksi arah melawan ({FC.p * 100:.0f}% naik dalam {FC_HORIZON} menit, {fa:+.2f})")
        er, en, muted = EDGE.status(s["code"], side)
        if muted:
            gates.append(f"edge negatif: {s['code']} {side} rata-rata {er:+.2f}R dari {en:.0f} data")
        tags = list(s["tags"])
        if abs(fa) >= 0.2:
            tags.append(f"prediksi arah {FC_HORIZON}m {fa:+.2f} ({FC_P * fa * 100:+.1f}% P)")
        if abs(pw - raw) >= 0.01:
            tags.append(f"kalibrasi hasil nyata ({(pw - raw) * 100:+.0f}% P)")
        s.update(pw=pw, p=round(pw * 100.0, 1), ev=round(ev, 2), gates=gates, tags=tags,
                 rank=round(float(s["rank"]) + FC_RANK * fa + EDGE.boost(s["code"], side), 2),
                 eligible=not [g for g in gates if ROOM_HARD or not g.startswith("ruang")])
    setups.sort(key=lambda s: (not s["eligible"], -s["rank"]))


_refine_setups_v19 = refine_setups


def refine_setups(setups, ctx):
    _refine_setups_v19(setups, ctx)
