class EdgeBook:
    """Belajar ekspektasi R dari bayangan (di-dedup per episode) + trade nyata.
    Estimasi = rata-rata R terkecilkan bertingkat: global -> kode -> (kode, arah) + koreksi konteks.
    Juga mengkalibrasi probabilitas dan mempelajari ambang penjaga limit."""

    def __init__(self):
        self.t, self.sig = 0.0, None
        self.g = [0.0, 0.0, 0.0]
        self.bk, self.tab, self.bins, self.gb = {}, {}, {}, {}
        self.n, self.n_rec, self.n_ep = 0, 0, 0
        self.muted = []
        self.gthr = GUARD_CANCEL_RISK
        self.g_mean = EDGE_PRIOR_R

    def _m(self, key, prior, K):
        a = self.bk.get(key)
        if not a or a[0] <= 0.0:
            return prior, 0.0
        return (a[1] + K * prior) / (a[0] + K), a[0]

    def maybe_rebuild(self):
        now = time.time()
        if now - self.t < EDGE_REBUILD_SEC:
            return
        self.t = now
        with dblock:
            sh = [dict(s) for s in db["shadow"]
                  if s.get("done") and s.get("r") is not None and s.get("code")]
            meta = {k: dict(v) for k, v in db["meta"].items()}
        with lock:
            trades = list(cache["trades"])
        n_ep = _assign_episodes(sh)
        recs = []
        for s in sh:
            w = (EDGE_SHADOW_W * (1.0 if s.get("elig_pre", True) else EDGE_INELIG_W)
                 * (1.0 if s.get("ver") == BOT_VER else OLD_VER_W) * (s["_epn"] ** -EPISODE_POWER))
            p = s.get("p_raw", s.get("p"))
            keys = _ctx_keys(s.get("side", ""), s.get("regime"), s.get("pdb"), s.get("stb"), s.get("tf"),
                             s.get("atr"), s.get("open_bar"), s.get("align"), s.get("elig_pre", True))
            recs.append((float(s.get("close_time") or 0), s["code"], s.get("side", ""),
                         None if p is None else float(p) / 100.0,
                         max(-1.5, min(3.0, float(s["r"]))), w, keys, s.get("grisk")))
        for t in trades:
            if not t.get("code") or t.get("r") is None:
                continue
            m = meta.get(str(t["ticket"])) or {}
            p = m.get("p_raw", m.get("p", t.get("p")))
            keys = _ctx_keys(t.get("side", ""), t.get("regime") or m.get("regime"), m.get("pdb"), m.get("stb"),
                             m.get("tf"), m.get("atr"), m.get("open_ts"), m.get("align"), m.get("elig_pre", True))
            w = EDGE_REAL_W * (1.0 if m.get("ver") == BOT_VER else OLD_VER_W)
            recs.append((float(t.get("close_time") or 0), t["code"], t.get("side", ""),
                         None if p is None else float(p) / 100.0,
                         max(-1.5, min(3.0, float(t["r"]))), w, keys, None))
        recs.sort(key=lambda x: x[0])
        N = len(recs)
        g, bk, tab, bins, gb, ncal = [0.0, 0.0, 0.0], {}, {}, {}, {}, 0
        for j, (_, code, side, p, r, w0, keys, grisk) in enumerate(recs):
            w = w0 * (0.5 ** ((N - 1 - j) / EDGE_HALF_LIFE))
            g[0] += w
            g[1] += w * r
            g[2] += w * r * r
            for k in [("C", code), ("CS", code, side)] + keys:
                a_ = bk.setdefault(k, [0.0, 0.0])
                a_[0] += w
                a_[1] += w * r
            t_ = tab.setdefault((code, side), [0.0, 0.0])
            t_[0] += w
            t_[1] += w * r
            if p is not None:
                i = min(len(CAL_EDGES) - 2, max(0, bisect.bisect_right(CAL_EDGES, p) - 1))
                b = bins.setdefault(i, [0.0, 0.0, 0.0])
                b[0] += w
                b[1] += w * (1.0 if r >= LEARN_WIN_R else 0.0)
                b[2] += w * p
                ncal += 1
            if grisk is not None:
                i = min(len(GUARD_EDGES) - 2, max(0, bisect.bisect_right(GUARD_EDGES, float(grisk)) - 1))
                q = gb.setdefault(i, [0.0, 0.0])
                q[0] += w
                q[1] += w * r
        self.g, self.bk, self.tab, self.bins, self.gb = g, bk, tab, bins, gb
        self.n, self.n_rec, self.n_ep = ncal, N, n_ep
        self.g_mean = (g[1] + EDGE_PRIOR_N * EDGE_PRIOR_R) / (g[0] + EDGE_PRIOR_N)
        self.muted = sorted(f"{c} {s}" for (c, s), a_ in tab.items()
                            if a_[0] >= EDGE_MIN_N and a_[1] / (a_[0] + EDGE_K) <= EDGE_MUTE_R)
        thr = GUARD_CANCEL_RISK
        nb = len(GUARD_EDGES) - 1
        for i in range(1, nb):
            w = sum(gb.get(j, [0.0, 0.0])[0] for j in range(i, nb))
            sr = sum(gb.get(j, [0.0, 0.0])[1] for j in range(i, nb))
            if w >= GUARD_BIN_MIN_N and sr / (w + 3.0) <= GUARD_BAD_R:
                thr = GUARD_EDGES[i]
                break
        self.gthr = max(GUARD_THR_MIN, min(GUARD_THR_MAX, thr))
        sig = (N, tuple(self.muted), round(self.gthr, 2))
        if sig != self.sig:
            self.sig = sig
            top = ", ".join(f"{c} {s}:{a_[1] / (a_[0] + EDGE_K):+.2f}R(n{a_[0]:.0f})"
                            for (c, s), a_ in sorted(tab.items(), key=lambda kv: -kv[1][0])[:6])
            log(f"[BELAJAR] {N} rekaman, {n_ep} episode bayangan. R global {self.g_mean:+.2f}. "
                f"Teratas: {top or '-'}. Dimute: {', '.join(self.muted) or '-'}. "
                f"Ambang penjaga limit {self.gthr:.2f}")

    def estimate(self, s):
        code, side = s["code"], s["side"]
        gw, g1, g2 = self.g
        g = (g1 + EDGE_PRIOR_N * EDGE_PRIOR_R) / (gw + EDGE_PRIOR_N)
        c, nc = self._m(("C", code), g, EDGE_K)
        cs, ncs = self._m(("CS", code, side), c, EDGE_K)
        ks = _ctx_keys(side, s.get("regime"), s.get("pdb"), s.get("stb"), s.get("tf"), s.get("atr"),
                       srv_now(), s.get("align"), s.get("elig_pre"))
        ds = []
        for k in ks:
            m, _ = self._m(k, g, EDGE_K_CTX)
            ds.append(m - g)
        exp = cs + (EDGE_CTX_W * sum(ds) / len(ds) if ds else 0.0)
        var = (g2 / gw - (g1 / gw) ** 2) if gw > 5 else 0.8
        sd = max(0.6, math.sqrt(max(var, 0.0)))
        n_eff = ncs + 0.5 * max(0.0, nc - ncs)
        lcb = exp - EDGE_Z * sd / math.sqrt(n_eff + 3.0)
        return {"exp": exp, "lcb": lcb, "n": n_eff, "g": g}

    def calibrate(self, p):
        if self.n < CAL_MIN_N:
            return p
        i = min(len(CAL_EDGES) - 2, max(0, bisect.bisect_right(CAL_EDGES, p) - 1))
        b = self.bins.get(i)
        if not b or b[0] < CAL_BIN_MIN:
            return p
        d = (b[1] / b[0] - b[2] / b[0]) * b[0] / (b[0] + CAL_K)
        return p + max(-CAL_MAX, min(CAL_MAX, d))

    def status(self, code, side):
        a = self.tab.get((code, side))
        if not a:
            return 0.0, 0.0, False
        m = a[1] / (a[0] + EDGE_K)
        return m, a[0], bool(a[0] >= EDGE_MIN_N and m <= EDGE_MUTE_R)

    def boost(self, code, side):
        return 0.0                      # peringkat sekarang diatur apply_v21

    def guard_thr(self):
        return self.gthr

    def public(self):
        return {"records": self.n_rec, "episodes": self.n_ep, "global_r": round(self.g_mean, 3),
                "muted": self.muted, "guard_thr": round(self.gthr, 2)}


EDGE = EdgeBook()


def guard_threshold():
