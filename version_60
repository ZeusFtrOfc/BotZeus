def block_reason(now, h):
    """Alasan tidak boleh memasang order baru. Return None jika boleh. (Berita tidak lagi diperhitungkan.)"""
    if not state["enabled"]:
        return "dijeda", "entry baru dijeda dari dashboard"
    if SESSION_FILTER and not (SESSION_UTC[0] <= h < SESSION_UTC[1]):
        return "di luar sesi", "di luar jam sesi pilihan"
    if h in AVOID_HOURS_UTC:
        return "jam dihindari", f"jam {h} UTC dihindari"
    if FRI_STOP_HOUR is not None and now.weekday() == 4 and h >= FRI_STOP_HOUR:
        return "jumat malam", "pasar hampir tutup, tidak pasang order"
    rg = risk_guard_reason()
    if rg:
        return rg
    return None

def bot_step():
    refresh_diag()
    mt5.symbol_select(SYMBOL, True)
    tick = mt5.symbol_info_tick(SYMBOL)
    if tick is None:
        state.update(status="tidak ada tick", msg=f"simbol {SYMBOL} tidak ada data: cek nama simbol / pasar tutup")
        return
    wall = time.time()
    if tick.time != TICK_STATE["t"]:
        TICK_STATE.update(t=tick.time, seen=wall)
    stale = (wall - TICK_STATE["seen"]) > STALE_TICK_SEC
    state["spread"], state["price"] = round(tick.ask - tick.bid, 3), tick.bid
    state["srv"] = tick.time
    refresh_cache()
    handle_closed_losses(cache["trades"])
    try:
        manage_pending(tick)
    except Exception:
        log_exc("manage_pending")
    manage_positions()
    try:
        live_guard(tick)
    except Exception:
        log_exc("live_guard")
    try:
        if LAST_CTX:
            scan_broken_marks(float(tick.bid), float(tick.ask), float(LAST_CTX["a"]), time.time())
    except Exception:
        log_exc("scan_broken_marks")

    br = mt5.copy_rates_from_pos(SYMBOL, mt5.TIMEFRAME_M1, 0, 1)
    if br is not None and len(br):
        bar = br[0]["time"]
        new_bar = bar != bar_state["last"]
        if new_bar or REACT["force"] or time.time() - PLAN_TS["t"] >= ANALYZE_INTERVAL_SEC:
            bar_state["last"] = bar
            REACT["force"] = False
            try:
                analyze_market(new_bar)
            except Exception:
                log_exc("analyze_market")
            if new_bar:
                try:
                    resolve_shadows()
                except Exception:
                    log_exc("resolve_shadows")
    if LAST_CTX:
        try:
            mm_update(LAST_CTX, srv_now())
        except Exception:
            log_exc("mm_update")

    state["news_feed"] = "nonaktif"
    now = datetime.now(timezone.utc)
    cd = cooldown_left(cache["trades"])
    if cd > 0 and PENDING["order"] and not PENDING.get("touched"):
        cancel_pending("jeda setelah close")
    blocked = block_reason(now, now.hour)
    if blocked:
        cancel_pending(blocked[0])
        state.update(status=blocked[0], msg=blocked[1])
    elif cache["open"]:
        state.update(status="posisi aktif", msg="mengelola posisi, SL+ bertangga berjalan")
    elif PENDING["order"]:
        state.update(status="pesanan", msg=f"limit {PENDING['side']} di {PENDING['entry']:.2f}"
                     + (" (sudah disentuh, menunggu terisi)" if PENDING.get("touched") else ""))
    elif stale:
        state.update(status="data tidak update", msg=f"tick tidak berubah {int(wall - TICK_STATE['seen'])} detik, entry baru ditahan")
    elif state["spread"] > MAX_SPREAD:
        state.update(status="spread lebar", msg=f"spread {state['spread']} > batas {MAX_SPREAD}")
    elif cd > 0:
        state.update(status="jeda setelah close", msg=f"tunggu {int(cd) + 1} detik, analisis tetap berjalan")
    else:
        try:
            why = arm_entry(tick)
        except Exception:
            log_exc("arm_entry")
            why = "error di arm_entry (lihat bot_log.txt)"
        state.update(status="scanning", signal=why or "", msg=why or "")
    note_state()

def note_state():
    k = f"{state.get('status')}|{str(state.get('msg'))[:50]}"
    now = time.time()
    if k != LAST_NOTE["k"] and now - LAST_NOTE["t"] >= 30:
        LAST_NOTE.update(t=now, k=k)
        log(f"[STATUS] {state.get('status')}: {state.get('msg')}")


def bot_loop():
    last_save = 0.0
    while True:
        try:
            with mt5lock:
                bot_step()
        except Exception as e:
            try:
                state.update(status="error", msg=str(e))
                log_exc("bot_step")
            except Exception:
                pass
        try:
            if time.time() - last_save >= 5:          # v15.8: simpan blokir area tiap 5 detik jika berubah
                last_save = time.time()
                save_blocks()
        except Exception:
            log_exc("save_blocks")
        time.sleep(BOT_LOOP_SEC)

