def try_switch_focus(ranked_all, elig_live, a, now, bar_t, st5, st15):
    """Fokus terkomit hanya diganti jika: belum disentuh, harga masih jauh, sudah lama dipegang, dan kandidat
    JAUH lebih yakin (atau lebih dekat ke harga dan lebih yakin)."""
    global PLAN_ACTIVE
    P = PLAN_ACTIVE
    if P is None or not P.get("commit"):
        return _try_switch_focus_v30prev(ranked_all, elig_live, a, now, bar_t, st5, st15)
    if (not SWITCH_ON or P.get("exec") or P.get("touched") or cache["open"] or PENDING.get("touched")):
        return False
    if now - P.get("since", now) < COMMIT_SWITCH_HOLD_SEC or now - SWITCH_STATE["t"] < COMMIT_SWITCH_COOLDOWN_SEC:
        return False
    tk = mt5.symbol_info_tick(SYMBOL)
    if tk is None:
        return False
    buy = P["side"] == "BUY"
    px = float(tk.ask if buy else tk.bid)
    d_cur = ((px - float(P["zone_hi"])) if buy else (float(P["zone_lo"]) - px)) / a
    if d_cur <= COMMIT_NEAR_ATR:
        return False
    xc = _area_by_id(P.get("aid"))
    cur_cv = float(xc["cv"]) if xc is not None else float(P.get("cv", 0.0))
    cand = commit_pick(now, tk, exclude_aid=P.get("aid"), min_cv=cur_cv + COMMIT_SWITCH_MARGIN)
    if cand is None:
        return False
    cb = cand["side"] == "BUY"
    d_new = ((px - cand["zone_hi"]) if cb else (cand["zone_lo"] - px)) / a
    if float(cand["cv"]) < cur_cv + COMMIT_SWITCH_FAR_MARGIN and d_new >= d_cur:
        return False
    if PENDING["order"] and not cancel_pending("diganti area yang jauh lebih meyakinkan", force=True, block=False):
        return False
    SWITCH_STATE["t"] = now
    _plan_log(now, P["id"],
              f"GANTI KOMITMEN {P['side']} {P['name']} ({P['zone_lo']}-{P['zone_hi']}, cv {cur_cv:.0f}) -> "
              f"{cand['side']} {cand['name']} ({cand['zone_lo']}-{cand['zone_hi']}, cv {cand['cv']:.0f})")
    commit_release(P.get("aid"))
    PLAN_ACTIVE = lock_focus(_sniper_setup(cand, a, tk), bar_t, now, st5, st15)
    LOCK_IDLE["since"] = 0.0
    return True


