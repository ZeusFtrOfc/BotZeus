def manage_pending(tick):
    """Selama komitmen aktif dan limit belum tersentuh, kedaluwarsa limit terus diperpanjang."""
    try:
        P = PLAN_ACTIVE
        if (PENDING["order"] and P is not None and P.get("commit") and P.get("id") == PENDING.get("plan")
                and not PENDING.get("touched")
                and time.time() - float(P.get("since", time.time())) < COMMIT_MAX_MIN * 60):
            PENDING["exp"] = srv_now() + PENDING_EXPIRE_MIN * 60
    except Exception:
        log_exc("commit_pending_refresh")
    _manage_pending_v30prev(tick)


