def cooldown_left(trades):
    if not trades:
        return 0
    last = trades[-1]
    srv = state.get("srv") or time.time()
    need = COOLDOWN_AFTER_LOSS_SEC if last["profit"] < 0 else COOLDOWN_AFTER_WIN_SEC
    return max(0, need - (srv - last["close_time"]))


