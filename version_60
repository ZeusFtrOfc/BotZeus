    Berlaku walau FIXED_MODE = True."""
    try:
        EDGE.maybe_rebuild()
    except Exception:
        log_exc("edge_rebuild")
    if not setups:
        return
    a = float(ctx["a"])
    P = PLAN_ACTIVE
    for s in setups:
        s["elig_pre"] = not [g for g in s["gates"] if ROOM_HARD or not g.startswith("ruang")]
        est = EDGE.estimate(s)
        s["exp_r"], s["exp_lcb"], s["exp_n"] = round(est["exp"], 3), round(est["lcb"], 3), round(est["n"], 1)
        s["ev"] = round(est["exp"], 2)                     # EV yang tampil = ekspektasi R hasil belajar
        gates = [g for g in s["gates"] if not g.startswith("edge ")]
        if EDGE_GATE_ON:
            is_f = P is not None and is_focus_candidate(P, s, a)
            min_r = EDGE_GATE_MIN_R - (EDGE_HYST if is_f else 0.0)
            min_l = EDGE_GATE_LCB - (EDGE_HYST if is_f else 0.0)
            if est["n"] < EDGE_MIN_N:
                if not EDGE_ALLOW_UNPROVEN:
                    gates.append(f"edge belum terbukti: data efektif {est['n']:.0f} < {EDGE_MIN_N:.0f} "
                                 f"untuk {s['code']} {s['side']}")
            elif est["exp"] < min_r:
                gates.append(f"edge negatif: ekspektasi {est['exp']:+.2f}R (data {est['n']:.0f}) < {min_r:+.2f}R")
            elif est["lcb"] < min_l:
                gates.append(f"edge belum meyakinkan: batas bawah {est['lcb']:+.2f}R < {min_l:+.2f}R")
        tags = list(s["tags"])
        tags.append(f"edge belajar {est['exp']:+.2f}R (data {est['n']:.0f})")
        s.update(gates=gates, tags=tags,
                 rank=round(float(s["rank"]) + EDGE_RANK_W * _c(est["exp"] / 0.3, -1.0, 1.0), 2),
                 eligible=not [g for g in gates if ROOM_HARD or not g.startswith("ruang")])
    setups.sort(key=lambda s: (not s["eligible"], -s["rank"]))


