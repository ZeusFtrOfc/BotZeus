def detect_line_patterns(H, L, C, T, a):
    """Segitiga (asc/desc/sym), wedge (rising/falling), channel (naik/turun), dan rectangle.
    Real price (tidak dicerminkan). Garis atas dan bawah dipasang dari pivot, dengan validasi:
    jumlah sentuhan, kelurusan, porsi close di dalam garis, lebar, dan status breakout/retest.
    Return list berisi paling banyak satu pola (yang cocok dengan garis terbaru)."""
    out = []
    n = len(C)
    if n < 60 or not a > 0:
        return out
    ph, pl = pivots(H, L, PIV)
    lo_i = n - PAT_LINE_MAX_BARS
    phw = [p for p in ph if p[0] >= lo_i]
    plw = [p for p in pl if p[0] >= lo_i]
    if len(phw) < 2 or len(plw) < 2:
        return out
    tol = PAT_LINE_DEV_ATR * a

    def fit(pts):
        """Pakai 4 pivot terakhir; jika tidak lurus, 3; jika tidak lurus, 2. Return (slope, intercept, dev, pivot)."""
        for m in (4, 3, 2):
            if len(pts) < m:
                continue
            seg = pts[-m:]
            xs = np.array([p[0] for p in seg], dtype=float)
            ys = np.array([p[1] for p in seg], dtype=float)
            if m == 2:
                s = (ys[1] - ys[0]) / (xs[1] - xs[0])
                b = ys[0] - s * xs[0]
                dev = 0.0
            else:
                s, b = np.polyfit(xs, ys, 1)
                dev = float(np.max(np.abs(ys - (s * xs + b))))
            if dev <= tol:
                return float(s), float(b), dev, seg
        return None

    fu, fl = fit(phw), fit(plw)
    if fu is None or fl is None:
        return out
    su, bu, du, hs = fu
    sl_, bl, dl, ls = fl
    touches = len(hs) + len(ls)
    if touches < PAT_LINE_MIN_TOUCH:
        return out
    i0 = min(hs[0][0], ls[0][0])
    i_last = max(hs[-1][0], ls[-1][0])
    span = i_last - i0
    if span < PAT_LINE_MIN_BARS or n - 1 - i_last > PAT_LINE_MAX_IDLE:
        return out
    up = lambda i: su * i + bu
    lw = lambda i: sl_ * i + bl
    w0, w_last = up(i0) - lw(i0), up(i_last) - lw(i_last)
    if w0 < 1.0 * a or w_last < 0.1 * a:
        return out
    xs = np.arange(i0, i_last + 1)
    inside = (C[xs] <= up(xs) + 0.3 * a) & (C[xs] >= lw(xs) - 0.3 * a)
    contain = float(inside.mean())
    if contain < PAT_CONTAIN_MIN:
        return out

    ru, rl = su * span / a, sl_ * span / a           # pergeseran tiap garis sepanjang pola (x ATR)
    flat_u, flat_l = abs(ru) <= PAT_FLAT_ATR, abs(rl) <= PAT_FLAT_ATR
    conv = w_last <= 0.75 * w0                       # garis menyempit
    parallel = abs(su - sl_) * span <= 0.6 * a and w_last >= 0.8 * w0
    code = None
    if conv:
        if flat_u and rl > PAT_FLAT_ATR:
            code = "TRI_A"
        elif flat_l and ru < -PAT_FLAT_ATR:
            code = "TRI_D"
        elif ru < -PAT_FLAT_ATR and rl > PAT_FLAT_ATR:
            code = "TRI_S"
        elif ru > PAT_FLAT_ATR and rl > PAT_FLAT_ATR:
            code = "WDG_R"
        elif ru < -PAT_FLAT_ATR and rl < -PAT_FLAT_ATR:
            code = "WDG_F"
    elif flat_u and flat_l and w_last >= 0.8 * w0:
        code = "RECT"
    elif parallel and ru > PAT_FLAT_ATR and rl > PAT_FLAT_ATR:
        code = "CH_U"
    elif parallel and ru < -PAT_FLAT_ATR and rl < -PAT_FLAT_ATR:
        code = "CH_D"
    if code is None:
        return out

    # status: terbentuk (masih di dalam garis), breakout, atau retest garis yang ditembus
    tb = 0.1 * a
    dirn, jb = 0, None
    for j in range(i_last + 1, n):
        if C[j] > up(j) + tb:
            dirn, jb = 1, j
            break
        if C[j] < lw(j) - tb:
            dirn, jb = -1, j
            break
    c = float(C[-1])
    if jb is None:
        status, bias = "terbentuk", LINE_PAT[code][1]
    else:
        if n - 1 - jb > 40:
            return out
        rest = np.arange(jb + 1, n)
        if len(rest):
            if dirn == 1 and (C[rest] < up(rest) - 0.5 * a).any():
                return out                                  # kembali masuk jauh = breakout gagal
            if dirn == -1 and (C[rest] > lw(rest) + 0.5 * a).any():
                return out
        beyond = (c - up(n - 1)) if dirn == 1 else (lw(n - 1) - c)
        status = "retest" if beyond <= 0.35 * a else "breakout"
        bias = "BUY" if dirn == 1 else "SELL"

    # kualitas 0-100
    maxdev = max(du, dl)
    q = min(45.0, 10.0 * touches - 10.0)
    q += 20.0 * max(0.0, 1.0 - maxdev / tol)
    q += 15.0 * max(0.0, min(1.0, (contain - PAT_CONTAIN_MIN) / (1.0 - PAT_CONTAIN_MIN)))
    q += 10.0 * min(1.0, w0 / (2.0 * a))
    q += {"terbentuk": 5.0, "breakout": 10.0, "retest": 10.0}[status]

    now_up, now_lo = float(up(n - 1)), float(lw(n - 1))
    z_lo, z_hi = min(now_lo, now_up), max(now_lo, now_up)
    dist = 0.0 if z_lo <= c <= z_hi else min(abs(c - z_lo), abs(c - z_hi)) / a
    t1, t2 = int(T[i0]), int(T[n - 1])
    geom = [{"k": "line", "t1": t1, "p1": round(float(up(i0)), 2), "t2": t2, "p2": round(now_up, 2), "label": "Pola"},
            {"k": "line", "t1": t1, "p1": round(float(lw(i0)), 2), "t2": t2, "p2": round(now_lo, 2), "label": "Pola"}]
    out.append(dict(code=code, name=LINE_PAT[code][0], bias=bias, status=status, quality=round(q, 1),
                    geom=geom, zone_lo=round(z_lo, 2), zone_hi=round(z_hi, 2), start=t1,
                    dist_atr=round(dist, 2)))
    return out


def detect_reversal_patterns(H, L, C, a, n, T):
    """Double/Triple Bottom dan Inverse H&S di ruang bullish (SELL dicerminkan oleh pemanggil).
    v15.4: mengenali pola yang SEDANG TERBENTUK, mendekati neckline, sudah breakout, atau retest.
    Pola gagal (kembali masuk jauh setelah breakout) dibuang. Quality 0-100.
    Tiap hasil membawa 'ext' = level dasar pola (dipakai pelacak untuk mendeteksi pola batal)."""
    out = []
    if n < 60 or not a > 0:
        return out
    ph, pl = pivots(H, L, PIV)
    tol_p = PAT_TOL_ATR * a
    bonus = {"terbentuk": 10, "mendekati neckline": 15, "breakout": 25, "retest": 25}
    c = float(C[-1])
    done_k = False

    # ---------------- Double / Triple Bottom
    for k in (3, 2):                                          # triple dulu, supaya double tidak menumpang di triple
        if done_k:
            break
        for lows in reversed(list(itertools.combinations(pl[-6:], k))):
            idx, pr = [x[0] for x in lows], [x[1] for x in lows]
            if idx[0] < n - PAT_MAX_BARS:
                continue
            gaps = [idx[i + 1] - idx[i] for i in range(k - 1)]
            if min(gaps) < PAT_MIN_GAP:
                continue
            if max(pr) - min(pr) > tol_p:
                continue
            peaks = []
            for j in range(k - 1):
                seg = [q for q in ph if idx[j] < q[0] < idx[j + 1]]
                if not seg:
                    peaks = None
                    break
                peaks.append(max(seg, key=lambda q: q[1]))
            if not peaks:
                continue
            neck, bottom = max(q[1] for q in peaks), min(pr)
            depth = neck - bottom
            if depth < PAT_MIN_DEPTH_ATR * a:
                continue
            if L[idx[0]:].min() < bottom - 0.3 * a:           # tidak boleh ada low yang lebih rendah setelah pola
                continue
            last = idx[-1]
            after = C[last + 1:]
            if len(after) == 0:
                continue
            hit = np.where(after > neck + 0.1 * a)[0]
            if len(hit):
                jb = last + 1 + int(hit[0])
                if n - 1 - jb > 60:
                    continue
                if C[jb + 1:].size and C[jb + 1:].min() < neck - 0.6 * a:
                    continue                                   # breakout gagal
                status = "retest" if c <= neck + 0.35 * a else "breakout"
            else:
                if n - 1 - last > 50 or c < bottom + PAT_EARLY_FRAC * depth:
                    continue
                status = "mendekati neckline" if c >= neck - 0.35 * a else "terbentuk"
            sym = max(0.0, 1.0 - (max(pr) - min(pr)) / tol_p)
            if k == 3:
                tsym = 1.0 - (max(gaps) - min(gaps)) / max(max(gaps), 1)
            else:
                tsym = min(1.0, gaps[0] / 12.0)
            q = (25.0 * sym + 25.0 * min(depth / (3.0 * a), 1.0) + 15.0 * tsym
                 + (10.0 if k == 3 else 0.0) + bonus[status])
            path = []
            for j in range(k):
                path.append((idx[j], pr[j]))
                if j < k - 1:
                    path.append((peaks[j][0], peaks[j][1]))
            geom = [("line", T[path[m][0]], path[m][1], T[path[m + 1][0]], path[m + 1][1], "Pola")
                    for m in range(len(path) - 1)]
            geom.append(("line", T[idx[-1]], pr[-1], T[n - 1], float(C[-1]), "Pola"))
            geom.append(("line", T[peaks[0][0]], neck, T[n - 1], neck, "Neckline"))
            out.append({"code": "DB" if k == 2 else "TB", "status": status, "quality": round(q, 1),
                        "zl": neck - 0.25 * a, "zh": neck + 0.25 * a, "geom": geom,
                        "ext": float(bottom)})
            done_k = True
            break

    # ---------------- Inverse Head & Shoulders
    for (i1, l1), (i2, hd), (i3, r) in reversed(list(itertools.combinations(pl[-6:], 3))):
        if i1 < n - PAT_MAX_BARS or min(i2 - i1, i3 - i2) < PAT_MIN_GAP:
            continue
        if not (hd < l1 - HS_HEAD_ATR * a and hd < r - HS_HEAD_ATR * a):
            continue
        if abs(l1 - r) > HS_SHOULDER_TOL * a:
            continue
        if L[i1:].min() < hd - 0.3 * a:
            continue
        n1 = [q for q in ph if i1 < q[0] < i2]
        n2 = [q for q in ph if i2 < q[0] < i3]
        if not n1 or not n2:
            continue
        p1, p2 = max(n1, key=lambda q: q[1]), max(n2, key=lambda q: q[1])
        slope = (p2[1] - p1[1]) / (p2[0] - p1[0])
        if abs(slope) * (p2[0] - p1[0]) > 1.5 * a:
            continue
        ly = lambda i, p1=p1, slope=slope: p1[1] + slope * (i - p1[0])
        y = ly(n - 1)
        if y - hd < PAT_MIN_DEPTH_ATR * a:
            continue
        if L[i3:].min() < r - 0.3 * a:
            continue
        if n - 1 - i3 < 1:
            continue
        xs = np.arange(i3 + 1, n)
        yy = p1[1] + slope * (xs - p1[0])
        hit = np.where(C[i3 + 1:n] > yy + 0.1 * a)[0]
        if len(hit):
            jb = i3 + 1 + int(hit[0])
            if n - 1 - jb > 60:
                continue
            rest = np.arange(jb + 1, n)
            if len(rest) and (C[jb + 1:n] < p1[1] + slope * (rest - p1[0]) - 0.6 * a).any():
                continue
            status = "retest" if c <= y + 0.35 * a else "breakout"
        else:
            if n - 1 - i3 > 50 or c < r + PAT_EARLY_FRAC * max(y - r, 0.0):
                continue
            status = "mendekati neckline" if c >= y - 0.35 * a else "terbentuk"
        sym = max(0.0, 1.0 - abs(l1 - r) / (HS_SHOULDER_TOL * a))
        hdp = min((y - hd) / (3.0 * a), 1.0)
        flat = max(0.0, 1.0 - abs(slope) * (p2[0] - p1[0]) / (1.5 * a))
        q = 20.0 * sym + 25.0 * hdp + 10.0 * flat + 20.0 + bonus[status]
        geom = [("line", T[i1], l1, T[p1[0]], p1[1], "Pola"),
                ("line", T[p1[0]], p1[1], T[i2], hd, "Pola"),
                ("line", T[i2], hd, T[p2[0]], p2[1], "Pola"),
                ("line", T[p2[0]], p2[1], T[i3], r, "Pola"),
                ("line", T[i3], r, T[n - 1], float(C[-1]), "Pola"),
                ("line", T[p1[0]], ly(p1[0]), T[n - 1], ly(n - 1), "Neckline")]
        out.append({"code": "IHS", "status": status, "quality": round(q, 1),
                    "zl": y - 0.25 * a, "zh": y + 0.25 * a, "geom": geom,
                    "ext": float(hd)})
        break
    return out

