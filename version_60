def calc_lot(sl_dist, info):
    """Lot. Bot tidak membatasi lot sendiri, hanya mengikuti batas volume broker."""
    step = info.volume_step or 0.01
    vmin = info.volume_min or 0.01
    vmax = min(info.volume_max or MAX_LOT, MAX_LOT)
    if not RISK_PCT:
        return round(max(vmin, min(LOT, vmax)), 2)
    eq = float(cache["account"].get("equity") or 0)
    cur = str(cache["account"].get("currency") or "USD").upper()
    if eq <= 0 or sl_dist <= 0:
        return round(vmin, 2)
    if cur == "IDR":
        eq_usd = eq / USD_IDR
    elif cur == "USD":
        eq_usd = eq
    else:
        return round(max(vmin, min(LOT, vmax)), 2)
    cs = info.trade_contract_size or 100
    raw = (eq_usd * RISK_PCT / 100.0) / (sl_dist * cs)
    lot = math.floor(raw / step + 1e-9) * step
    if lot < vmin:
        lot = vmin
        log(f"INFO: lot dibulatkan ke minimum broker {vmin}")
    return round(min(lot, vmax), 2)

def round_lot(vol, info):
    """Bulatkan lot ke bawah sesuai volume_step broker, lalu batasi ke volume_min..volume_max.
    Dibulatkan ke bawah agar risiko tidak melebihi target."""
    step = float(info.volume_step or 0.01)
    vmin = float(info.volume_min or 0.01)
    vmax = min(float(info.volume_max or MAX_LOT), MAX_LOT)
    if step <= 0:
        step = 0.01
    v = math.floor(float(vol) / step + 1e-9) * step
    if v < vmin:
        v = vmin
    if v > vmax:
        v = vmax
    decimals = max(0, int(round(-math.log10(step))))
    return round(v, decimals)


