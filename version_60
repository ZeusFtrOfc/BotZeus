def log_shadows(cands, bar_t, regime, a):
    now = time.time()
    changed = False
    with dblock:
        sh = db["shadow"]
        for c in cands:
            lvl = round(float(limit_level(c, a)), 3)
            if any((not s.get("done")) and s["code"] == c["code"] and s["side"] == c["side"]
                   and abs(float(s.get("entry", 0)) - lvl) < max(a, 0.5) for s in sh):
                diag("dup_open")
                continue
            sh.append({"code": c["code"], "side": c["side"], "regime": regime, "score": c["score"],
                       "entry": lvl, "sl_dist": round(float(c["sl_d"]), 3),
                       "atr": round(float(a), 3), "open_bar": int(bar_t), "open_ts": now,
                       "pdb": c.get("pdb"), "stb": c.get("stb"), "strength": c.get("strength"),
                       "p": c.get("p"), "tf": c.get("tf"), "prio": c.get("prio"),
                       "fx": c.get("fx"),
                       "done": False, "r": None, "close_time": None, "ver": BOT_VER})
            diag("logged")
            changed = True
        if changed:
            db["shadow"] = [s for s in sh if not s.get("done")] + \
                           [s for s in sh if s.get("done") and s.get("r") is not None][-800:]
            save_db()

def _shadow_fill(s, T, Ll, Hh, spr):
    """Candle pertama SETELAH sinyal yang menyentuh level entry bayangan."""
    buy = s["side"] == "BUY"
    lvl = float(s["entry"])
    for i in np.where(T > s["open_bar"])[0]:
        if buy:
            if Ll[i] + spr <= lvl:
                return int(i), lvl + spr
        elif Hh[i] >= lvl:
            return int(i), lvl
    return None, None


def sim_trail(s, T, Hh, Ll, Cc, spr):
    """Simulasi sinyal bayangan dengan SL tetap + SL+ bertangga (sama dengan bot nyata)."""
    buy = s["side"] == "BUY"
    start, fill_px = _shadow_fill(s, T, Ll, Hh, spr)
    if start is None:
        return None, None
    entry = float(fill_px)
    risk = float(s["sl_dist"])
    sl = entry - risk if buy else entry + risk
    ext = entry
    for i in range(start, len(T)):
        if buy:
            if Ll[i] <= sl:
                return (sl - entry) / risk, int(T[i])
        elif Hh[i] + spr >= sl:
            return (entry - sl) / risk, int(T[i])
        if buy:
            ext = max(ext, float(Hh[i]))
            move = ext - entry
        else:
            ext = min(ext, float(Ll[i]) + spr)
            move = entry - ext
        off = ladder_offset(move, risk)
        if off is not None:
            cand = entry + off if buy else entry - off
            sl = max(sl, cand) if buy else min(sl, cand)
    if len(T) - start >= SHADOW_EXPIRE_BARS:
        last = float(Cc[-1])
        mv = (last - entry) if buy else (entry - last - spr)
        return max(-1.0, mv / risk), int(T[-1])
    return None, None


def resolve_shadows():
    with dblock:
        pend = [s for s in db["shadow"] if not s.get("done")]
    if not pend:
        return
    r = mt5.copy_rates_from_pos(SYMBOL, mt5.TIMEFRAME_M1, 1, 900)
    if r is None or len(r) == 0:
        return
    bars = pd.DataFrame(r)
    T, Hh, Ll, Cc = bars.time.values, bars.high.values, bars.low.values, bars.close.values
    spr = float(state.get("spread") or 0)
    now_ts = time.time()
    changed = False
    with dblock:
        for s in pend:
            res, ct = sim_trail(s, T, Hh, Ll, Cc, spr)
            if res is None:
                age = now_ts - s["open_ts"]
                filled = _shadow_fill(s, T, Ll, Hh, spr)[0] is not None
                if age > SHADOW_MAX_SEC or (not filled and age > SHADOW_PENDING_SEC):
                    s.update(done=True, r=None, close_time=0)
                    changed = True
                continue
            s.update(done=True, r=round(res - SLIPPAGE_USD / s["sl_dist"], 2), close_time=ct)
            changed = True
        if changed:
            save_db()


# ---------------------------------------------------------------- SL+ bertangga
def ladder_offset(profit, risk=None):
    """Profit puncak (dolar) -> offset SL dari open (dolar). Tangga diskalakan dengan jarak SL
    (risk / SL_USD) supaya SL yang lebih lebar tidak mengunci terlalu dini. None jika belum sampai anak tangga pertama."""
    k = (float(risk) / SL_USD) if risk and SL_USD > 0 else 1.0
    k = max(0.5, min(k, 3.0))
    steps = sorted((p * PIP_USD * k, o * PIP_USD * k) for p, o in TRAIL_STEPS)
    if not steps or profit < steps[0][0]:
        return None
    last_p, last_o = steps[-1]
    if profit >= last_p:
        return max(last_o, profit - TRAIL_GAP_PIPS * PIP_USD * k)
    off = steps[0][1]
    for p0, o0 in steps:
        if profit >= p0:
            off = o0
    return off

def peak_favorable(p):
    """Gerak menguntungkan maksimum (dolar) sejak entry. Hanya naik, sehingga SL tidak mundur."""
    buy = p.type == mt5.POSITION_TYPE_BUY
    spr = float(state.get("spread") or 0)
    price = float(p.price_current)
    pk = peak_map.get(p.ticket)
    if pk is None:
        pk = float(p.price_open)
        count = min(max(int(max(0.0, float(state.get("srv") or time.time()) - p.time) / 60) + 5, 3), 5000)
    else:
        count = 3
    r = mt5.copy_rates_from_pos(SYMBOL, mt5.TIMEFRAME_M1, 0, count)
    if r is not None and len(r):
        sel = r["time"] > p.time - (p.time % 60)
        if sel.any():
            pk = max(pk, float(r["high"][sel].max())) if buy else min(pk, float(r["low"][sel].min()) + spr)
    pk = max(pk, price) if buy else min(pk, price)
    peak_map[p.ticket] = pk
    return (pk - p.price_open) if buy else (p.price_open - pk)


