def smart_v17_refine(setups, ctx):
    """v22: gerbang bukti independen adaptif.
    - Area sangat kuat (kekuatan >= V22_STRONG_ST dan P >= V22_STRONG_P) cukup perlu (V17_MIN_GROUPS-1) kelompok
      positif, asalkan tidak ada kelompok yang berlawanan kuat.
    - Dua kelompok atau lebih yang berlawanan kuat = ditolak (bukti saling bertentangan)."""
    if not V17_ON or not setups:
        return
    try:
        smx = build_smart_ctx(ctx)
    except Exception:
        log_exc("build_smart_ctx")
        return
    ctx["smx"] = smx
    cost_usd = float(ctx["spread"]) + SLIPPAGE_USD + FEE_USD
    pmin = V17_MIN_P if V17_MIN_P is not None else (SMART_MIN_P if SMART_MODE else eff_min_p(MIN_P))
    for s in setups:
        try:
            fx, notes = v17_features(s, ctx, smx)
        except Exception:
            log_exc("v17_features")
            continue
        p_new = SMART_MODEL.predict(fx)
        p_old = float(s["pw"])
        pw = min(0.90, max(0.15, V17_MIX * p_new + (1.0 - V17_MIX) * p_old))
        gp = {g: sum(fx[k] for k in ks) / len(ks) for g, ks in V17_GROUPS.items()}
        npos = sum(1 for v in gp.values() if v >= V17_GROUP_POS)
        neg = [g for g, v in gp.items() if v <= V22_GROUP_NEG]
        strong = float(s.get("strength", 0.0)) >= V22_STRONG_ST and pw >= V22_STRONG_P
        need = max(2, V17_MIN_GROUPS - 1) if (strong and not neg) else V17_MIN_GROUPS
        ev = LEARNER.ev_r(pw, cost_usd / max(float(s["sl_d"]), 0.5))
        gates = [g for g in s["gates"] if not g.startswith("probabilitas")]
        if pw < pmin:
            gates.append(f"probabilitas {pw * 100:.0f}% < {pmin * 100:.0f}%")
        if npos < need:
            gates.append(f"bukti independen hanya {npos}/{len(V17_GROUPS)} kelompok (perlu {need})")
        if len(neg) >= 2:
            gates.append(f"bukti saling bertentangan: kelompok {', '.join(neg)} berlawanan kuat")
        if fx["react"] <= V17_VETO_REACT:
            gates.append("riwayat reaksi zona buruk (sering jebol saat disentuh)")
        if fx["appr"] <= V17_VETO_APPR and not s.get("trig"):
            gates.append("harga didorong momentum kuat menuju zona, tunggu melambat atau ada serapan")
        grade = "A+" if (pw >= 0.70 and npos >= 4) else "A" if (pw >= 0.62 and npos >= 3) else "B"
        s["rank"] = round(float(s["rank"]) + RANK_P_W * (pw * 100.0 - float(s["p"]))
                          + V17_RANK_GROUP * (npos - 2) - 2.0 * len(neg), 2)
        s.update(pw=pw, p=round(pw * 100.0, 1), ev=round(ev, 2), gates=gates, fx=fx,
                 smart=dict(p_new=round(p_new, 3), p_old=round(p_old, 3), groups=npos, grade=grade,
                            neg=neg, gp={k: round(v, 2) for k, v in gp.items()}),
                 eligible=not [g for g in gates if ROOM_HARD or not g.startswith("ruang")])
        s["tags"] = list(s["tags"]) + [f"v22 {grade}: model {p_new * 100:.0f}% | {npos} kelompok bukti"
                                       + (f" | berlawanan: {','.join(neg)}" if neg else "")] + notes[:4]
        s["why"] = (s.get("why", "") + f" v22: grade {grade}, model {p_new * 100:.0f}%, "
                    f"{npos} kelompok bukti positif. " + "; ".join(notes[:4]) + ".")


