def focus_guard_bar(P, C, a, strong, st5, st15, hi, lo):
    """Dipanggil tiap candle M1 tutup. Fokus terkomit TIDAK gugur karena CHoCH M5/M1, konsensus, bias, atau
    area penting lain tembus. Hanya: tembus close berturut-turut, area dicabut registry, harga lari setelah
    disentuh, harga sangat jauh, atau komitmen kedaluwarsa."""
    if not P.get("commit"):
        return _focus_guard_bar_v30prev(P, C, a, strong, st5, st15, hi, lo)
    buy = P["side"] == "BUY"
    now = time.time()
    cl = float(C[-1])
    zlo, zhi = float(P["zone_lo"]), float(P["zone_hi"])
    if hi >= zlo and lo <= zhi:
        P["touched"] = True
    beyond = (zlo - cl) if buy else (cl - zhi)
    msg_brk = ("area support tembus ke bawah" if buy else "area resistance tembus ke atas")
    if beyond >= COMMIT_BREAK_DEEP_ATR * a:
        return f"{msg_brk} (satu close M1 menembus dalam)"
    if beyond >= COMMIT_BREAK_ATR * a:
        P["out_n"] = int(P.get("out_n", 0)) + 1
        if P["out_n"] >= COMMIT_BREAK_CLOSES:
            return f"{msg_brk} ({P['out_n']} close M1 berturut-turut di luar)"
    else:
        P["out_n"] = 0
    if _area_by_id(P.get("aid")) is None:
        return "area dicabut dari registry (tembus close TF area atau sudah terpakai)"
    away = ((cl - zhi) if buy else (zlo - cl)) / a
    if P.get("touched") and away > COMMIT_AWAY_ATR:
        return "harga lari meninggalkan area setelah disentuh"
    if away > COMMIT_FAR_RELEASE_ATR:
        return f"harga lari terlalu jauh dari area (> {COMMIT_FAR_RELEASE_ATR:.0f} ATR), komitmen dilepas"
    if (not P.get("touched")) and now - P.get("since", now) > COMMIT_MAX_MIN * 60:
        return f"harga lari: area belum tersentuh dalam {COMMIT_MAX_MIN} menit, komitmen dilepas"
    return None


_live_guard_v30prev = live_guard


def live_guard(tick):
    """Penjagaan live. Fokus terkomit: wick sesaat ditoleransi, tembus live baru dihitung jika dalam dan bertahan."""
    P = PLAN_ACTIVE
    if P is None or not P.get("commit"):
        return _live_guard_v30prev(tick)
    a = float(P["atr"])
    buy = P["side"] == "BUY"
    bid, ask = float(tick.bid), float(tick.ask)
    if (buy and bid <= P["zone_hi"]) or ((not buy) and ask >= P["zone_lo"]):
        P["touched"] = True
    if P.get("exec") or cache["open"] or (PENDING["order"] and PENDING.get("touched")):
        return
    now = time.time()
    if (buy and bid <= P["sl"]) or ((not buy) and ask >= P["sl"]):
        drop_focus(P, "SL tersentuh sebelum order", now)
        return
    beyond = (P["zone_lo"] - bid) if buy else (ask - P["zone_hi"])
    if beyond >= COMMIT_LIVE_BREAK_ATR * a:
        if not P.get("brk_t"):
            P["brk_t"] = now
        elif now - P["brk_t"] >= COMMIT_LIVE_BREAK_SEC:
            drop_focus(P, ("area support tembus ke bawah" if buy else "area resistance tembus ke atas")
                       + f" (live, bertahan {COMMIT_LIVE_BREAK_SEC} detik)", now)
    else:
        P["brk_t"] = 0.0


_match_focus_v30prev = match_focus


def match_focus(P, setups, a):
    """Fokus terkomit selalu 'valid': semua gerbang lunak/momentum dibuang, hanya COMMIT_HARD_GATES yang dibawa.
    Jika detektor sesaat tidak melihat area, datanya diambil dari registry. P dijaga >= COMMIT_P_FLOOR."""
    m = _match_focus_v30prev(P, setups, a)
    if P is None or not P.get("commit"):
        return m
    x = _area_by_id(P.get("aid"))
    if m is not None:
        base = dict(m)
    elif x is not None and x.get("setup") is not None:
        base = dict(x["setup"])
    else:
        base = dict(P)
    hard = [g for g in (base.get("gates") or []) if g.startswith(COMMIT_HARD_GATES)]
    p_now = max(float(base.get("p", 0.0)), COMMIT_P_FLOOR)
    base.update(gates=hard, eligible=not hard, room_ok=True, p=round(p_now, 1), pw=round(p_now / 100.0, 4))
    if x is not None:
        base["strength"] = max(float(base.get("strength", 0.0)), round(float(x.get("ss", 0.0)), 1))
        P["cv"], P["tier"] = round(float(x.get("cv", 0.0)), 1), x.get("tier", "-")
    return base


