def _edge_estimate_v22(self, s):
    est = _edge_estimate_v21(self, s)
    try:
        pn = (s.get("smart") or {}).get("p_new")
        if pn is not None and SMART_MODEL.n >= V17_FIT_MIN_N:
            em = float(pn) * float(LEARNER.aw) + (1.0 - float(pn)) * float(LEARNER.al)
            new = (1.0 - V22_EDGE_MODEL_W) * est["exp"] + V22_EDGE_MODEL_W * em
            d = new - est["exp"]
            est = dict(est, exp=new, lcb=est["lcb"] + d)
            s["exp_model"] = round(em, 3)
    except Exception:
        log_exc("edge_estimate_v22")
    return est


