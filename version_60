    s.update(zone_lo=x["zone_lo"], zone_hi=x["zone_hi"], p=round(p_now, 1), pw=round(p_now / 100.0, 4),
             strength=round(x["ss"], 1), eligible=True, gates=[], room_ok=True,
             dist_atr=round(max(0.0, dist) / a, 1), sniper=True, aid=x["aid"],
             cv=round(float(x.get("cv", 0.0)), 1), tier=x.get("tier", "-"))
    return s


