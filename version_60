    AREA_PEND[:] = [q for q in AREA_PEND if now - q["t"] < 180][-60:]
    AREA_DIAG["t_upd"] = now
    AREA_DIAG["n"] = len(setups)
    AREA_DIAG["buy"] = sum(1 for s in setups if s["side"] == "BUY")
    AREA_DIAG["sell"] = len(setups) - AREA_DIAG["buy"]
    top = []
    for s in setups:
        side, code = s["side"], s["code"]
        lo, hi = float(s["zone_lo"]), float(s["zone_hi"])
        stg, pp = float(s.get("strength", 0.0)), float(s["p"])
        mq = _mark_q(stg, pp)
        top.append((mq, s))
        x = next((q for q in AREA_REG if _same_zone(q, side, code, lo, hi, a)), None)
        if x is None:
            if stg < MARK_MIN_STRENGTH or pp < MARK_FLOOR_P or mq < MARK_ENTER_Q:
                AREA_DIAG["rej_q"] += 1
                continue
            if not _birth_ok(s, a, bar, now):
                AREA_DIAG["rej_birth"] += 1
                continue
            AREA_SEQ["n"] += 1
            AREA_DIAG["new"] += 1
            x = dict(aid=f"{side[0]}{code}{round(lo * 100)}", seq=AREA_SEQ["n"], side=side, code=code,
                     tf=_area_tf(s), name=s["name"], zone_lo=round(lo, 2), zone_hi=round(hi, 2),
                     born=now, last_seen=now, elig_t=0.0, touches=0, ps=pp, ss=stg,
                     chk_t=0, chk1=0, in_touch=False, setup=None, shown=False, hidden=True,
                     q=0.0, dist_atr=float(s.get("dist_atr", 0.0)))
            AREA_REG.append(x)
        else:
            al = 1.0 - math.exp(-max(0.0, now - x["last_seen"]) / AREA_P_TAU)
            x["ps"] += al * (pp - x["ps"])
            x["ss"] += al * (stg - x["ss"])
            x["last_seen"] = now
            x["name"] = s["name"]
            tf = _area_tf(s)
            if TF_RANK.get(tf, 0) > TF_RANK.get(x["tf"], 0):
                x["tf"] = tf
        zlo, zhi = x["zone_lo"], x["zone_hi"]
        ent = zhi if side == "BUY" else zlo
        slp, _sld, _ok = structural_sl(side, zlo, zhi, ent, float(s.get("atr") or a))
        s.update(zone_lo=zlo, zone_hi=zhi, entry=round(ent, 2), sl=round(slp, 2), id=x["aid"])
        x["setup"] = s
        if s["eligible"]:
            x["elig_t"] = now
    top.sort(key=lambda t: -t[0])
    AREA_DIAG["top"] = [(round(mq, 1), s["side"], s["code"], s.get("tf"), s["zone_lo"], s["zone_hi"],
                         s["p"], round(float(s.get("strength", 0.0)), 0), s.get("dist_atr"),
                         ";".join(s["gates"])[:90]) for mq, s in top[:5]]


def registry_diag(ctx, now):
    """Ringkasan tiap 30 detik: di tahap mana area tertahan."""
    if now - AREA_DIAG["t"] < 30:
        return
    AREA_DIAG["t"] = now
    a = float(ctx["a"])
    atr_ok = ATR_MIN <= a <= ATR_MAX
    shown = [x for x in AREA_REG if x.get("shown")]
    stale = now - AREA_DIAG["t_upd"] > 5
    log(f"[AREA-DIAG] ATR M1 {a:.2f} ({'OK' if atr_ok else f'DI LUAR {ATR_MIN}-{ATR_MAX}, tidak ada setup'}) | "
        f"pemindaian: {scan_text()} | setup {AREA_DIAG['n']} (BUY {AREA_DIAG['buy']}, SELL {AREA_DIAG['sell']})"
        f"{' [penilaian tidak berjalan]' if stale else ''} | ditolak kualitas {AREA_DIAG['rej_q']}, "
        f"ditolak lahir {AREA_DIAG['rej_birth']}, lahir baru {AREA_DIAG['new']} | "
        f"registry {len(AREA_REG)}, tampil {len(shown)}")
    for t in AREA_DIAG["top"]:
        log(f"[AREA-DIAG] teratas q {t[0]}: {t[1]} {t[2]} [{t[3]}] {t[4]}-{t[5]} P {t[6]}% kuat {t[7]:.0f} "
            f"jarak {t[8]} ATR | gerbang: {t[9] or '-'}")
    AREA_DIAG.update(rej_q=0, rej_birth=0, new=0)


def registry_maintain(ctx, now, new_bar):
    """v24.1: sama seperti v24, tetapi tampil/sembunyi memakai kualitas gabungan (bukan P saja)
    dan memanggil registry_diag."""
    a = float(ctx["a"])
    px = float(ctx["m1"].close.iloc[-1])
    if new_bar:
        for x in list(AREA_REG):
            try:
                why = _area_check(x, ctx)
            except Exception:
                log_exc("area_check")
                why = None
            if why:
                AREA_REG.remove(x)
                BROKEN.append({"side": x["side"], "zone_lo": x["zone_lo"], "zone_hi": x["zone_hi"],
                               "until": now + BROKEN_BLOCK_MIN * 60})
                log(f"[AREA] TEMBUS {x['side']} {x['name']} [{x['tf']}] {x['zone_lo']}-{x['zone_hi']}: {why}")
    for x in list(AREA_REG):
        miss = now - x["last_seen"]
        consumed = (x["touches"] > 0 and x["code"] in ("BR", "RBS", "SBR", "OB", "SD", "PL")
                    and miss > AREA_CONSUMED_SEC)
        if miss > AREA_GRACE_SEC.get(x["tf"], 600) or consumed:
            AREA_REG.remove(x)
            log(f"[AREA] HILANG {x['side']} {x['name']} [{x['tf']}] {x['zone_lo']}-{x['zone_hi']}: "
                f"{'sudah terpakai (disentuh lalu hilang)' if consumed else 'tidak terdeteksi lagi'}")
    for x in AREA_REG:
        buy = x["side"] == "BUY"
        x["dist_atr"] = max(0.0, (px - x["zone_hi"]) if buy else (x["zone_lo"] - px)) / a
        x["q"] = _area_q(x)
    AREA_REG.sort(key=lambda q: -q["q"])
    del AREA_REG[60:]
    kept, cnt, gap = [], {}, MARK_CLUSTER_ATR * a
    for x in AREA_REG:
        show = x["setup"] is not None
        thr = MARK_KEEP_Q if x.get("shown") else MARK_ENTER_Q
        if _mark_q(x["ss"], x["ps"]) < thr:
            show = False
        if x["dist_atr"] > AREA_VIEW_MAX_ATR.get(x["tf"], 20.0):
            show = False
        if show and any(k["side"] == x["side"] and _gap(k, x) <= gap for k in kept):
            show = False
        key = (x["tf"], x["side"])
        if show and cnt.get(key, 0) >= AREA_MAX_PER_TF_SIDE:
            show = False
        if show:
            kept.append(x)
            cnt[key] = cnt.get(key, 0) + 1
            if not x.get("logged"):
                x["logged"] = True
                log(f"[AREA] DITANDAI {x['side']} {x['name']} [{x['tf']}] {x['zone_lo']}-{x['zone_hi']} "
                    f"P {x['ps']:.0f}% kuat {x['ss']:.0f} jarak {x['dist_atr']:.1f} ATR")
        x["shown"], x["hidden"] = show, not show
    try:
        registry_diag(ctx, now)
    except Exception:
        log_exc("registry_diag")
        
