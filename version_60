# ---------------------------------------------------------------- 1) util pola
def _lk_flat(Lk, a_tf):
    """(garis_atas_datar, garis_bawah_datar). Datar = bergeser <= max(PAT_FLAT_ATR x ATR, 22% tinggi pola)."""
    u, l = Lk.get("up"), Lk.get("lo")
    if not u or not l:
        return False, False
    h = abs(float(u["p1"]) - float(l["p1"]))
    thr = max(PAT_FLAT_ATR * a_tf, 0.22 * h)
    return (abs(float(u["p2"]) - float(u["p1"])) <= thr,
            abs(float(l["p2"]) - float(l["p1"])) <= thr)


def _a_of(ctx, tf):
    a_tf = next((float(x["a"]) for x in ctx["tfs"] if x["name"] == tf), float(ctx["a"]))
    return a_tf if a_tf > 0 else float(ctx["a"])


def range_edge_at(side, zlo, zhi, ctx):
    """Teks jika zona tepat di batas range (garis datar / channel / rectangle) pola terkunci yang belum breakout.
    BUY: batas bawah. SELL: batas atas. Selain itu None."""
    buy = side == "BUY"
    mid = (float(zlo) + float(zhi)) / 2.0
    t_now = int(ctx["T"][-1]) + 60
    for tf, Lk in list(PAT_LOCK.items()):
        if Lk.get("dir") != 0 or Lk.get("kind") != "lines" or float(Lk.get("quality", 0)) < PAT_MIN_Q:
            continue
        a_tf = _a_of(ctx, tf)
        u, l = _line_at(Lk["up"], t_now), _line_at(Lk["lo"], t_now)
        if u <= l:
            continue
        fu, fl = _lk_flat(Lk, a_tf)
        edge, flat = (l, fl) if buy else (u, fu)
        if (flat or Lk.get("code") in BOUNCE_CODES) and abs(mid - edge) <= BOUNCE_ATR * a_tf:
            return f"{'batas bawah' if buy else 'batas atas'} {Lk['name']} [{tf}]"
    return None


# ---------------------------------------------------------------- 2) pattern_against baru
def pattern_against(s, ctx):
    """v29: tolak entry yang melawan pola terkunci, KECUALI:
    - pantulan di tepi datar pola (SELL di garis atas datar / BUY di garis bawah datar) atau di channel/rectangle,
    - penolakan di neckline oleh area kuat,
    - pola M1 yang belum breakout tidak mem-veto area berjangkar M5/M15 yang kuat.
    Pola yang sudah breakout tetap mem-veto sisi lawan."""
    if not PAT_AGAINST_ON:
        return None
    side = s["side"]
    buy = side == "BUY"
    mid = (float(s["zone_lo"]) + float(s["zone_hi"])) / 2.0
    t_now = int(ctx["T"][-1]) + 60
    strength = float(s.get("strength", 0.0))
    anchored = bool(s.get("anchored"))
    for tf, Lk in list(PAT_LOCK.items()):
        if float(Lk.get("quality", 0)) < PAT_AGAINST_MIN_Q:
            continue
        bias = Lk.get("bias")
        if bias not in ("BUY", "SELL") or bias == side:
            continue
        a_tf = _a_of(ctx, tf)
        nm = Lk["name"]
        if Lk["dir"] != 0:
            return f"melawan breakout {nm} [{tf}] ke arah {bias}"
        if tf == "M1" and anchored and strength >= PAT_M1_YIELD_ST:
            continue
        if Lk["kind"] == "lines":
            u, l = _line_at(Lk["up"], t_now), _line_at(Lk["lo"], t_now)
            fu, fl = _lk_flat(Lk, a_tf)
            if strength >= BOUNCE_MIN_STRENGTH:
                edge, flat = (l, fl) if buy else (u, fu)
                if abs(mid - edge) <= BOUNCE_ATR * a_tf and (Lk.get("code") in BOUNCE_CODES or flat):
                    continue
            if buy and mid > l - PAT_ESCAPE_ATR * a_tf:
                return f"BUY melawan pola {nm} [{tf}] berbias SELL, cari area SELL di garis atas pola"
            if (not buy) and mid < u + PAT_ESCAPE_ATR * a_tf:
                return f"SELL melawan pola {nm} [{tf}] berbias BUY, cari area BUY di garis bawah pola"
        else:
            ext = Lk.get("ext")
            if ext is None:
                continue
            nk = _line_at(Lk["neck"], t_now)
            if bias == "BUY" and (not buy) and ext - 0.2 * a_tf <= mid <= nk + 0.5 * a_tf:
                at_neck = mid >= nk - NECK_REJECT_ATR * a_tf
                if not (at_neck and strength >= NECK_REJECT_MIN_STRENGTH):
                    return f"SELL melawan pola {nm} [{tf}] berbias BUY (di tengah pola, bukan di neckline)"
            if bias == "SELL" and buy and nk - 0.5 * a_tf <= mid <= ext + 0.2 * a_tf:
                at_neck = mid <= nk + NECK_REJECT_ATR * a_tf
                if not (at_neck and strength >= NECK_REJECT_MIN_STRENGTH):
                    return f"BUY melawan pola {nm} [{tf}] berbias SELL (di tengah pola, bukan di neckline)"
    return None


# ---------------------------------------------------------------- 3) konsensus sadar lokasi
def cons_relief(s, ctx, edge_txt=None):
    """Relief (0..CONS_RELIEF_CAP) untuk gerbang konsensus. Return (relief, daftar_alasan)."""
    st = float(s.get("strength", 0.0))
    if st < CONS_RELIEF_MIN_ST:
        return 0.0, []
    side = s["side"]
    zlo, zhi = float(s["zone_lo"]), float(s["zone_hi"])
    mid = (zlo + zhi) / 2.0
    rel, parts = 0.0, []
    if ctx.get("t60") == side:
        rel += CONS_RELIEF_H1
        parts.append("H1 searah")
    e = float(s.get("pdx", 0.5))
    if e >= 0.75:
        rel += CONS_RELIEF_EXTREME
        parts.append(f"area ekstrem range ({e * 100:.0f}%)")
    own = float(s.get("rev_own", 0.0))
    if own >= 0.25:
        rel += CONS_RELIEF_REV
        parts.append(f"bukti pembalikan searah {own * 100:.0f}%")
    if edge_txt:
        rel += CONS_RELIEF_RANGE
        parts.append(edge_txt)
    for tf, Lk in list(PAT_LOCK.items()):
        if Lk.get("bias") != side or Lk.get("dir") != 0:
            continue
        if float(Lk.get("quality", 0)) < PAT_AGAINST_MIN_Q:
            continue
        ext = Lk.get("ext")
        if ext is None:
            continue
        a_tf = _a_of(ctx, tf)
        if abs(mid - float(ext)) <= 0.8 * a_tf + (zhi - zlo):
            rel += CONS_RELIEF_PAT
            parts.append(f"{Lk['name']} [{tf}] searah")
            break
    return min(rel, CONS_RELIEF_CAP), parts


def v29_cons_adjust(setups, ctx):
    """Dipanggil tepat sebelum registry_update (setelah semua gerbang lama).
    Mengganti gerbang 'melawan konsensus' dengan versi sadar lokasi, menambah bonus area batas range,
    dan memberi histeresis untuk fokus yang sudah terkunci."""
    if not setups:
        return
    a = float(ctx["a"])
    P = PLAN_ACTIVE
    for s in setups:
        try:
            align = float(s.get("align", 0.0))
            gates = [g for g in s["gates"] if not g.startswith("melawan konsensus")]
            had = len(gates) != len(s["gates"])
            edge_txt = range_edge_at(s["side"], float(s["zone_lo"]), float(s["zone_hi"]), ctx)
            rel, parts = (0.0, [])
            if CONS_RELIEF_ON and CONS_ON and (align < 0 or had):
                rel, parts = cons_relief(s, ctx, edge_txt)
            boost = RANGE_EDGE_P if (edge_txt and float(s.get("strength", 0.0)) >= CONS_RELIEF_MIN_ST) else 0.0
            if not had and rel <= 0 and boost <= 0:
                continue
            adj = align + rel
            if CONS_ON and (had or rel > 0):
                is_f = P is not None and is_focus_candidate(P, s, a)
                thr = CONS_GATE + (CONS_FOCUS_HYST if is_f else 0.0)
                if align <= CONS_HARD_FLOOR or adj <= -thr:
                    gates.append(f"melawan konsensus MTF {align:+.2f}"
                                 + (f" (relief {rel:+.2f} belum cukup)" if rel > 0 else ""))
            tags = list(s["tags"])
            if rel > 0:
                s["align_raw"] = round(align, 2)
                s["align"] = round(adj, 2)
                tags.append(f"relief konsensus {rel:+.2f} ({', '.join(parts[:3])})")
            if boost > 0:
                tags.append(f"area di {edge_txt} (+{boost * 100:.0f}% P)")
            dp = CONS_P * rel + boost
            pw = min(0.92, max(0.15, float(s["pw"]) + dp))
            s.update(pw=pw, p=round(pw * 100.0, 1), gates=gates, tags=tags,
                     rank=round(float(s["rank"]) + CONS_RANK * rel + (RANGE_EDGE_RANK if boost > 0 else 0.0), 2),
                     eligible=not [g for g in gates if ROOM_HARD or not g.startswith("ruang")])
        except Exception:
            log_exc("v29_cons_adjust")


