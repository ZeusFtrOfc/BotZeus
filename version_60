def _assign_episodes(sh):
    """Kelompokkan bayangan yang kode, arah, dan levelnya sama dalam EPISODE_GAP_SEC sebagai satu episode.
    Mengisi s['_ep'] dan s['_epn'] (ukuran episode). Return jumlah episode."""
    sh.sort(key=lambda s: int(s.get("open_bar") or 0))
    live, cnt, nid = {}, {}, 0
    for s in sh:
        k = (s.get("code"), s.get("side"))
        ob = int(s.get("open_bar") or 0)
        ent = float(s.get("entry") or 0.0)
        a = max(float(s.get("atr") or 1.0), 0.8)
        lst = [e for e in live.get(k, []) if ob - e[1] <= EPISODE_GAP_SEC]
        hit = next((e for e in lst if abs(e[0] - ent) <= 1.2 * a), None)
        if hit is None:
            nid += 1
            hit = [ent, ob, nid]
            lst.append(hit)
        else:
            hit[1] = ob
        live[k] = lst
        s["_ep"] = hit[2]
        cnt[hit[2]] = cnt.get(hit[2], 0) + 1
    for s in sh:
        s["_epn"] = cnt[s["_ep"]]
    return len(cnt)


