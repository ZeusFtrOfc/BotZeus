REV_LOC_AT_ZONE_ATR = 1.0       # ekstrem pola dalam jarak ini dari zona = bobot penuh
REV_LOC_FAR_W = 0.35            # bobot minimal pola yang jauh dari zona
REV_PROX_NEAR_ATR = 1.0         # kandidat sedekat ini dari harga = veto penuh
REV_PROX_FAR_ATR = 3.5          # kandidat sejauh ini = veto diperkecil ke REV_PROX_MIN_W
REV_PROX_MIN_W = 0.25
V22_GROUP_NEG = -0.35           # rata-rata fitur kelompok <= ini = berlawanan kuat
V22_STRONG_ST = 78.0            # area sangat kuat: kekuatan minimal
V22_STRONG_P = 0.58             # ...dan probabilitas minimal
V22_EDGE_MODEL_W = 0.40         # bobot prediksi model fitur di ekspektasi R
V22_LOG_CHARS = 420


def _rev_prox(dist_atr):
    """Bobot veto menurut jarak kandidat ke harga (1.0 dekat, mengecil jika jauh)."""
    if dist_atr <= REV_PROX_NEAR_ATR:
        return 1.0
    f = (dist_atr - REV_PROX_NEAR_ATR) / max(REV_PROX_FAR_ATR - REV_PROX_NEAR_ATR, 1e-6)
    return max(REV_PROX_MIN_W, 1.0 - min(1.0, f) * (1.0 - REV_PROX_MIN_W))


def rev_all(ctx):
    """v22: sama seperti v19, tetapi tiap bukti membawa 'px' (harga ekstrem pola, ruang nyata)
    supaya bisa dinilai terhadap lokasi zona kandidat."""
    m5 = next((tf for tf in ctx["tfs"] if tf["name"] == "M5"), None)
    if m5 is None:
        return REV_CACHE["v"]
    key = (int(ctx["T"][-1]), int(m5["df"].time.values[-1]))
    if REV_CACHE["k"] == key and REV_CACHE["v"] is not None:
        return REV_CACHE["v"]
    zones = ctx.get("strong") or []
    res = {"BUY": [], "SELL": []}
    for side in ("BUY", "SELL"):
        buy = side == "BUY"
        sg = 1 if buy else -1
        best = {}
        for nm, df, a_tf, mult, max_age in (
                ("M1", ctx["m1"], float(ctx["a"]), 1.0, REV_MAX_AGE_M1),
                ("M5", m5["df"], float(m5["a"]), REV_M5_MULT, REV_MAX_AGE_M5)):
            if not a_tf > 0:
                continue
            for pt in _rev_patterns(df, buy, a_tf, max_age):
                real_ext = sg * pt["low"]
                at_zone = any(z["st"] >= REV_ZONE_MIN_ST and z["lo"] - 0.4 * a_tf <= real_ext <= z["hi"] + 0.4 * a_tf
                              for z in zones)
                dec = 1.0 - 0.7 * pt["age"] / (max_age + 1)
                e = min(0.9, pt["w"] * mult * dec * (1.0 if at_zone else REV_NOZONE_MULT))
                it = dict(tf=nm, kind=pt["kind"], e=e, tc=pt["t"] + TF_SEC[nm],
                          txt=f"{rev_text(pt['txt'], buy)} {nm}" + (" di area kuat" if at_zone else ""),
                          px=float(real_ext), a=float(a_tf))
                k2 = (nm, pt["kind"])
                if k2 not in best or it["e"] > best[k2]["e"]:
                    best[k2] = it
        res[side] = list(best.values())
    REV_CACHE["k"], REV_CACHE["v"] = key, res
    return res


def rev_for_zone(side, zlo, zhi, a):
    """Bukti pembalikan untuk SATU zona kandidat, dibobot lokasi.
    Pola yang ekstremnya di/dekat zona = bobot penuh (zona sedang ditolak atau diserap).
    Pola yang jauh dari zona (mis. pantulan di support jauh di bawah SELL zone) = hanya info momentum.
    Return (own, own_alasan, opp, opp_alasan)."""
    if not REV_ON or not LAST_CTX or not a > 0:
        return 0.0, [], 0.0, []
    try:
        data = rev_all(LAST_CTX)
    except Exception:
        log_exc("rev_all")
        return 0.0, [], 0.0, []
    if not data:
        return 0.0, [], 0.0, []
    opp_side = "SELL" if side == "BUY" else "BUY"
    own_l, opp_l = [], []
    for sd, lst in ((side, own_l), (opp_side, opp_l)):
        for x in data.get(sd, []):
            px = x.get("px")
            if px is None:
                w = 0.6
            else:
                gap = max(zlo - px, px - zhi, 0.0) / a
                w = 1.0 if gap <= REV_LOC_AT_ZONE_ATR else max(
                    REV_LOC_FAR_W, 1.0 - 0.2 * (gap - REV_LOC_AT_ZONE_ATR))
            e = x["e"] * w
            if e >= 0.02:
                lst.append((e, x["txt"] + ("" if w >= 0.99 else f" (jauh dari zona, bobot {w:.2f})")))
    now = srv_now()
    for tr in TRAPS:
        age = now - tr["t"]
        if age > TRAP_LIFE:
            continue
        e = 0.7 * TRAP_W * REV_TRAP_TF.get(tr["tf"], 0.8) * min(1.0, tr["q"] / 100.0) * (1.0 - age / TRAP_LIFE)
        if e < 0.02:
            continue
        item = (e, f"jebakan {tr['name']} {tr['tf']} (breakout gagal)")
        if tr["bias"] == side:
            own_l.append(item)
        elif tr["bias"] == opp_side:
            opp_l.append(item)

    def comb(lst):
        prod = 1.0
        for e, _ in lst:
            prod *= (1.0 - e)
        return float(1.0 - prod), [t for _, t in sorted(lst, reverse=True)[:4]]

    o, ow = comb(own_l)
    p, pw_ = comb(opp_l)
    return o, ow, p, pw_


def apply_reversal(setups, ctx):
    """v22: bukti pembalikan dinilai per zona (lokasi) dan veto diperkecil jika zona masih jauh dari harga."""
    if not REV_ON or not setups:
        return
    try:
        rev_all(ctx)
    except Exception:
        log_exc("rev_all")
        return
    a = float(ctx["a"])
    ev = {sd: rev_score(sd) for sd in ("BUY", "SELL")}
    _log_rev(ev)
    ctx["rev"] = {sd: round(v[0], 2) for sd, v in ev.items()}
    cost_usd = float(ctx["spread"]) + SLIPPAGE_USD + FEE_USD
    pmin = V17_MIN_P if V17_MIN_P is not None else (SMART_MODE and SMART_MIN_P or eff_min_p(MIN_P))
    for s in setups:
        side = s["side"]
        opp_side = "SELL" if side == "BUY" else "BUY"
        own, ownw, opp_raw, oppw = rev_for_zone(side, float(s["zone_lo"]), float(s["zone_hi"]), a)
        prox = _rev_prox(float(s.get("dist_atr", 0.0)))
        opp = opp_raw * prox
        s["rev_own"], s["rev_opp"] = round(own, 2), round(opp, 2)
        if own < 0.05 and opp < 0.05:
            continue
        pw = min(0.92, max(0.15, float(s["pw"]) + REV_P_OWN * own - REV_P_OPP * opp))
        e = LEARNER.ev_r(pw, cost_usd / max(float(s["sl_d"]), 0.5))
        gates = [g for g in s["gates"] if not g.startswith("probabilitas")]
        if pw < pmin:
            gates.append(f"probabilitas {pw * 100:.0f}% < {pmin * 100:.0f}%")
        thr = rev_veto_thr(side)
        if opp >= thr:
            gates.append(f"tanda pembalikan {opp_side} kuat di zona ({opp * 100:.0f}% >= {thr * 100:.0f}%): "
                         + ", ".join(oppw[:3]))
        room = float(s["rr"]) * float(s["sl_d"])
        if (opp >= REV_ROOM_STRICT and opp > own + 0.05
                and room < MIN_RR * float(s["sl_d"])
                and not any(g.startswith("ruang sempit") for g in gates)):
            gates.append(f"ruang sempit: {s['rr']:.1f}R < {MIN_RR}R (ada tanda pembalikan {opp_side})")
            s["room_ok"] = False
        tags = list(s["tags"])
        if own >= 0.15:
            tags.append(f"bukti pembalikan searah di zona {own * 100:.0f}%: {', '.join(ownw[:2])}")
        if opp >= 0.15:
            tags.append(f"bukti pembalikan LAWAN di zona {opp * 100:.0f}% (bobot jarak {prox:.2f}): "
                        f"{', '.join(oppw[:2])}")
        s.update(pw=pw, p=round(pw * 100.0, 1), ev=round(e, 2), gates=gates, tags=tags,
                 rank=round(float(s["rank"]) + REV_RANK * (own - opp), 2),
                 eligible=not [g for g in gates if ROOM_HARD or not g.startswith("ruang")])
    setups.sort(key=lambda s: (not s["eligible"], -s["rank"]))


def pending_validity_check(tick):
    """v22: batalkan limit hanya jika bukti pembalikan lawan DI ZONA kuat (dibobot jarak),
    atau fokus tidak lolos lagi selama LIMIT_INVALID_SEC. Saat limit sudah disentuh, penjaga limit yang memutuskan."""
    ticket = PENDING["order"]
    P = PLAN_ACTIVE
    if not ticket or P is None or P.get("id") != PENDING.get("plan"):
        return False
    if PENDING.get("touched") or not mt5.orders_get(ticket=ticket):
        return False
    side = P["side"]
    opp_side = "SELL" if side == "BUY" else "BUY"
    buy = side == "BUY"
    a = float(P["atr"])
    now = time.time()
    lvl = float(PENDING["entry"])
    px = float(tick.ask if buy else tick.bid)
    dist_atr = max(0.0, ((px - lvl) if buy else (lvl - px)) / a)
    _, _, opp_raw, rw = rev_for_zone(side, float(P["zone_lo"]), float(P["zone_hi"]), a)
    ev = opp_raw * _rev_prox(dist_atr)
    why = None
    if ev >= rev_veto_thr(side):
        why = f"tanda pembalikan {opp_side} di zona {ev * 100:.0f}% ({', '.join(rw[:3])})"
    else:
        pmin = (V17_MIN_P if V17_MIN_P is not None else SMART_MIN_P) * 100.0 - LIMIT_P_TOL
        bad = float(P.get("p", 100.0)) < pmin or P.get("eligible") is False
        if bad:
            if PEND_BAD["id"] != ticket:
                PEND_BAD.update(id=ticket, t=now)
            if now - PEND_BAD["t"] >= LIMIT_INVALID_SEC:
                why = f"fokus tidak lolos lagi (P {P.get('p')}%): " + "; ".join((P.get("gates") or [])[:2])
        else:
            PEND_BAD.update(id=None, t=0.0)
    if why:
        return cancel_pending("limit dibatalkan: " + why, force=True, block=False)
    return False


