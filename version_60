LINE_PAT["FLAG_B"] = ("Bull Flag", "BUY")
LINE_PAT["FLAG_S"] = ("Bear Flag", "SELL")
FLAG_MAX_BARS, FLAG_MIN_BARS = 30, 5
FLAG_POLE_ATR, FLAG_POLE_BARS = 2.5, 14
FLAG_MAX_RETR, FLAG_TOL_ATR = 0.55, 0.35
RECT_MAX_BARS, RECT_TOL_ATR = 110, 0.40
RECT_MIN_H, RECT_MAX_H = 1.2, 5.0
RECT_MIN_SPAN, RECT_MAX_IDLE = 14, 30


def _flag_side(H, L, C, T, a, sg):
    """Bull flag (sg=1) / bear flag (sg=-1, dicerminkan). Tiang impuls + konsolidasi miring melawan tiang."""
    n = len(C)
    if n < 60 or not a > 0:
        return None
    h, l, c = (H, L, C) if sg == 1 else (-L, -H, -C)
    ph, pl = pivots(h, l, 2)
    for e, top in reversed(ph):
        m = n - 1 - e
        if m < FLAG_MIN_BARS:
            continue
        if m > FLAG_MAX_BARS:
            break
        base = float(l[max(0, e - FLAG_POLE_BARS):e].min())
        rise = float(top) - base
        if rise < FLAG_POLE_ATR * a:
            continue
        if float(h[e + 1:].max()) > top + 0.3 * a:
            continue
        low_c = float(l[e + 1:].min())
        if low_c < top - FLAG_MAX_RETR * rise:
            continue
        hs = [(e, float(top))] + [p for p in ph if p[0] > e]
        ls = [p for p in pl if p[0] > e]
        if len(hs) < 2 or len(ls) < 2:
            continue
        xh = np.array([p[0] for p in hs], float)
        yh = np.array([p[1] for p in hs], float)
        xl = np.array([p[0] for p in ls], float)
        yl = np.array([p[1] for p in ls], float)
        try:
            su, bu = np.polyfit(xh, yh, 1)
            sl_, bl = np.polyfit(xl, yl, 1)
        except Exception:
            continue
        tol = FLAG_TOL_ATR * a
        if np.max(np.abs(yh - (su * xh + bu))) > tol or np.max(np.abs(yl - (sl_ * xl + bl))) > tol:
            continue
        if su > 0.03 * a or sl_ > 0.03 * a:                 # flag miring turun/datar (melawan tiang)
            continue
        up = lambda i: su * i + bu
        lw = lambda i: sl_ * i + bl
        w0, w1 = up(e) - lw(e), up(n - 1) - lw(n - 1)
        if w0 < 0.6 * a or w0 > 3.2 * a or w1 < 0.3 * a:
            continue
        if abs(su - sl_) * m > 0.9 * a:                      # garis relatif sejajar
            continue
        xs = np.arange(e + 1, n)
        inside = (c[e + 1:] <= up(xs) + 0.3 * a) & (c[e + 1:] >= lw(xs) - 0.3 * a)
        contain = float(inside.mean())
        if contain < 0.88 or c[-1] > up(n - 1) + 0.1 * a:
            continue
        retr = (float(top) - low_c) / rise
        q = (50 + 18 * min(rise / (4 * a), 1.0) + 14 * (contain - 0.88) / 0.12
             + 10 * max(0.0, (0.55 - retr) / 0.55) + 4 * min(len(hs) + len(ls) - 4, 2))
        if sg == 1:
            ru, rl = (lambda i: up(i)), (lambda i: lw(i))
        else:
            ru, rl = (lambda i: -lw(i)), (lambda i: -up(i))
        t1, t2 = int(T[e]), int(T[n - 1])
        nu, nl = float(ru(n - 1)), float(rl(n - 1))
        zlo, zhi = min(nu, nl), max(nu, nl)
        cr = float(C[-1])
        dist = 0.0 if zlo <= cr <= zhi else min(abs(cr - zlo), abs(cr - zhi)) / a
        code = "FLAG_B" if sg == 1 else "FLAG_S"
        return dict(code=code, name=LINE_PAT[code][0], bias=LINE_PAT[code][1], status="terbentuk",
                    quality=round(min(q, 100.0), 1),
                    geom=[{"k": "line", "t1": t1, "p1": round(float(ru(e)), 2), "t2": t2, "p2": round(nu, 2), "label": "Pola"},
                          {"k": "line", "t1": t1, "p1": round(float(rl(e)), 2), "t2": t2, "p2": round(nl, 2), "label": "Pola"}],
                    zone_lo=round(zlo, 2), zone_hi=round(zhi, 2), start=int(T[max(0, e - FLAG_POLE_BARS)]),
                    dist_atr=round(dist, 2))
    return None


def detect_flags(H, L, C, T, a):
    out = []
    for sg in (1, -1):
        r = _flag_side(H, L, C, T, a, sg)
        if r:
            out.append(r)
    return out


def _cluster_level(pts, tol):
    best = None
    for _, pr in pts:
        grp = [p for p in pts if abs(p[1] - pr) <= tol]
        if len(grp) < 2:
            continue
        key = (len(grp), max(g[0] for g in grp))
        if best is None or key > best[0]:
            best = (key, grp)
    return best[1] if best else None


def detect_rectangle(H, L, C, T, a):
    """Rectangle: atas = >=2 high sejajar, bawah = >=2 low sejajar, harga bolak-balik di dalam, belum breakout."""
    n = len(C)
    if n < 60 or not a > 0:
        return []
    ph, pl = pivots(H, L, PIV)
    lo_i = n - RECT_MAX_BARS
    hs = [p for p in ph if p[0] >= lo_i]
    ls = [p for p in pl if p[0] >= lo_i]
    if len(hs) < 2 or len(ls) < 2:
        return []
    tol = RECT_TOL_ATR * a
    gh, gl = _cluster_level(hs, tol), _cluster_level(ls, tol)
    if not gh or not gl:
        return []
    top = float(np.mean([p[1] for p in gh]))
    bot = float(np.mean([p[1] for p in gl]))
    hgt = top - bot
    if not (RECT_MIN_H * a <= hgt <= RECT_MAX_H * a):
        return []
    i0 = min(min(p[0] for p in gh), min(p[0] for p in gl))
    i1 = max(max(p[0] for p in gh), max(p[0] for p in gl))
    if i1 - i0 < RECT_MIN_SPAN or n - 1 - i1 > RECT_MAX_IDLE:
        return []
    seg = C[i0:]
    contain = float(((seg <= top + 0.3 * a) & (seg >= bot - 0.3 * a)).mean())
    if contain < 0.90:
        return []
    cr = float(C[-1])
    if cr > top + 0.1 * a or cr < bot - 0.1 * a:
        return []
    half = len(seg) // 2
    if abs(float(np.mean(seg[half:]) - np.mean(seg[:half]))) > 0.5 * hgt:
        return []
    touches = len(gh) + len(gl)
    q = min(100.0, 35 + 7 * min(touches, 6) + 15 * (contain - 0.90) / 0.10 + 8 * min(hgt / (2 * a), 1.0))
    t1, t2 = int(T[i0]), int(T[n - 1])
    return [dict(code="RECT", name=LINE_PAT["RECT"][0], bias="NETRAL", status="terbentuk", quality=round(q, 1),
                 geom=[{"k": "line", "t1": t1, "p1": round(top, 2), "t2": t2, "p2": round(top, 2), "label": "Pola"},
                       {"k": "line", "t1": t1, "p1": round(bot, 2), "t2": t2, "p2": round(bot, 2), "label": "Pola"}],
                 zone_lo=round(bot, 2), zone_hi=round(top, 2), start=t1, dist_atr=0.0)]


_dlp_v23 = detect_line_patterns


def detect_line_patterns(H, L, C, T, a):
    out = list(_dlp_v23(H, L, C, T, a))
