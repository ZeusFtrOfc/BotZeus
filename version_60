    AUDIT["t"] = now
    with dblock:
        sh = [s for s in db["shadow"] if s.get("done") and s.get("r") is not None
              and s.get("elig_pre") is not None]
    if len(sh) < 30:
        return

    def st(xs):
        n = len(xs)
        if not n:
            return "n0"
