def match_focus(P, setups, a):
    """Kandidat yang paling cocok dengan fokus: kode dan area sama, lalu pilih yang pusat zonanya paling dekat.
    Mencegah fokus tertimpa angka (ruang, P, EV) milik zona tetangga yang berhimpitan."""
    cands = [s for s in setups if is_focus_candidate(P, s, a)]
    if not cands:
        return None
    mid = (float(P["zone_lo"]) + float(P["zone_hi"])) / 2.0
    return min(cands, key=lambda s: abs((s["zone_lo"] + s["zone_hi"]) / 2.0 - mid))

