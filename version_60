def zone_extremity(side, zlo, zhi, ctx):
    """0..1. BUY: makin dekat dasar range makin tinggi. SELL: makin dekat puncak range makin tinggi."""
    hi, lo = ctx.get("rng_hi"), ctx.get("rng_lo")
    if hi is None or lo is None or hi <= lo:
        return 0.5
    pos = ((float(zlo) + float(zhi)) / 2.0 - lo) / (hi - lo)
    pos = min(1.0, max(0.0, pos))
    return 1.0 - pos if side == "BUY" else pos
 
 
