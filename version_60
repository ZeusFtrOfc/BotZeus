# ---------------------------------------------------------------- util
def _norm_area(x):
    now = time.time()
    x.setdefault("qual_since", 0.0)
    x.setdefault("weak_since", 0.0)
    x.setdefault("confl", [])
    x.setdefault("blockers", [])
    x.setdefault("shown", False)
    x.setdefault("hidden", True)
    x.setdefault("rps", 0.5)
    x.setdefault("setup", None)
    if x.get("last_seen") is None:
        x["last_seen"] = now
    if x.get("born") is None:
        x["born"] = now
    if not x.get("touches"):
        x["touches"] = 0
    if x.get("ps") is None:
        x["ps"] = 0.0
    if x.get("ss") is None:
        x["ss"] = 0.0


def _retired(side, lo, hi, a, now):
    tol = 0.3 * a
    return any(r["until"] > now and r["side"] == side and lo <= r["hi"] + tol and r["lo"] <= hi + tol
               for r in RETIRED)


def _block_left(side, lo, hi, a, now):
    tol = 0.3 * a
    left = 0.0
    for b in AREA_BLOCKS:
        if b["side"] == side and lo <= b["zone_hi"] + tol and b["zone_lo"] <= hi + tol:
            left = max(left, b["until"] - now)
    return left


def _find_area(side, code, lo, hi, a):
    """Cari area registry yang berhimpitan. Return (area, exact). exact=False jika kode detektor berbeda
    (mis. SR vs OB di zona sama): area yang sudah tampil tetap dipakai, tidak ada area ganda."""
    tol = 0.3 * a
    near = [q for q in AREA_REG if q["side"] == side
            and lo <= q["zone_hi"] + tol and q["zone_lo"] <= hi + tol]
    if not near:
        return None, True
    same = [q for q in near if q["code"] == code]
    if same:
        return max(same, key=lambda q: q.get("ss", 0.0)), True
    return max(near, key=lambda q: (bool(q.get("shown")), q.get("ss", 0.0))), False


def _area_blockers(x, s, a, now, srv, retire=False):
    """Alasan area ini SAAT INI tidak punya rencana entry. Kosong = punya rencana.
    retire=True: blokir singkat (jeda fokus) tidak dihitung agar tanda tidak dicabut karenanya."""
    if s is None:
        return ["belum ada data setup"]
    out = [g for g in (s.get("gates") or []) if g.startswith(SNIPER_HARD)][:2]
    sd, lo, hi = x["side"], x["zone_lo"], x["zone_hi"]
    if _block_left(sd, lo, hi, a, now) > (SHORT_BLOCK_SEC if retire else 0.0):
        out.append("area baru saja gagal atau ditutup")
    if is_broken_area(sd, lo, hi, now):
        out.append("area tembus")
    if mm_blocked(sd, lo, hi, srv):
        out.append("memori kesalahan (stop-out)")
    if float(s.get("align", 0.0)) <= -0.30 and x["ps"] < SNIPER_COUNTER_P:
        out.append("melawan konsensus MTF")
    return out


def _retire(x, why, now, broken=False):
    if x in AREA_REG:
        AREA_REG.remove(x)
    RETIRED.append({"side": x["side"], "lo": x["zone_lo"], "hi": x["zone_hi"],
                    "until": now + MARK_RETIRE_COOLDOWN_SEC})
    del RETIRED[:-80]
    if broken:
        BROKEN.append({"side": x["side"], "zone_lo": x["zone_lo"], "zone_hi": x["zone_hi"],
                       "until": now + BROKEN_BLOCK_MIN * 60})
    if x.get("shown"):
        log(f"[AREA] DICABUT {x['side']} {x['name']} [{x['tf']}] {x['zone_lo']}-{x['zone_hi']}: {why}")


# ---------------------------------------------------------------- registry_update
def registry_update(setups, ctx, now):
    """Mencocokkan setup ke area, memperbarui P/kekuatan (halus), membekukan batas zona.
    Area BARU hanya menjadi KANDIDAT. Tampil hanya lewat registry_maintain."""
    apply_v25(setups, ctx)
    a = float(ctx["a"])
    AREA_DIAG["t_upd"] = now
    AREA_DIAG["n"] = len(setups)
    AREA_DIAG["buy"] = sum(1 for s in setups if s["side"] == "BUY")
    AREA_DIAG["sell"] = len(setups) - AREA_DIAG["buy"]
    top = []
    for s in setups:
        side, code = s["side"], s["code"]
        lo, hi = float(s["zone_lo"]), float(s["zone_hi"])
        stg, pp = float(s.get("strength", 0.0)), float(s["p"])
        top.append((_mark_q(stg, pp), s))
        x, exact = _find_area(side, code, lo, hi, a)
        if x is None:
            if stg < MARK_FLOOR_ST or pp < MARK_FLOOR_P:
                AREA_DIAG["rej_q"] += 1
                continue
            if _retired(side, lo, hi, a, now) or is_broken_area(side, lo, hi, now):
                AREA_DIAG["rej_birth"] += 1
                continue
            tmp = {"zone_lo": lo, "zone_hi": hi}
            cl = next((k for k in AREA_REG if k.get("shown") and k["side"] == side
                       and _gap(k, tmp) <= MARK_CLUSTER_ATR * a), None)
            if cl is not None:                       # sudah ada tanda di dekatnya: jadi konfluensi
                _norm_area(cl)
                if code != cl["code"] and code not in cl["confl"]:
                    cl["confl"].append(code)
                AREA_DIAG["rej_birth"] += 1
                continue
            AREA_SEQ["n"] += 1
            AREA_DIAG["new"] += 1
            x = dict(aid=f"{side[0]}{code}{round(lo * 100)}", seq=AREA_SEQ["n"], side=side, code=code,
                     tf=_area_tf(s), name=s["name"], zone_lo=round(lo, 2), zone_hi=round(hi, 2),
                     born=now, last_seen=now, elig_t=0.0, touches=0, ps=pp, ss=stg,
                     chk_t=0, chk1=0, in_touch=False, setup=None, shown=False, hidden=True,
                     q=0.0, dist_atr=float(s.get("dist_atr", 0.0)), qual_since=0.0, weak_since=0.0,
                     confl=[], blockers=[], rps=float(s.get("rps", 0.5)))
            AREA_REG.append(x)
            exact = True
        _norm_area(x)
        al = 1.0 - math.exp(-max(0.0, now - x["last_seen"]) / AREA_P_TAU)
        x["ps"] += al * (pp - x["ps"])
        x["ss"] += al * (stg - x["ss"])
        x["last_seen"] = now
        if not exact:
            if code != x["code"] and code not in x["confl"]:
                x["confl"].append(code)
            if x.get("setup") is not None:           # segarkan data dinamis saja, geometri tetap
                for k in REG_DYN:
                    if k in s:
                        x["setup"][k] = s[k]
            continue
        x["name"] = s["name"]
        tf = _area_tf(s)
        if TF_RANK.get(tf, 0) > TF_RANK.get(x["tf"], 0):
            x["tf"] = tf
        if "rps" in s:
            x["rps"] += 0.3 * (float(s["rps"]) - x["rps"])
        zlo, zhi = x["zone_lo"], x["zone_hi"]        # geometri dibekukan
        ent = zhi if side == "BUY" else zlo
        slp, _sld, _ok = structural_sl(side, zlo, zhi, ent, float(s.get("atr") or a))
        s.update(zone_lo=zlo, zone_hi=zhi, entry=round(ent, 2), sl=round(slp, 2), id=x["aid"])
        x["setup"] = s
        if s["eligible"]:
            x["elig_t"] = now
    top.sort(key=lambda t: -t[0])
    AREA_DIAG["top"] = [(round(mq, 1), s["side"], s["code"], s.get("tf"), s["zone_lo"], s["zone_hi"],
                         s["p"], round(float(s.get("strength", 0.0)), 0), s.get("dist_atr"),
                         ";".join(s["gates"])[:90]) for mq, s in top[:5]]


# ---------------------------------------------------------------- registry_maintain
def registry_maintain(ctx, now, new_bar):
    """KANDIDAT -> DITANDAI (terkunci) -> DICABUT.
    Area tampil TIDAK disembunyikan oleh P naik-turun, peringkat cluster, atau kuota.
    Dicabut hanya oleh: close menembus area, tanpa rencana entry terus-menerus MARK_DROP_SEC, atau terpakai."""
    a = float(ctx["a"])
    px = float(ctx["m1"].close.iloc[-1])
    srv = srv_now()
    RETIRED[:] = [r for r in RETIRED if r["until"] > now]
    for x in AREA_REG:
        _norm_area(x)

    if new_bar:                                       # tembus HANYA dari close candle
        for x in list(AREA_REG):
            try:
                why = _area_check(x, ctx)
            except Exception:
                log_exc("area_check")
                why = None
            if why:
                _retire(x, f"TEMBUS ({why})", now, broken=True)

    why_not = {}
    for x in list(AREA_REG):
        buy = x["side"] == "BUY"
        x["dist_atr"] = max(0.0, (px - x["zone_hi"]) if buy else (x["zone_lo"] - px)) / a
        x["q"] = area_rank(x)
        s = x.get("setup")
        unseen = now - x["last_seen"]
        x["blockers"] = _area_blockers(x, s, a, now, srv)
        if x.get("shown"):
            if (int(x.get("touches") or 0) >= 2 and x["code"] in SINGLE_USE
                    and unseen > AREA_CONSUMED_SEC):
                _retire(x, "sudah terpakai (disentuh 2x lalu hilang dari pemindaian)", now)
                continue
            weak = []
            if x["ps"] < MARK_KEEP_P:
                weak.append(f"P {x['ps']:.0f}% < {MARK_KEEP_P:.0f}%")
            if x["ss"] < MARK_KEEP_ST:
                weak.append(f"kekuatan {x['ss']:.0f} < {MARK_KEEP_ST:.0f}")
            if x["dist_atr"] > MARK_KEEP_MAX_ATR:
                weak.append(f"terlalu jauh ({x['dist_atr']:.0f} ATR)")
            if unseen > MARK_UNSEEN_SEC.get(x["tf"], 1800):
                weak.append(f"tidak terdeteksi lagi {unseen / 60:.0f} menit")
            weak += _area_blockers(x, s, a, now, srv, retire=True)[:2]
            if weak:
                if not x["weak_since"]:
                    x["weak_since"] = now
                elif now - x["weak_since"] >= MARK_DROP_SEC:
                    _retire(x, f"tanpa rencana entry selama {MARK_DROP_SEC:.0f} detik: "
                               + "; ".join(weak[:3]), now)
                    continue
            else:
                x["weak_since"] = 0.0
        else:
            if unseen > 180 or now - x["born"] > 900:      # kandidat basi dibuang diam-diam
                AREA_REG.remove(x)
                continue
            reason = None
            if s is None:
                reason = "belum ada data"
            elif x["blockers"]:
                reason = "gerbang: " + x["blockers"][0][:40]
            elif x["ps"] < MARK_BIRTH_P:
                reason = "P rendah"
            elif x["ss"] < MARK_BIRTH_ST:
                reason = "kekuatan rendah"
            elif x["dist_atr"] > MARK_BIRTH_MAX_ATR:
                reason = "terlalu jauh"
            elif unseen > 5.0:
                reason = "tidak terdeteksi"
            if reason is None:
                if not x["qual_since"]:
                    x["qual_since"] = now
            else:
                x["qual_since"] = 0.0
                why_not[reason] = why_not.get(reason, 0) + 1
    AREA_DIAG["why_not"] = why_not

    # kelahiran: peringkat terbaik dulu, hormati kuota, yang sudah tampil tidak digeser
    shown = [x for x in AREA_REG if x.get("shown")]
    cnt_side, cnt_tf = {}, {}
    for k in shown:
        cnt_side[k["side"]] = cnt_side.get(k["side"], 0) + 1
        cnt_tf[(k["tf"], k["side"])] = cnt_tf.get((k["tf"], k["side"]), 0) + 1
    ready = sorted([x for x in AREA_REG if not x.get("shown") and x["qual_since"]
                    and now - x["qual_since"] >= MARK_BIRTH_DWELL_SEC], key=lambda q: -q["q"])
    gap = MARK_CLUSTER_ATR * a
    for x in ready:
        cl = next((k for k in shown if k["side"] == x["side"] and _gap(k, x) <= gap), None)
        if cl is not None:
            if x["code"] != cl["code"] and x["code"] not in cl["confl"]:
                cl["confl"].append(x["code"])
            AREA_REG.remove(x)
            continue
        if (cnt_side.get(x["side"], 0) >= MARK_MAX_PER_SIDE
                or cnt_tf.get((x["tf"], x["side"]), 0) >= AREA_MAX_PER_TF_SIDE):
            continue
        x["shown"], x["hidden"], x["weak_since"] = True, False, 0.0
        shown.append(x)
        cnt_side[x["side"]] = cnt_side.get(x["side"], 0) + 1
        cnt_tf[(x["tf"], x["side"])] = cnt_tf.get((x["tf"], x["side"]), 0) + 1
        log(f"[AREA] DITANDAI {x['side']} {x['name']} [{x['tf']}] {x['zone_lo']}-{x['zone_hi']} "
            f"(lebar {x['zone_hi'] - x['zone_lo']:.2f}) P {x['ps']:.0f}% kuat {x['ss']:.0f} "
            f"RPS {x.get('rps', 0.5) * 100:.0f}% jarak {x['dist_atr']:.1f} ATR. Ada rencana entry (limit)")

    for x in AREA_REG:
        x["hidden"] = not x.get("shown")
    AREA_REG.sort(key=lambda q: (not q.get("shown"), -q["q"]))
    del AREA_REG[80:]
    try:
        registry_diag(ctx, now)
        if now - AREA_DIAG.get("t_why", 0.0) >= 30 and AREA_DIAG.get("why_not"):
            AREA_DIAG["t_why"] = now
            log("[AREA-DIAG] kandidat belum ditandai karena: "
                + ", ".join(f"{k} x{v}" for k, v in sorted(why_not.items(), key=lambda kv: -kv[1])))
    except Exception:
        log_exc("registry_diag")


# ---------------------------------------------------------------- registry_views
def registry_views(ctx, now):
    """Satu tampilan per area terkunci, lengkap dengan teks rencana entry."""
    a = float(ctx["a"])
    px = float(ctx["m1"].close.iloc[-1])
    P = PLAN_ACTIVE
    out = []
    for x in AREA_REG:
        if not x.get("shown") or x.get("setup") is None:
            continue
        s = dict(x["setup"])
        s.update(zone_lo=x["zone_lo"], zone_hi=x["zone_hi"], p=round(x["ps"], 1),
                 strength=round(x["ss"], 1), eligible=True, room_ok=True)
        if P is not None and (P.get("aid") == x["aid"] or is_focus_candidate(P, s, a)):
            continue                                  # fokus tampil di PLAN["plans"]
        lv, slp, sld = None, None, 0.0
        try:
            lv = float(limit_level(s, a))
            slp, sld, _ = structural_sl(s["side"], x["zone_lo"], x["zone_hi"], lv, a)
            s.update(limit=round(lv, 2), limit_sl=round(slp, 2), limit_sl_d=float(sld))
        except Exception:
            lv = None
        blk = list(x.get("blockers") or [])
        armed = (not blk) and (now - x["last_seen"] <= SNIPER_STALE_SEC) \
            and x["ps"] >= SNIPER_MIN_P and x["ss"] >= SNIPER_MIN_STRENGTH
        if armed and lv is not None:
            txt = (f"Rencana: {x['side']} LIMIT {lv:.2f}, SL {slp:.2f} ({round(sld / PIP_USD)} pips). "
                   f"Limit dipasang saat harga dalam {LIMIT_PLACE_ATR:.0f} ATR dari level "
                   f"(sekarang {x['dist_atr']:.1f} ATR)")
        else:
            txt = "Ditahan sementara: " + ("; ".join(blk[:2]) if blk else "P/kekuatan di bawah syarat order")
        v = plan_view(s, a, px, ctx["T"], False)
        cf = list(x.get("confl") or [])
        v.update(status="DITANDAI", mark=True, id=x["aid"], tf=x["tf"],
                 label=f"{x['name']} [{x['tf']}]" + (f" +{'+'.join(cf)}" if cf else ""),
                 p=round(x["ps"], 1), strength=round(x["ss"], 1), touches=int(x.get("touches") or 0),
                 age_min=int((now - x["born"]) / 60), armed=bool(armed), plan=txt, aksi=txt,
                 gates=([] if armed else blk), conf=cf, rps=round(x.get("rps", 0.5) * 100.0, 0),
                 dist_atr=round(x["dist_atr"], 1))
        out.append(v)
    return out


