# ---- validasi limit yang sudah terpasang
def pending_validity_check(tick):
    """Batalkan limit jika muncul bukti pembalikan lawan, atau fokus tidak lolos lagi selama LIMIT_INVALID_SEC.
    Return True jika limit berhasil dibatalkan."""
    ticket = PENDING["order"]
    P = PLAN_ACTIVE
    if not ticket or P is None or P.get("id") != PENDING.get("plan"):
        return False
    if not mt5.orders_get(ticket=ticket):
        return False                                     # sudah terisi/hilang, biar logika lama yang urus
    side = P["side"]
    opp_side = "SELL" if side == "BUY" else "BUY"
    now = time.time()
    why = None
    ev, rw = rev_score(opp_side)
    if ev >= rev_veto_thr(side):
        why = f"tanda pembalikan {opp_side} {ev * 100:.0f}% ({', '.join(rw[:3])})"
    else:
        pmin = (V17_MIN_P if V17_MIN_P is not None else SMART_MIN_P) * 100.0 - LIMIT_P_TOL
        bad = float(P.get("p", 100.0)) < pmin or P.get("eligible") is False
        if bad:
            if PEND_BAD["id"] != ticket:
                PEND_BAD.update(id=ticket, t=now)
            if now - PEND_BAD["t"] >= LIMIT_INVALID_SEC:
                why = f"fokus tidak lolos lagi (P {P.get('p')}%): " + "; ".join((P.get("gates") or [])[:2])
        else:
            PEND_BAD.update(id=None, t=0.0)
    if why:
        return cancel_pending("limit dibatalkan: " + why, force=True, block=False)
    return False


