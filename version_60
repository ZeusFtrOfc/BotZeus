class ExitLearner:
    """Membandingkan varian tangga SL+ pada bayangan yang sama (di-dedup per episode), lalu memilih
    yang terbaik secara statistik (rata-rata R - se), dengan margin dan cooldown."""

    def __init__(self):
        self.t, self.sc, self.last_switch = 0.0, {}, 0.0

    def maybe_update(self):
        now = time.time()
        if now - self.t < EXIT_LEARN_EVERY_SEC:
            return
        self.t = now
        with dblock:
            sh = [dict(s) for s in db["shadow"]
                  if s.get("done") and s.get("rv") and s["rv"].get("cur") is not None and s.get("close_time")]
        if len(sh) < EXIT_LEARN_MIN_N:
            return
        _assign_episodes(sh)
        sh.sort(key=lambda s: float(s.get("close_time") or 0))
        N = len(sh)
        acc = {n: [0.0, 0.0, 0.0, 0.0] for n in LADDER_VARIANTS}
        for j, s in enumerate(sh):
            w = (s["_epn"] ** -EPISODE_POWER) * (0.5 ** ((N - 1 - j) / EXIT_HALF_LIFE))
            for n in LADDER_VARIANTS:
                r = s["rv"].get(n)
                if r is None:
                    continue
                r = max(-1.5, min(4.0, float(r)))
                a_ = acc[n]
                a_[0] += w
                a_[1] += w * r
                a_[2] += w * r * r
                a_[3] += w * w
        sc = {}
        for n, (w, wr, wr2, w2) in acc.items():
            if w <= 0:
                continue
            mean = wr / w
            var = max(wr2 / w - mean * mean, 0.04)
            neff = (w * w) / max(w2, 1e-9)
            sc[n] = (mean, mean - EXIT_SE_K * math.sqrt(var / max(neff, 1.0)), neff)
        self.sc = sc
        cur = sc.get(ACTIVE_LADDER)
        if not cur:
            return
        best = max(sc, key=lambda n: sc[n][1])
        if (best != ACTIVE_LADDER and sc[best][2] >= EXIT_LEARN_MIN_N * 0.6
                and sc[best][1] >= cur[1] + EXIT_SWITCH_MARGIN
                and now - self.last_switch >= EXIT_SWITCH_COOLDOWN_SEC):
            self.last_switch = now
            old = ACTIVE_LADDER
            set_ladder(best)
            log(f"[LADDER] tangga SL+ diganti {old} -> {best}: R {cur[0]:+.2f} -> {sc[best][0]:+.2f} "
                f"(batas bawah {cur[1]:+.2f} -> {sc[best][1]:+.2f}, data efektif {sc[best][2]:.0f})")

    def public(self):
        return {n: [round(v[0], 3), round(v[1], 3)] for n, v in self.sc.items()}


EXIT_LEARN = ExitLearner()


def apply_v21(setups, ctx):
