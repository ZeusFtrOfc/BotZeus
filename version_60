    """Dipakai level limit: makin yakin makin dangkal (lebih mudah terisi)."""
    if s.get("cv") is not None:
        return float(_c((float(s["cv"]) - 44.0) / 36.0, 0.0, 1.0))
    return _conviction_v30prev(s)


# ---------------------------------------------------------------- 2) blokir struktural saja
def _area_blockers(x, s, a, now, srv, retire=False):
    """Alasan area ini tidak punya rencana entry. v30: momentum, konsensus, pola pembalikan jangka pendek
    TIDAK dihitung. Saat memilih: hanya gerbang struktural. Saat mempertahankan tanda (retire=True): hanya
    blokir nyata (tembus, stop-out)."""
    if s is None:
        return ["belum ada data setup"]
    out = []
    if not retire:
        allg = list(s.get("gates") or []) + list(s.get("gates_soft") or [])
        out += [g for g in allg if g.startswith(SEL_BLOCK_GATES)][:2]
    sd, lo, hi = x["side"], x["zone_lo"], x["zone_hi"]
    if _block_left(sd, lo, hi, a, now) > (SHORT_BLOCK_SEC if retire else 0.0):
        out.append("area baru saja gagal atau ditutup")
    if is_broken_area(sd, lo, hi, now):
        out.append("area tembus")
    if mm_blocked(sd, lo, hi, srv):
        out.append("memori kesalahan (stop-out)")
    return out


# ---------------------------------------------------------------- 3) deteksi tembus sadar tier
def _area_check(x, ctx):
    """Tembus hanya lewat CLOSE. Tier A/B atau terkomit butuh bukti lebih kuat: beberapa close M1 berturut-turut,
    dan margin close TF area yang lebih lebar. Juga menghitung sentuhan."""
    buy = x["side"] == "BUY"
    lo, hi = x["zone_lo"], x["zone_hi"]
    a1 = float(ctx["a"])
    m1 = ctx["m1"]
    T1, C1, H1, L1 = m1.time.values, m1.close.values, m1.high.values, m1.low.values
    tf = _tfdf(ctx, x["tf"]) or _tfdf(ctx, "M5")
    df = tf["df"]
    T, C = df.time.values, df.close.values
    if not x.get("chk1") or not x.get("chk_t"):
        x["chk1"], x["chk_t"] = int(T1[-1]), int(T[-1])
        return None
    tier = x.get("tier", "C")
    need = 3 if tier == "A" else 2 if (tier == "B" or x.get("commit")) else 1
    mult = 1.4 if tier == "A" else 1.2 if tier == "B" else 1.0
    reason = None
    for j in np.where(T1 > x["chk1"])[0]:
        c = float(C1[j])
        touch = bool(L1[j] <= hi and H1[j] >= lo)
        if touch and not x.get("in_touch"):
            x["touches"] = int(x.get("touches", 0)) + 1
        x["in_touch"] = touch
        beyond = (lo - c) if buy else (c - hi)
        if beyond >= AREA_FAST_BREAK_ATR * a1:
            x["out_n"] = int(x.get("out_n", 0)) + 1
            if x["out_n"] >= need:
                reason = f"{x['out_n']} close M1 berturut-turut menembus dalam"
        else:
            x["out_n"] = 0
    x["chk1"] = int(T1[-1])
    atf = float(tf["a"]) if float(tf["a"]) > 0 else a1
    brk = AREA_BREAK_ATR.get(x["tf"], 0.35) * atf * mult
    for j in np.where(T > x["chk_t"])[0]:
        c = float(C[j])
        if (buy and c < lo - brk) or ((not buy) and c > hi + brk):
            reason = reason or f"close {x['tf']} menembus sisi jauh"
    x["chk_t"] = int(T[-1])
    return reason


# ---------------------------------------------------------------- 4) registry: tanda bertahan karena keyakinan
def commit_diag(now):
    if now - COMMIT_DIAG["t"] < 30:
        return
    COMMIT_DIAG["t"] = now
    rows = sorted([x for x in AREA_REG if x.get("shown")], key=lambda q: -float(q.get("cv", 0.0)))[:4]
    if rows:
        log("[KEYAKINAN] " + " | ".join(
            f"{x['side']} {x['code']}[{x['tf']}] {x['zone_lo']}-{x['zone_hi']} cv {x.get('cv', 0):.0f}"
            f"{x.get('tier', '-')}{'*' if x.get('commit') else ''} jarak {x['dist_atr']:.1f}" for x in rows))


def registry_maintain(ctx, now, new_bar):
    """KANDIDAT -> DITANDAI -> DICABUT, berbasis keyakinan struktural (bukan P yang bergoyang).
    Area ditandai jika keyakinan >= MARK_BIRTH_CV. Area tampil dicabut hanya jika: tembus (close),
    keyakinan < COMMIT_KEEP_CV terus-menerus MARK_DROP_SEC, terpakai, atau blokir nyata. Area terkomit kebal
    terhadap alasan lemah (jauh, tidak terdeteksi sesaat)."""
    a = float(ctx["a"])
    px = float(ctx["m1"].close.iloc[-1])
    srv = srv_now()
    RETIRED[:] = [r for r in RETIRED if r["until"] > now]
    for x in AREA_REG:
        _norm_area(x)
        if x.get("commit") and (PLAN_ACTIVE is None or PLAN_ACTIVE.get("aid") != x["aid"]):
            x["commit"] = False                       # komitmen mengikuti fokus aktif

    if new_bar:
        for x in list(AREA_REG):
            try:
                why = _area_check(x, ctx)
            except Exception:
                log_exc("area_check")
                why = None
            if why:
                _retire(x, f"TEMBUS ({why})", now, broken=True)

    why_not = {}
    for x in list(AREA_REG):
        buy = x["side"] == "BUY"
        x["dist_atr"] = max(0.0, (px - x["zone_hi"]) if buy else (x["zone_lo"] - px)) / a
        x["q"] = area_rank(x) + 0.3 * float(x.get("cv", 0.0))
        s = x.get("setup")
        unseen = now - x["last_seen"]
        committed = bool(x.get("commit"))
        cv = float(x.get("cv", 0.0))
        x["blockers"] = _area_blockers(x, s, a, now, srv)
        if x.get("shown"):
            if (not committed and int(x.get("touches") or 0) >= 2 and x["code"] in SINGLE_USE
                    and unseen > AREA_CONSUMED_SEC):
                _retire(x, "sudah terpakai (disentuh 2x lalu hilang dari pemindaian)", now)
                continue
            weak = []
            if not committed:
                if cv < COMMIT_KEEP_CV:
                    weak.append(f"keyakinan {cv:.0f} < {COMMIT_KEEP_CV:.0f}")
                if x["dist_atr"] > MARK_KEEP_MAX_ATR:
                    weak.append(f"terlalu jauh ({x['dist_atr']:.0f} ATR)")
                if unseen > MARK_UNSEEN_SEC.get(x["tf"], 1800):
                    weak.append(f"tidak terdeteksi lagi {unseen / 60:.0f} menit")
            weak += _area_blockers(x, s, a, now, srv, retire=True)[:2]
            if weak:
                if not x["weak_since"]:
                    x["weak_since"] = now
                elif now - x["weak_since"] >= MARK_DROP_SEC:
                    _retire(x, f"lemah terus-menerus {MARK_DROP_SEC:.0f} detik: " + "; ".join(weak[:3]), now)
                    continue
            else:
                x["weak_since"] = 0.0
        else:
            if unseen > 180 or now - x["born"] > 900:
                AREA_REG.remove(x)
                continue
            reason = None
            if s is None:
                reason = "belum ada data"
            elif x["blockers"]:
                reason = "gerbang: " + x["blockers"][0][:40]
            elif cv < MARK_BIRTH_CV:
                reason = f"keyakinan {cv:.0f} < {MARK_BIRTH_CV:.0f}"
            elif x["ss"] < MARK_BIRTH_ST:
                reason = "kekuatan rendah"
            elif x["dist_atr"] > MARK_BIRTH_MAX_ATR:
                reason = "terlalu jauh"
            elif unseen > 5.0:
                reason = "tidak terdeteksi"
            if reason is None:
                if not x["qual_since"]:
                    x["qual_since"] = now
            else:
                x["qual_since"] = 0.0
                why_not[reason] = why_not.get(reason, 0) + 1
    AREA_DIAG["why_not"] = why_not

    shown = [x for x in AREA_REG if x.get("shown")]
    cnt_side, cnt_tf = {}, {}
    for k in shown:
        cnt_side[k["side"]] = cnt_side.get(k["side"], 0) + 1
        cnt_tf[(k["tf"], k["side"])] = cnt_tf.get((k["tf"], k["side"]), 0) + 1
    ready = sorted([x for x in AREA_REG if not x.get("shown") and x["qual_since"]
                    and now - x["qual_since"] >= MARK_BIRTH_DWELL_SEC], key=lambda q: -q["q"])
    gap = MARK_CLUSTER_ATR * a
    for x in ready:
        cl = next((k for k in shown if k["side"] == x["side"] and _gap(k, x) <= gap), None)
        if cl is not None:
            if x["code"] != cl["code"] and x["code"] not in cl["confl"]:
                cl["confl"].append(x["code"])
            AREA_REG.remove(x)
            continue
        if (cnt_side.get(x["side"], 0) >= MARK_MAX_PER_SIDE
                or cnt_tf.get((x["tf"], x["side"]), 0) >= AREA_MAX_PER_TF_SIDE):
            continue
        x["shown"], x["hidden"], x["weak_since"] = True, False, 0.0
        shown.append(x)
        cnt_side[x["side"]] = cnt_side.get(x["side"], 0) + 1
        cnt_tf[(x["tf"], x["side"])] = cnt_tf.get((x["tf"], x["side"]), 0) + 1
        log(f"[AREA] DITANDAI {x['side']} {x['name']} [{x['tf']}] {x['zone_lo']}-{x['zone_hi']} "
            f"(lebar {x['zone_hi'] - x['zone_lo']:.2f}) keyakinan {x.get('cv', 0):.0f} tier {x.get('tier', '-')} "
            f"P {x['ps']:.0f}% kuat {x['ss']:.0f} jarak {x['dist_atr']:.1f} ATR | "
            + "; ".join((x.get("cv_notes") or [])[:3]))

    for x in AREA_REG:
        x["hidden"] = not x.get("shown")
    AREA_REG.sort(key=lambda q: (not q.get("shown"), -q["q"]))
    del AREA_REG[80:]
    try:
        registry_diag(ctx, now)
        commit_diag(now)
        if now - AREA_DIAG.get("t_why", 0.0) >= 30 and AREA_DIAG.get("why_not"):
            AREA_DIAG["t_why"] = now
            log("[AREA-DIAG] kandidat belum ditandai karena: "
                + ", ".join(f"{k} x{v}" for k, v in sorted(why_not.items(), key=lambda kv: -kv[1])))
    except Exception:
        log_exc("registry_diag")


