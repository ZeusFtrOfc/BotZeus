# ---------------------------------------------------------------- 4) area entry dari pola (termasuk batas range)
PL_COUNTER_ON = True


def pattern_entry_zones(side, ctx):
    """Area entry dari chart pattern terkunci.
    v29: batas DATAR pola belum-breakout (garis atas datar untuk SELL, garis bawah datar untuk BUY, atau
    channel/rectangle) tetap menjadi area entry walau bias pola berlawanan (kualitas dikurangi PL_COUNTER_Q_PEN)."""
    out = []
    if not PL_ON:
        return out
    buy = side == "BUY"
    t_now = int(ctx["T"][-1]) + 60
    for tf, Lk in list(PAT_LOCK.items()):
        q = float(Lk.get("quality", 0))
        bias = Lk.get("bias")
        counter = bias in ("BUY", "SELL") and bias != side
        if counter:
            if (not PL_COUNTER_ON) or Lk.get("kind") != "lines" or Lk.get("dir") != 0:
                continue
            q -= PL_COUNTER_Q_PEN
        if q < PL_MIN_Q:
            continue
        a_tf = _a_of(ctx, tf)
        zl = zh = None
        why = ""
        if Lk["kind"] == "lines":
            u, l = _line_at(Lk["up"], t_now), _line_at(Lk["lo"], t_now)
            if u <= l:
                continue
            if Lk["dir"] == 0:
                if counter:
                    fu, fl = _lk_flat(Lk, a_tf)
                    if not ((fl if buy else fu) or Lk.get("code") in BOUNCE_CODES):
                        continue
                if buy:
                    zl, zh, why = l - 0.25 * a_tf, l + 0.35 * a_tf, "tolakan garis bawah pola"
                else:
                    zl, zh, why = u - 0.35 * a_tf, u + 0.25 * a_tf, "tolakan garis atas pola"
                if counter:
                    why += " (batas datar, melawan bias pola)"
            elif Lk["dir"] == 1 and buy:
                zl, zh, why = u - 0.35 * a_tf, u + 0.25 * a_tf, "retest garis atas setelah breakout"
            elif Lk["dir"] == -1 and not buy:
                zl, zh, why = l - 0.25 * a_tf, l + 0.35 * a_tf, "retest garis bawah setelah breakdown"
        else:
            nk = _line_at(Lk["neck"], t_now)
            if Lk["dir"] == 0:
                ext = Lk.get("ext")
                if ext is None:
                    continue
                if buy:
                    zl, zh, why = ext - 0.1 * a_tf, ext + 0.5 * a_tf, "retest dasar pola (prediksi pembalikan naik)"
                else:
                    zl, zh, why = ext - 0.5 * a_tf, ext + 0.1 * a_tf, "retest puncak pola (prediksi pembalikan turun)"
            else:
                zl, zh, why = nk - 0.3 * a_tf, nk + 0.3 * a_tf, "retest neckline setelah breakout"
        if zl is None:
            continue
        out.append(dict(zl=float(zl), zh=float(zh), tf=tf, q=q, name=Lk["name"], why=why, anch=tf != "M1"))
    return out


# ---------------------------------------------------------------- 5) zona S/R dengan pivot H1
HTF_CACHE = {"t": 0.0, "df": None}


def _h1_df():
    """H1 di-cache 30 detik (dipakai membentuk zona S/R)."""
    now = time.time()
    if now - HTF_CACHE["t"] > 30:
        HTF_CACHE["t"] = now
        try:
            r = mt5.copy_rates_from_pos(SYMBOL, mt5.TIMEFRAME_H1, 0, 300)
            if r is not None and len(r) >= 60:
                HTF_CACHE["df"] = pd.DataFrame(r).iloc[:-1]
        except Exception:
            log_exc("h1_df")
    return HTF_CACHE["df"]


def build_zones(m1, m5, m15, a):
    """v29: sama dengan v25 (zona sempit tepat di wick pivot), ditambah pivot H1.
    Level yang berimpit dengan H1 mendapat kekuatan lebih (bonus 4 timeframe +3.5)."""
    pts = (collect_pivots_k(m1, 1) + collect_pivots_k(m5, 5) + collect_pivots_k(m15, 15)
           + [(p, w, ag, mm, "D") for p, w, ag, mm in daily_points(m15)])
    h1 = _h1_df()
    if h1 is not None:
        try:
            pts += collect_pivots_k(h1, 60)
        except Exception:
            log_exc("h1_pivots")
    if not pts or not a > 0:
        return []
    a = float(a)
    pts.sort(key=lambda x: x[0])
    tol = ZONE_PIV_TOL_A1 * a
    groups, cur = [], [pts[0]]
    for q in pts[1:]:
        if q[0] - cur[-1][0] <= tol and q[0] - cur[0][0] <= 2 * tol:
            cur.append(q)
        else:
            groups.append(cur)
            cur = [q]
    groups.append(cur)
    ref = m5 if m5 is not None else m1
    H5, L5, C5 = ref.high.values[-300:], ref.low.values[-300:], ref.close.values[-300:]
    cap, pad, tr = ZONE_CAP_A1 * a, ZONE_PAD_A1 * a, 0.30 * a
    zones = []
    for g in groups:
        gw = sum(max(x[1], 1e-6) for x in g)
        bands, _ = _tight_bands(g, cap)
        for bi, band in enumerate(bands):
            prices = [x[0] for x in band]
            bw = sum(max(x[1], 1e-6) for x in band)
            lo, hi = min(prices) - pad, max(prices) + pad
            if hi - lo < ZONE_MIN_A1 * a:
                m_ = (lo + hi) / 2.0
                lo, hi = m_ - ZONE_MIN_A1 * a / 2.0, m_ + ZONE_MIN_A1 * a / 2.0
            mid = (lo + hi) / 2.0
            st = bw + (0.4 * (gw - bw) if bi == 0 else 0.0)
            ntf = len({x[3] for x in band})
            tfmax = max(x[3] for x in band)
            if ntf >= 4:
                st += 3.5
            elif ntf == 3:
                st += 2.5
            elif ntf == 2:
                st += 1.5
            if abs(mid - round(mid / 10) * 10) <= tr:
                st += 2
            elif abs(mid - round(mid / 5) * 5) <= tr:
                st += 1
            if min(x[2] for x in band) <= 120:
                st += 1
            touch = (H5 >= lo) & (L5 <= hi)
            ep = (int(np.sum(touch[1:] & ~touch[:-1])) + int(touch[0])) if len(touch) else 0
            if ep >= 2:
                st += min(ZONE_EP_CAP, ZONE_EP_BONUS * ep)
            sgn = np.where(C5 > hi, 1, np.where(C5 < lo, -1, 0))
            nz = sgn[sgn != 0]
            crosses = int(np.sum(nz[1:] * nz[:-1] < 0)) if len(nz) > 1 else 0
            st -= min(ZONE_CHOP_CAP, ZONE_CHOP_STEP * max(0, crosses - ZONE_CHOP_FREE_M5))
            zones.append({"lo": float(lo), "hi": float(hi), "mid": float(mid), "st": float(max(st, 0.0)),
                          "touches": len(band), "tfs": ntf, "ep": int(ep),
                          "htf": bool(any(x[3] >= 5 for x in band)),
                          "h1": bool(any(x[3] >= 60 for x in band)),
                          "tf": "M15" if tfmax >= 15 else "M5" if tfmax >= 5 else "M1",
                          "nh": int(sum(1 for x in band if x[4] == "H")),
                          "nl": int(sum(1 for x in band if x[4] == "L"))})
    return zones


# ---------------------------------------------------------------- 6) deteksi pola garis: ZigZag + klasifikasi sideways
def pivots_zz(H, L, C, a, k=0.9):
    """Pivot ZigZag berbasis ATR: ayunan terkonfirmasi saat harga berbalik >= k x ATR (tidak perlu menunggu n candle
    di kanan, jadi lebih dini dan bebas noise kecil). Ditambah SATU pivot sementara di ujung jika harga sudah mulai
    berbalik >= 0.5k x ATR dari ekstrem terakhir. Return (highs, lows) berisi (indeks, harga)."""
    n = len(H)
    ph, pl = [], []
    if n < 12 or not a > 0:
        return ph, pl
    thr = k * a
    hi, hi_i = float(H[0]), 0
    lo, lo_i = float(L[0]), 0
    dirn, ext, ext_i = 0, 0.0, 0
    for i in range(1, n):
        h, l = float(H[i]), float(L[i])
        if dirn == 0:
            if h > hi:
                hi, hi_i = h, i
            if l < lo:
                lo, lo_i = l, i
            if hi - lo >= thr:
                if hi_i > lo_i:
                    pl.append((lo_i, lo))
                    dirn, ext, ext_i = 1, hi, hi_i
                else:
                    ph.append((hi_i, hi))
                    dirn, ext, ext_i = -1, lo, lo_i
        elif dirn == 1:
            if h > ext:
                ext, ext_i = h, i
            elif ext - l >= thr:
                ph.append((ext_i, ext))
                dirn, ext, ext_i = -1, l, i
        else:
            if l < ext:
                ext, ext_i = l, i
            elif h - ext >= thr:
                pl.append((ext_i, ext))
                dirn, ext, ext_i = 1, h, i
    if dirn != 0 and ext_i <= n - 3:
        c = float(C[-1])
        if dirn == 1 and ext - c >= 0.5 * thr:
            ph.append((ext_i, ext))
        elif dirn == -1 and c - ext >= 0.5 * thr:
            pl.append((ext_i, ext))
    return ph, pl


def _fit_line(pts, tol, max_m=5):
    """Pasang garis ke m pivot terakhir (m terbesar dulu sampai 2) yang simpangannya <= tol.
    Return (slope, intercept, simpangan, pivot_dipakai) atau None."""
    for m in range(min(max_m, len(pts)), 1, -1):
        seg = pts[-m:]
        xs = np.array([p[0] for p in seg], dtype=float)
        ys = np.array([p[1] for p in seg], dtype=float)
        if xs[-1] == xs[0]:
            continue
        if m == 2:
            s = (ys[1] - ys[0]) / (xs[1] - xs[0])
            b = ys[0] - s * xs[0]
            dev = 0.0
        else:
            s, b = np.polyfit(xs, ys, 1)
            dev = float(np.max(np.abs(ys - (s * xs + b))))
        if dev <= tol:
            return float(s), float(b), dev, seg
    return None


def _line_from_pivots(ph, pl, C, T, a):
    """Satu kandidat pola garis dari satu set pivot. None jika tidak ada pola yang valid."""
    n = len(C)
    lo_i = n - PAT_LINE_MAX_BARS
    phw = [p for p in ph if p[0] >= lo_i]
    plw = [p for p in pl if p[0] >= lo_i]
    if len(phw) < 2 or len(plw) < 2:
        return None
    tol = PAT_LINE_DEV_ATR * a
    fu, fl = _fit_line(phw, tol), _fit_line(plw, tol)
    if fu is None or fl is None:
        return None
    su, bu, du, hs = fu
    sl_, bl, dl, ls = fl
    touches = len(hs) + len(ls)
    if touches < PAT_LINE_MIN_TOUCH_EARLY:
        return None
    early = touches < PAT_LINE_MIN_TOUCH
    i0 = min(hs[0][0], ls[0][0])
    i_last = max(hs[-1][0], ls[-1][0])
    span = i_last - i0
    if span < PAT_LINE_MIN_BARS or n - 1 - i_last > PAT_LINE_MAX_IDLE:
        return None
    up = lambda i: su * i + bu
    lw = lambda i: sl_ * i + bl
    w0, w_last = up(i0) - lw(i0), up(i_last) - lw(i_last)
    if w0 < 1.0 * a or w_last < 0.1 * a:
        return None
    xs = np.arange(i0, i_last + 1)
    inside = (C[xs] <= up(xs) + 0.3 * a) & (C[xs] >= lw(xs) - 0.3 * a)
    contain = float(inside.mean())
    if contain < PAT_CONTAIN_MIN + (0.07 if early else 0.0):
        return None

    ru, rl = su * span / a, sl_ * span / a              # pergeseran garis sepanjang pola (x ATR)
    thr = max(PAT_FLAT_ATR, 0.22 * w0 / a)              # "datar" relatif terhadap tinggi pola (sideways = rectangle)
    flat_u, flat_l = abs(ru) <= thr, abs(rl) <= thr
    conv = w_last <= 0.75 * w0
    parallel = abs(su - sl_) * span <= 0.6 * a and w_last >= 0.8 * w0
    code = None
    if flat_u and flat_l and w_last >= 0.8 * w0:
        code = "RECT"
    elif conv:
        if flat_u and rl > thr:
            code = "TRI_A"
        elif flat_l and ru < -thr:
            code = "TRI_D"
        elif ru < -thr and rl > thr:
            code = "TRI_S"
        elif ru > thr and rl > thr:
            code = "WDG_R"
        elif ru < -thr and rl < -thr:
            code = "WDG_F"
    elif parallel and ru > thr and rl > thr:
        code = "CH_U"
    elif parallel and ru < -thr and rl < -thr:
        code = "CH_D"
    if code is None:
        return None

    tb = 0.1 * a
    dirn, jb = 0, None
    for j in range(i_last + 1, n):
        if C[j] > up(j) + tb:
            dirn, jb = 1, j
            break
        if C[j] < lw(j) - tb:
            dirn, jb = -1, j
            break
    c = float(C[-1])
    if jb is None:
        status, bias = "terbentuk", LINE_PAT[code][1]
    else:
        if n - 1 - jb > 40:
            return None
        rest = np.arange(jb + 1, n)
        if len(rest):
            if dirn == 1 and (C[rest] < up(rest) - 0.5 * a).any():
                return None
            if dirn == -1 and (C[rest] > lw(rest) + 0.5 * a).any():
                return None
        beyond = (c - up(n - 1)) if dirn == 1 else (lw(n - 1) - c)
        status = "retest" if beyond <= 0.35 * a else "breakout"
        bias = "BUY" if dirn == 1 else "SELL"

    fit_pts = (1 if len(hs) >= 3 else 0) + (1 if len(ls) >= 3 else 0)
    q = min(45.0, 10.0 * touches - 10.0)
    q += 20.0 * max(0.0, 1.0 - max(du, dl) / tol) * (0.5 + 0.25 * fit_pts)
    q += 15.0 * max(0.0, min(1.0, (contain - PAT_CONTAIN_MIN) / (1.0 - PAT_CONTAIN_MIN)))
    q += 10.0 * min(1.0, w0 / (2.0 * a))
    q += {"terbentuk": 5.0, "breakout": 10.0, "retest": 10.0}[status]
    if early:
        q -= 10.0

    now_up, now_lo = float(up(n - 1)), float(lw(n - 1))
    z_lo, z_hi = min(now_lo, now_up), max(now_lo, now_up)
    dist = 0.0 if z_lo <= c <= z_hi else min(abs(c - z_lo), abs(c - z_hi)) / a
    t1, t2 = int(T[i0]), int(T[n - 1])
    geom = [{"k": "line", "t1": t1, "p1": round(float(up(i0)), 2), "t2": t2, "p2": round(now_up, 2), "label": "Pola"},
            {"k": "line", "t1": t1, "p1": round(float(lw(i0)), 2), "t2": t2, "p2": round(now_lo, 2), "label": "Pola"}]
    return dict(code=code, name=LINE_PAT[code][0], bias=bias, status=status, quality=round(q, 1),
                geom=geom, zone_lo=round(z_lo, 2), zone_hi=round(z_hi, 2), start=t1,
                dist_atr=round(dist, 2))


def detect_line_patterns(H, L, C, T, a):
    """v29: segitiga, wedge, channel, rectangle (satu kandidat terbaik dari pivot ZigZag atau klasik),
    ditambah Bull/Bear Flag dan detektor rectangle berbasis cluster. Real price (tidak dicerminkan)."""
    out = []
    n = len(C)
    if n < 60 or not a > 0:
        return out
    sets = [pivots(H, L, PIV)]
    if ZZ_ON:
        sets.insert(0, pivots_zz(H, L, C, a, 0.8 if PIV <= 2 else 0.95))
    cands = []
    for ph, pl in sets:
        try:
            r = _line_from_pivots(ph, pl, C, T, a)
        except Exception:
            log_exc("line_from_pivots")
            r = None
        if r:
            cands.append(r)
    if cands:
        out.append(max(cands, key=lambda x: x["quality"]))
    for fn in (detect_flags, detect_rectangle):
        if fn is detect_rectangle and any(o["code"] == "RECT" for o in out):
            continue
        try:
            out += fn(H, L, C, T, a)
        except Exception:
            log_exc(fn.__name__)
    return out


# ---------------------------------------------------------------- 7) re-evaluasi pola terkunci
def pat_reeval(ctx):
    """Pola terkunci yang BELUM breakout dilepas jika ada pola lain yang jelas lebih baik
    (mis. Ascending Triangle -> Rectangle saat harga ternyata sideways). Lepas tanpa memasukkan ke PAT_DEAD."""
    now = time.time()
    for tf in ctx["tfs"]:
        nm = tf["name"]
        Lk = PAT_LOCK.get(nm)
        if Lk is None or Lk.get("dir") != 0 or now - float(Lk.get("locked", now)) < PAT_REEVAL_HOLD_SEC:
            continue
        sc = _pat_candidates(tf)
        if not sc:
            continue
        best = sc[0]
        if best["code"] == Lk["code"]:
            continue
        cur_sel = float(Lk.get("quality", 0.0)) - PAT_DIST_W * float(Lk.get("dist_atr", 0.0))
        if best["sel"] >= cur_sel + PAT_REEVAL_MARGIN:
            log(f"[POLA] {Lk['name']} [{nm}] diganti {best['name']}: skor {cur_sel:.0f} -> {best['sel']:.0f}")
            PAT_LOCK.pop(nm, None)


