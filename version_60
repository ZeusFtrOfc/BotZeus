def sync_history(open_ids):
    """Gabungkan riwayat MT5 ke database permanen, lalu kembalikan trade akun ini (urut waktu tutup).
    open_ids = position identifier posisi yang masih terbuka."""
    login = cache["account"].get("login", 0)
    now = datetime.now() + timedelta(days=2)
    deals = mt5.history_deals_get(now - timedelta(days=365), now)
    inf = mt5.symbol_info(SYMBOL)
    cs = (inf.trade_contract_size if inf else 100) or 100
    if deals is not None:
        by_pos = {}
        for d in deals:
            if d.magic == MAGIC and d.symbol == SYMBOL:
                by_pos.setdefault(d.position_id, []).append(d)
        changed = False
        with dblock:
            for pid, ds in by_pos.items():
                if pid in open_ids:
                    continue
                ins = [x for x in ds if x.entry == mt5.DEAL_ENTRY_IN]
                outs = [x for x in ds if x.entry == mt5.DEAL_ENTRY_OUT]
                if not ins or not outs:
                    continue
                i, o = ins[0], outs[-1]
                key = str(pid)
                old = db["trades"].get(key, {})
                meta = db["meta"].get(key, {})
                code, score, sld = meta.get("code"), meta.get("score"), meta.get("sl_dist")
                if not code:
                    m = COMMENT_RE.match(i.comment or "")
                    if m:
                        code, score, sld = m.group(1), int(m.group(2)), float(m.group(3))
                code = code or old.get("code")
                score = score if score is not None else old.get("score")
                sld = sld or old.get("sl_dist")
                buy = i.type == mt5.DEAL_TYPE_BUY
                pnl = sum(x.profit + x.commission + x.swap + getattr(x, "fee", 0.0) for x in ds)
                # R = hasil (mata uang akun) / risiko (dolar -> mata uang akun)
                r = round(pnl / (acc_per_usd() * sld * i.volume * cs), 2) if sld and i.volume else None
                rec = {"ticket": pid, "side": "BUY" if buy else "SELL", "lot": i.volume,
                       "open": i.price, "close": o.price, "open_time": i.time, "close_time": o.time,
                       "profit": round(pnl, 2), "code": code, "score": score, "sl_dist": sld,
                       "r": r, "tags": meta.get("tags") or old.get("tags"),
                       "p": meta.get("p", old.get("p")), "regime": meta.get("regime", old.get("regime")),
                       "login": login, "symbol": SYMBOL}
                if old != rec:
                    db["trades"][key] = rec
                    changed = True
            if changed:
                save_db()
    with dblock:
        out = [t for t in db["trades"].values()
               if (not login or t.get("login") in (login, 0, None)) and t.get("symbol", SYMBOL) == SYMBOL]
    out.sort(key=lambda t: t["close_time"])
    return out


