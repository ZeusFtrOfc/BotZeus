def mirror_df(df, buy):
    sg = 1 if buy else -1
    return ((df.high if buy else -df.low).values, (df.low if buy else -df.high).values,
            (df.open * sg).values, (df.close * sg).values)


def plan_ob(H, L, O, C, Av, n):
    """Order Block + FVG yang masih valid. Return [(zl, zh)]."""
    out = []
    for k in range(n - 3, n - 3 - OB_MAX_AGE, -1):
        if k < max(BOS_BARS, 60) + 1:
            break
        if C[k] - O[k] < DISP_ATR * Av[k]:
            continue
        if L[k + 1] - H[k - 1] < FVG_MIN_ATR * Av[k]:
            continue
        if C[k] <= H[k - BOS_BARS:k].max():
            continue
        j = next((j for j in (k - 1, k - 2, k - 3) if C[j] < O[j]), None)
        if j is None:
            continue
        zl, zh = L[j], H[j]
        if (C[k + 2:n] < zl).any():
            continue
        seg = L[k + 2:n - 1]
        if len(seg):
            touch = seg <= zh
            ep = int(np.sum(touch[1:] & ~touch[:-1])) + int(touch[0])
            if ep > OB_MAX_TOUCH:
                continue
        if DISCOUNT_ONLY:
            top, bot = H[k - 60:k + 2].max(), L[k - 60:k + 2].min()
            if (zl + zh) / 2 > bot + 0.5 * (top - bot):
                continue
        out.append((float(zl), float(zh)))
    return out


def plan_flip(fz, H, L, O, C, Av, a, n):
    """Zona RBS/SBR: level ditembus impulsif, harga menjauh, lalu retest. Return [(lo, hi, st, prior)]."""
    out = []
    for lo, hi, st in fz:
        if st < RBS_MIN_ST or C[-1] <= lo:
            continue
        below = np.where(C[:n - 1] < lo)[0]
        if len(below) == 0:
            continue
        k = int(below[-1])
        after = np.where(C[k + 1:n - 1] > hi)[0]
        if len(after) == 0:
            continue
        j = k + 1 + int(after[0])
        age = n - 1 - j
        if age < 3 or age > FLIP_MAX_BARS or j - k > 12:
            continue
        if max(C[j] - O[j], C[j] - C[j - 1]) < FLIP_BREAK_ATR * Av[j]:
            continue
        if H[j:n - 1].max() < hi + FLIP_MIN_MOVE_ATR * a:
            continue
        touching = L[j + 1:n - 1] <= hi + 0.1 * a
        prior = 0
        if len(touching):
            episodes = int(np.sum(touching[1:] & ~touching[:-1])) + int(touching[0])
            prior = episodes - (1 if touching[-1] else 0)
        if prior > FLIP_MAX_PRIOR_RETEST:
            continue
        out.append((float(lo), float(hi), float(st), prior))
    return out


def plan_break_retest(H, L, O, C, Av, a, n, T):
    """Swing high ditembus impulsif, harga menjauh, lalu RETEST PERTAMA (candle terakhir yang menyentuh).
    Ruang bullish; SELL otomatis jadi break swing low."""
    out = []
    if n < 40 or not a > 0:
        return out
    ph, _ = pivots(H, L, PIV)
    for idx, lvl in reversed(ph[-6:]):
        if n - idx > BR_MAX_BARS + 10:
            continue
        after = np.where(C[idx + 1:n - 1] > lvl + 0.1 * a)[0]
        if len(after) == 0:
            continue
        j = idx + 1 + int(after[0])
        age = n - 1 - j
        if age < BR_MIN_BARS or age > BR_MAX_BARS:
            continue
        if max(C[j] - O[j], C[j] - C[j - 1]) < BR_BREAK_ATR * Av[j]:
            continue
        if H[j:n - 1].max() < lvl + BR_MIN_MOVE_ATR * a:
            continue
        if C[j + 1:n - 1].min() < lvl - 0.35 * a:
            continue
        if (L[j + 1:n - 2] <= lvl + 0.25 * a).any():      # dua candle terakhir = kandidat retest, tidak dihitung
            continue
        out.append(dict(code="BR", zl=float(lvl - 0.3 * a), zh=float(lvl + 0.25 * a),
                        tags=["break & retest pertama (level swing)"],
                        geom=[("line", T[idx], float(lvl), T[n - 1], float(lvl), "Level break")]))
        if len(out) >= 2:
            break
    return out


def plan_pattern_zones(H, L, C, a, n, T):
    """Double/Triple Bottom & Inverse H&S (SELL: Double/Triple Top & H&S) yang menembus neckline lalu retest.
    v15.1: geom berisi garis yang menghubungkan pivot pembentuk pola (zigzag) + neckline."""
    out = []
    ph, pl = pivots(H, L, PIV)
    for k in (2, 3):
        for lows in reversed(list(itertools.combinations(pl[-6:], k))):
            idx, pr = [x[0] for x in lows], [x[1] for x in lows]
            if idx[0] < n - PAT_MAX_BARS:
                continue
            if any(idx[i + 1] - idx[i] < PAT_MIN_GAP for i in range(k - 1)):
                continue
            if max(pr) - min(pr) > PAT_TOL_ATR * a:
                continue
            peaks = []
            for j in range(k - 1):
                seg = [q for q in ph if idx[j] < q[0] < idx[j + 1]]
                if not seg:
                    peaks = None
                    break
                peaks.append(max(seg, key=lambda q: q[1]))
            if not peaks:
                continue
            neck, bottom = max(q[1] for q in peaks), min(pr)
            if neck - bottom < PAT_MIN_DEPTH_ATR * a or C[-1] < neck - 0.25 * a:
                continue
            if L[idx[0]:].min() < bottom - 0.3 * a:
                continue
            path = []
            for j in range(k):
                path.append((idx[j], pr[j]))
                if j < k - 1:
                    path.append((peaks[j][0], peaks[j][1]))
            geom = [("line", T[path[m][0]], path[m][1], T[path[m + 1][0]], path[m + 1][1], "Pola")
                    for m in range(len(path) - 1)]
            geom.append(("line", T[idx[-1]], pr[-1], T[n - 1], float(C[-1]), "Pola"))
            geom.append(("line", T[peaks[0][0]], neck, T[n - 1], neck, "Neckline"))
            out.append({"code": "DB" if k == 2 else "TB", "base": 58 if k == 2 else 64,
                        "zl": neck - 0.25 * a, "zh": neck + 0.25 * a,
                        "tags": [("double" if k == 2 else "triple") + " bottom, retest neckline"],
                        "geom": geom})
            break
    for (i1, l1), (i2, hd), (i3, r) in reversed(list(itertools.combinations(pl[-6:], 3))):
        if i1 < n - PAT_MAX_BARS or min(i2 - i1, i3 - i2) < PAT_MIN_GAP:
            continue
        if not (hd < l1 - HS_HEAD_ATR * a and hd < r - HS_HEAD_ATR * a):
            continue
        if abs(l1 - r) > HS_SHOULDER_TOL * a:
            continue
        if L[i1:].min() < hd - 0.3 * a:
            continue
        n1 = [q for q in ph if i1 < q[0] < i2]
        n2 = [q for q in ph if i2 < q[0] < i3]
        if not n1 or not n2:
            continue
        p1, p2 = max(n1, key=lambda q: q[1]), max(n2, key=lambda q: q[1])
        slope = (p2[1] - p1[1]) / (p2[0] - p1[0])
        if abs(slope) * (p2[0] - p1[0]) > 1.5 * a:
            continue
        ly = lambda i: p1[1] + slope * (i - p1[0])
        y = ly(n - 1)
        if y - hd < PAT_MIN_DEPTH_ATR * a or C[-1] < y - 0.25 * a:
            continue
        if L[i3:].min() < r - 0.3 * a:
            continue
        geom = [("line", T[i1], l1, T[p1[0]], p1[1], "Pola"),
                ("line", T[p1[0]], p1[1], T[i2], hd, "Pola"),
                ("line", T[i2], hd, T[p2[0]], p2[1], "Pola"),
                ("line", T[p2[0]], p2[1], T[i3], r, "Pola"),
                ("line", T[i3], r, T[n - 1], float(C[-1]), "Pola"),
                ("line", T[p1[0]], ly(p1[0]), T[n - 1], ly(n - 1), "Neckline")]
        out.append({"code": "IHS", "base": 64, "zl": y - 0.25 * a, "zh": y + 0.25 * a,
                    "tags": ["inverse H&S, retest neckline"], "geom": geom})
        break
    return out

def plan_pennant_wedge(H, L, O, C, Av, a, n, T):
    """Pola konvergen (garis atas dan bawah dari pivot) yang sudah breakout ke atas lalu retest garis atas.
    PN = pennant (ada tiang impulsif sebelumnya, segitiga kecil). FW = falling wedge (kedua garis turun,
    garis atas lebih curam). Ruang bullish; SELL otomatis jadi bear pennant / rising wedge."""
    out, seen = [], set()
    if n < 90 or not a > 0:
        return out
    ph, pl = pivots(H, L, 2)
    for j in range(n - 2, max(n - 40, 50), -1):
        hs = [p for p in ph if j - PW_MAX_BARS <= p[0] < j - 1][-4:]
        ls = [p for p in pl if j - PW_MAX_BARS <= p[0] < j - 1][-4:]
        if len(hs) < 2 or len(ls) < 2:
            continue
        i0 = min(hs[0][0], ls[0][0])
        i1 = max(hs[-1][0], ls[-1][0])
        if i1 - i0 < 10 or i1 >= j:
            continue
        try:
            su, bu = np.polyfit([p[0] for p in hs], [p[1] for p in hs], 1)
            sl_, bl = np.polyfit([p[0] for p in ls], [p[1] for p in ls], 1)
        except Exception:
            continue
        up = lambda i: su * i + bu
        lw = lambda i: sl_ * i + bl
        if any(abs(p[1] - up(p[0])) > 0.35 * a for p in hs):
            continue
        if any(abs(p[1] - lw(p[0])) > 0.35 * a for p in ls):
            continue
        w0, w1 = up(i0) - lw(i0), up(j) - lw(j)
        if w1 < 0.1 * a or w0 < 1.3 * w1 or su >= sl_:       # harus mengerucut
            continue
        # breakout: close pertama di atas garis atas, dengan dorongan
        if not (C[j] > up(j) + 0.1 * a and C[j - 1] <= up(j - 1) + 0.1 * a):
            continue
        if C[j] - O[j] < 0.5 * Av[j] and C[j] - C[j - 1] < 0.6 * Av[j]:
            continue
        xs = np.arange(i0, j)
        if (C[i0:j] > up(xs) + 0.3 * a).any() or (C[i0:j] < lw(xs) - 0.3 * a).any():
            continue
        pole = float(H[max(0, i0 - 3):i0 + 3].max() - L[max(0, i0 - 20):max(1, i0)].min())
        kind = None
        if pole >= PN_POLE_ATR * a and w0 <= 0.7 * pole and su <= 0.03 * a and sl_ >= -0.03 * a:
            kind = "PN"
        elif su < -0.01 * a and sl_ < -0.005 * a and float(H[max(0, i0 - 25):i0 + 1].max() - lw(j)) >= 1.5 * a:
            kind = "FW"
        if kind is None or kind in seen:
            continue
        age = n - 1 - j
        if age < 1 or age > 40:
            continue
        if (H[j:n - 1] - up(np.arange(j, n - 1))).max() < 0.5 * a:      # harus sempat menjauh dari garis
            continue
        xs2 = np.arange(j + 1, n - 1)
        if len(xs2):
            if (C[j + 1:n - 1] < up(xs2) - 0.4 * a).any():             # kembali masuk pola = gagal
                continue
            touching = L[j + 1:n - 1] <= up(xs2) + 0.1 * a
            eps = int(np.sum(touching[1:] & ~touching[:-1])) + int(touching[0])
            if eps - (1 if touching[-1] else 0) > 1:
                continue
        y_now = float(up(n - 1))
        if C[-1] < y_now - 0.4 * a:
            continue
        nm = "Pennant" if kind == "PN" else "Wedge"
        out.append(dict(code=kind, base=58, zl=y_now - 0.3 * a, zh=y_now + 0.25 * a,
                        tags=[("bull pennant" if kind == "PN" else "falling wedge") + " breakout, retest garis atas"],
                        geom=[("line", T[i0], float(up(i0)), T[n - 1], y_now, nm + " atas"),
                              ("line", T[i0], float(lw(i0)), T[j], float(lw(j)), nm + " bawah")]))
        seen.add(kind)
        if len(seen) == 2:
            break
    return out


def engulf_trigger(zl, zh, H, L, O, C, a):
    """Satu-satunya konfirmasi: bullish engulfing di zona (ruang bullish; SELL = bearish engulfing).
    Candle sebelumnya berlawanan arah dan DITEMBUS oleh close candle sekarang."""
    if len(C) < 6:
        return False
    if C[-1] - O[-1] < ENG_MIN_BODY_ATR * a:                 # body harus cukup besar
        return False
    if C[-2] >= O[-2]:                                       # candle sebelumnya harus berlawanan arah
        return False
    brk = C[-1] > H[-2] if ENG_REQUIRE_BREAK_HIGH else C[-1] > O[-2]
    if not brk or O[-1] > C[-2] + 0.05 * a:
        return False
    low2 = min(L[-1], L[-2])
    if not (zl - 0.8 * a <= low2 <= zh + 0.15 * a):          # dua candle ini harus menyentuh zona
        return False
    if C[-1] <= zl or C[-1] > zh + ENG_MAX_ABOVE_ATR * a:    # close di atas zona, tidak terlalu jauh
        return False
    if min(C[-5:-2]) <= zl - 0.6 * a or C[-2] < zl - 0.8 * a:   # harga datang dari atas, bukan sudah jebol
        return False
    return True


def calm_trigger(zl, zh, H, L, O, C, V, a):
    """Engulfing valid di zona, lalu 1-3 candle SETELAHNYA kecil dan volume menurun.
    Return jumlah candle kecil (1-3), atau 0 jika tidak ada. Ruang bullish; SELL sudah dicerminkan."""
    n = len(C)
    for m in (1, 2, 3):
        e = n - m                                  # e = jumlah candle sampai dengan engulfing
        if e < 8:
            break
        if not engulf_trigger(zl, zh, H[:e], L[:e], O[:e], C[:e], a):
            continue
        k = e - 1                                  # indeks candle engulfing
        body = C[k] - O[k]
        v0 = V[k]
        prev = v0
        ok = True
        for j in range(e, n):
            if (H[j] - L[j]) > CALM_RANGE_ATR * a or abs(C[j] - O[j]) > CALM_BODY_FRAC * body:
                ok = False                         # candle masih besar
                break
            if V[j] >= v0 or V[j] > prev * 1.15:
                ok = False                         # volume tidak menurun
                break
            if C[j] <= zl or L[j] < L[k] - 0.1 * a:
                ok = False                         # candle kecil tidak menahan di atas zona / low engulfing
                break
            prev = V[j]
        if ok and C[-1] <= zh + (ENG_MAX_ABOVE_ATR + 0.5) * a:
            return m
    return 0

def sweep_trigger(zl, zh, H, L, O, C, a):
    """Konfirmasi sweep di area (ruang bullish; SELL sudah dicerminkan).
    Wick menusuk low (atau sisi bawah body) candle sebelumnya lalu close kembali di atasnya,
    dengan wick bawah panjang dan close di bagian atas candle. Return 'sweep wick' / 'sweep body' / ''."""
    if len(C) < 8:
        return ""
    rng = float(H[-1] - L[-1])
    if rng < SWEEP_MIN_RANGE_ATR * a:
        return ""
    body = abs(float(C[-1] - O[-1]))
    low_wick = float(min(O[-1], C[-1]) - L[-1])
    if low_wick < SWEEP_WICK_MIN_ATR * a or low_wick < SWEEP_WICK_BODY_RATIO * max(body, 0.05 * a):
        return ""
    if (float(C[-1]) - float(L[-1])) / rng < SWEEP_CLOSE_FRAC:
        return ""
    prev_low = float(L[-2])
    prev_body_low = float(min(O[-2], C[-2]))
    pierce = SWEEP_PIERCE_ATR * a
    if L[-1] < prev_low - pierce and C[-1] > prev_low:
        kind = "sweep wick"
    elif (SWEEP_ALLOW_BODY and L[-1] < prev_body_low - pierce and C[-1] > prev_body_low
          and low_wick >= SWEEP_BODY_WICK_ATR * a):
        kind = "sweep body"
    else:
        return ""
    # harus terjadi di area: low menyentuh area, tidak terlalu dalam, close kembali di atas area
    if not (zl - SWEEP_MAX_BELOW_ATR * a <= L[-1] <= zh + 0.15 * a):
        return ""
    if C[-1] <= zl or C[-1] > zh + ENG_MAX_ABOVE_ATR * a:
        return ""
    if min(C[-5:-2]) <= zl - 0.6 * a:          # harga datang dari atas, bukan sudah jebol
        return ""
    return kind

def confirm_trigger(zl, zh, H, L, O, C, V, a, buy):
    """Konfirmasi entry. Urutan: engulfing, engulfing + candle kecil, lalu sweep wick/body.
    Return teks konfirmasi atau '' jika belum ada."""
    eng = "bullish engulfing" if buy else "bearish engulfing"
    if CONFIRM_MODE != "CALM" and engulf_trigger(zl, zh, H, L, O, C, a):
        return eng
    m = calm_trigger(zl, zh, H, L, O, C, V, a)
    if m:
        return f"{eng} + {m} candle kecil volume turun"
    if SWEEP_ON:
        sw = sweep_trigger(zl, zh, H, L, O, C, a)
        if sw:
            return f"{'bullish' if buy else 'bearish'} {sw}"
    return ""

