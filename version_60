# ---------------------------------------------------------------- 5) pemilihan fokus: berbasis keyakinan
def commit_pick(now, tick, exclude_aid=None, min_cv=None):
    """Area tertandai terbaik yang boleh DIKOMIT. Syarat: keyakinan >= COMMIT_MIN_CV stabil COMMIT_DWELL_SEC,
    tidak diblokir struktural, melawan tren M15 hanya jika tier A, ruang ke area lawan cukup (kecuali tier A),
    dan harga dalam jendela COMMIT_WINDOW_ATR. Momentum pendekatan tidak dihitung sebagai alasan menolak."""
    ctx = LAST_CTX
    if not SNIPER_ON or not ctx or tick is None:
        return None
    a = float(ctx["a"])
    srv = srv_now()
    thr = COMMIT_MIN_CV if min_cv is None else max(COMMIT_MIN_CV, float(min_cv))
    best, bs = None, -1e9
    for x in AREA_REG:
        s = x.get("setup")
        if (not x.get("shown")) or s is None or x["aid"] == exclude_aid:
            continue
        if now - x["last_seen"] > SNIPER_STALE_SEC:
            continue
        cv = float(x.get("cv", 0.0))
        if cv < thr or x["ss"] < COMMIT_MIN_ST:
            continue
        since = float(x.get("cv_ok_since") or 0.0)
        if (not since) or now - since < COMMIT_DWELL_SEC:
            continue
        if _area_blockers(x, s, a, now, srv):
            continue
        tier = x.get("tier", "C")
        if s.get("counter_trend") and tier != "A":
            continue
        lo, hi, sd = x["zone_lo"], x["zone_hi"], x["side"]
        if is_parked(sd, lo, hi, now, 0.3 * a):
            continue
        buy = sd == "BUY"
        px = float(tick.ask if buy else tick.bid)
        dist = (px - hi) if buy else (lo - px)
        if dist > COMMIT_WINDOW_ATR * a or dist < -SNIPER_INSIDE_FRAC * (hi - lo):
            continue
        if tier != "A":
            br = opp_barrier(sd, lo, hi, a, px)
            if br:
                _room_log(x["aid"], br)
                continue
        sc = cv - COMMIT_DIST_W * max(0.0, dist) / a
        if sc > bs:
            best, bs = x, sc
    return best


