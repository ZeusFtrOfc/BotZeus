def area_rank(x):
    """Peringkat area: kekuatan, P, RPS, bobot timeframe, prioritas strategi, konfluensi. Area yang sedang tampil
    mendapat bonus hysteresis supaya tidak bolak-balik."""
    tfw = {"M15": 10.0, "M5": 5.0, "M1": 0.0}.get(x["tf"], 0.0)
    prio = (6 - STRAT_PRIO.get(x["code"], 5)) * 0.8
    conf = min(len(x.get("confl") or []), 3) * 3.0
    r = 0.40 * x["ss"] + 0.35 * x["ps"] + 25.0 * x.get("rps", 0.5) + tfw + prio + conf
    if x.get("shown"):
        r += V25_HYST
    return r


def registry_maintain(ctx, now, new_bar):
    """v25: (1) tembus hanya lewat CLOSE, (2) area bertahan lama tanpa terdeteksi ulang, (3) per cluster sesisi
    (radius 1 ATR) hanya SATU pemenang terkuat yang ditandai, area lain yang diserap menambah konfluensi pemenang."""
    a = float(ctx["a"])
    px = float(ctx["m1"].close.iloc[-1])
    if new_bar:
        for x in list(AREA_REG):
            try:
                why = _area_check(x, ctx)
            except Exception:
                log_exc("area_check")
                why = None
            if why:
                AREA_REG.remove(x)
                BROKEN.append({"side": x["side"], "zone_lo": x["zone_lo"], "zone_hi": x["zone_hi"],
                               "until": now + BROKEN_BLOCK_MIN * 60})
                log(f"[AREA] TEMBUS {x['side']} {x['name']} [{x['tf']}] {x['zone_lo']}-{x['zone_hi']}: {why}")
    for x in list(AREA_REG):
        miss = now - x["last_seen"]
        consumed = (int(x.get("touches") or 0) >= 2 and x["code"] in ("BR", "RBS", "SBR", "OB", "SD", "PL")
                    and miss > AREA_CONSUMED_SEC)
        if miss > AREA_GRACE_SEC.get(x["tf"], 1200) or consumed:
            AREA_REG.remove(x)
            log(f"[AREA] HILANG {x['side']} {x['name']} [{x['tf']}] {x['zone_lo']}-{x['zone_hi']}: "
                f"{'sudah terpakai (disentuh 2x lalu hilang)' if consumed else 'tidak terdeteksi lagi'}")
    for x in AREA_REG:
        buy = x["side"] == "BUY"
        x["dist_atr"] = max(0.0, (px - x["zone_hi"]) if buy else (x["zone_lo"] - px)) / a
        x["q"] = area_rank(x)
        x["confl_new"] = []
    AREA_REG.sort(key=lambda q: -q["q"])
    del AREA_REG[80:]
    kept, cnt, gap = [], {}, V25_CLUSTER_ATR * a
    for x in AREA_REG:
        show = x["setup"] is not None
        thr = MARK_KEEP_Q if x.get("shown") else MARK_ENTER_Q
        if _mark_q(x["ss"], x["ps"]) < thr:
            show = False
        if x["dist_atr"] > AREA_VIEW_MAX_ATR.get(x["tf"], 20.0):
            show = False
        if show:
            win = next((k for k in kept if k["side"] == x["side"] and _gap(k, x) <= gap), None)
            if win is not None:                              # sudah ada area lebih kuat di dekatnya
                if x["code"] != win["code"] and x["code"] not in win["confl_new"]:
                    win["confl_new"].append(x["code"])
                show = False
        key = (x["tf"], x["side"])
        if show and cnt.get(key, 0) >= AREA_MAX_PER_TF_SIDE:
            show = False
        if show:
            kept.append(x)
            cnt[key] = cnt.get(key, 0) + 1
            if not x.get("logged"):
                x["logged"] = True
                log(f"[AREA] DITANDAI {x['side']} {x['name']} [{x['tf']}] {x['zone_lo']}-{x['zone_hi']} "
                    f"(lebar {x['zone_hi'] - x['zone_lo']:.2f}) P {x['ps']:.0f}% kuat {x['ss']:.0f} "
                    f"RPS {x.get('rps', 0.5) * 100:.0f}% jarak {x['dist_atr']:.1f} ATR")
        x["shown"], x["hidden"] = show, not show
    for k in kept:
        k["confl"] = list(k["confl_new"])
    try:
        registry_diag(ctx, now)
    except Exception:
        log_exc("registry_diag")


