        _plan_log(time.time(), fid, f"POSISI #{t['ticket']} tutup: {hasil}, {t['profit']:.2f}. "
                                    f"Fokus dilepas, analisis ulang")
        PLAN_ACTIVE = None
        bar_state["last"] = 0

