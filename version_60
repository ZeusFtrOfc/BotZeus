    return False


def zone_broken(side, zlo, zhi, bid, ask, close, a):
    if side == "BUY":
        return ((close is not None and close < zlo - BREAK_MARK_ATR * a)
                or (bid is not None and bid < zlo - BREAK_LIVE_ATR * a))
    return ((close is not None and close > zhi + BREAK_MARK_ATR * a)
            or (ask is not None and ask > zhi + BREAK_LIVE_ATR * a))


def scan_broken_marks(bid, ask, a, now, close=None):
    """Cek semua area yang sedang tampil. Yang tembus langsung dihapus dari tampilan, dicatat di riwayat,
    diblokir sementara, dan memicu analisis ulang instan (v15.1)."""
    BROKEN[:] = [b for b in BROKEN if b["until"] > now]
    gone = []
    for w in list(MARK_PREV):
        if zone_broken(w["side"], w["zone_lo"], w["zone_hi"], bid, ask, close, a):
            BROKEN.append({"side": w["side"], "zone_lo": w["zone_lo"], "zone_hi": w["zone_hi"],
                           "until": now + BROKEN_BLOCK_MIN * 60})
            gone.append(w)
            _plan_log(now, w["id"], f"AREA TEMBUS {w['side']} {w['name']} ({w['zone_lo']}-{w['zone_hi']}), "
                                    f"dihapus dari chart, bot mencari area baru")
    if gone:
        ids = {w["id"] for w in gone}
        MARK_PREV[:] = [w for w in MARK_PREV if w["id"] not in ids]
        PLAN["watch"][:] = [v for v in PLAN.get("watch", []) if v["id"] not in ids]
        trigger_react(now)
    del BROKEN[:-60]

