def area_strength(s):
    """Kekuatan area 0-100: kekuatan zona (35), retest/kesegaran (15), confluence (15), jangkar M5/M15 (15),
    prioritas strategi (5), dan area penting di belakang zona / supply-demand (15).
    v16: zona Supply-Demand yang masih SEGAR (belum diuji) mendapat nilai penuh seperti zona teruji."""
    st = min(float(s.get("zone_st", 0.0)) / 10.0, 1.0) * 35.0
    epn = int(s.get("ep", 0))
    ep = min(epn / 5.0, 1.0) * 15.0
    if s.get("code") == "SD" and epn == 0:
        ep = 12.0
    cw = min(float(s.get("combo_w", 0.0)) / 20.0, 1.0) * 15.0
    anc = 15.0 if s.get("anchored") else 0.0
    pr = max(0, 5 - int(s.get("prio", 5))) / 4.0 * 5.0
    bk = min(float(s.get("back", 0.0)), 1.0) * 15.0
    return round(st + ep + cw + anc + pr + bk, 1)

