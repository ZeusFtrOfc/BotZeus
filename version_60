# ---------------------------------------------------------------- 2) cek area lawan di depan zona
def opp_barrier(side, lo, hi, a, px):
    """Return teks alasan jika ada S/R lawan yang kuat terlalu dekat di depan zona, selain itu None.
    BUY: penghalang = resisten di atas zona. SELL: penghalang = support di bawah zona."""
    ctx = LAST_CTX
    if not ctx or not a > 0:
        return None
    buy = side == "BUY"
    ref = max(hi, px) if buy else min(lo, px)
    gap = 0.05 * a
    best = None                                   # (ruang, lo, hi, kekuatan)
    for z in (ctx.get("strong") or []):
        if float(z["st"]) < SNIPER_OPP_ST:
            continue
        if buy and z["lo"] > ref + gap:
            room = z["lo"] - hi
        elif (not buy) and z["hi"] < ref - gap:
            room = lo - z["hi"]
        else:
            continue
        if best is None or room < best[0]:
            best = (room, z["lo"], z["hi"], float(z["st"]))
    opp = "SELL" if buy else "BUY"
    for x in AREA_REG:
        st = float(x.get("ss") or 0.0)
        if (not x.get("shown")) or x["side"] != opp or st < SNIPER_OPP_AREA_ST:
            continue
        if buy and x["zone_lo"] > ref + gap:
            room = x["zone_lo"] - hi
        elif (not buy) and x["zone_hi"] < ref - gap:
            room = lo - x["zone_hi"]
        else:
            continue
        if best is None or room < best[0]:
            best = (room, x["zone_lo"], x["zone_hi"], st)
    if best is None:
        return None
    need = max(SNIPER_ROOM_ATR * a, SNIPER_ROOM_MIN_USD)
    if best[0] >= need:
        return None
    return (f"area lawan kuat (st {best[3]:.0f}) di {best[1]:.2f}-{best[2]:.2f} hanya {best[0]:.2f} USD "
            f"di depan {side}, perlu >= {need:.2f} USD")


def _extra_gates(s):
    if not SNIPER_EXTRA_HARD:
        return []
    allg = list(s.get("gates") or []) + list(s.get("gates_soft") or [])
    return [g for g in allg if g.startswith(SNIPER_EXTRA_HARD)]


def _room_log(key, txt):
    now = time.time()
    if now - _ROOM_LOG.get(key, 0.0) >= 60:
        _ROOM_LOG[key] = now
        log(f"[SNIPER-ROOM] {key}: {txt}")


# ---------------------------------------------------------------- 3) sniper memakai gerbang tambahan + cek lawan
def _sniper_candidate(now, tick):
    ctx = LAST_CTX
    if not SNIPER_ON or not ctx or tick is None:
        return None
    a = float(ctx["a"])
    srv = srv_now()
    best, bs = None, -1e9
    for x in AREA_REG:
        s = x.get("setup")
        if not x.get("shown") or s is None or now - x["last_seen"] > SNIPER_STALE_SEC:
            continue
        if x["ps"] < SNIPER_MIN_P or x["ss"] < SNIPER_MIN_STRENGTH:
            continue
        if _area_blockers(x, s, a, now, srv):
            continue
        ex = _extra_gates(s)
        if ex:
            _room_log(x["aid"], "ditahan gerbang: " + ex[0][:90])
            continue
        lo, hi, sd = x["zone_lo"], x["zone_hi"], x["side"]
        if is_parked(sd, lo, hi, now, 0.3 * a):
            continue
        buy = sd == "BUY"
        px = float(tick.ask if buy else tick.bid)
        dist = (px - hi) if buy else (lo - px)
        if dist > SNIPER_PLACE_ATR * a or dist < -SNIPER_INSIDE_FRAC * (hi - lo):
            continue
        br = opp_barrier(sd, lo, hi, a, px)
        if br:
            _room_log(x["aid"], br)
            continue
        sc = x["q"] - 2.0 * max(0.0, dist) / a
        if sc > bs:
            best, bs = x, sc
    return best


