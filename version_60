def apply_confluence(cands, a):
    """Bonus skor jika zona bertumpuk dengan strategi lain (dibatasi COMBO_CAP)."""
    for p in cands:
        names, w = set(), 0.0
        for q in cands:
            if q is p:
                continue
            if not (q["zl"] <= p["zh"] + 0.3 * a and p["zl"] <= q["zh"] + 0.3 * a):
                continue
            if q["code"] == p["code"]:
                if p["code"] == "OB" and q.get("tf") != p.get("tf") and ("OB-" + str(q.get("tf"))) not in names:
                    names.add("OB-" + str(q.get("tf")))
                    w += 3
                continue
            if q["code"] in names:
                continue
            names.add(q["code"])
            w += COMBO_W.get(frozenset((p["code"], q["code"])), 4)
        w = min(w, COMBO_CAP)
        p["conf"], p["combo_w"], p["combo"] = len(names), float(w), sorted(names)
        if w:
            p["score"] += w
            p["tags"].append("confluence " + "+".join([p["code"]] + sorted(names)) + f" (+{w:.0f})")


