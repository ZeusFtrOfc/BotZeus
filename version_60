def _area_by_id(aid):
    return next((x for x in AREA_REG if x["aid"] == aid), None)


def _is_marked(s, a):
    return any(x.get("shown") and _same_zone(x, s["side"], s["code"], s["zone_lo"], s["zone_hi"], a)
               for x in AREA_REG)


def _sniper_candidate(now, tick):
    """Area ditandai terbaik yang boleh di-order sekarang. Gerbang lunak diabaikan; hanya gerbang keselamatan
    (SNIPER_HARD) yang berlaku. Melawan konsensus MTF butuh P lebih tinggi."""
    ctx = LAST_CTX
    if not SNIPER_ON or not ctx or tick is None:
        return None
    a = float(ctx["a"])
    srv = srv_now()
    best, bs = None, -1e9
    for x in AREA_REG:
        s = x.get("setup")
        if not x.get("shown") or s is None or now - x["last_seen"] > SNIPER_STALE_SEC:
            continue
        if x["ps"] < SNIPER_MIN_P or x["ss"] < SNIPER_MIN_STRENGTH:
            continue
        if [g for g in (s.get("gates") or []) if g.startswith(SNIPER_HARD)]:
            continue
        if float(s.get("align", 0.0)) <= -0.30 and x["ps"] < SNIPER_COUNTER_P:
            continue
        lo, hi, sd = x["zone_lo"], x["zone_hi"], x["side"]
        if (area_blocked(sd, lo, hi, a, now) or is_broken_area(sd, lo, hi, now)
                or is_parked(sd, lo, hi, now, 0.3 * a) or mm_blocked(sd, lo, hi, srv)):
            continue
        buy = sd == "BUY"
        px = float(tick.ask if buy else tick.bid)
        dist = (px - hi) if buy else (lo - px)
        if dist > SNIPER_PLACE_ATR * a or dist < -SNIPER_INSIDE_FRAC * (hi - lo):
            continue
        sc = x["q"] - 2.0 * max(0.0, dist) / a
        if sc > bs:
            best, bs = x, sc
    return best


def _sniper_setup(x, a, tick):
    s = dict(x["setup"])
    buy = x["side"] == "BUY"
    px = float(tick.ask if buy else tick.bid)
    dist = (px - x["zone_hi"]) if buy else (x["zone_lo"] - px)
    s.update(zone_lo=x["zone_lo"], zone_hi=x["zone_hi"], p=round(x["ps"], 1), pw=round(x["ps"] / 100.0, 4),
             strength=round(x["ss"], 1), eligible=True, gates=[], room_ok=True,
             dist_atr=round(max(0.0, dist) / a, 1), sniper=True, aid=x["aid"])
    return s


def pick_focus(elig, a, thr_pct):
    """v25: fokus = area TERTANDAI terbaik (sniper). Jika tidak ada, kandidat eligible yang juga tertandai."""
    now = time.time()
    if now - START_T < STARTUP_WARM_SEC:
        return None
    tk = mt5.symbol_info_tick(SYMBOL)
    x = _sniper_candidate(now, tk)
    if x is not None:
        return _sniper_setup(x, a, tk)
    on = learning_on()
    return next((s for s in elig if _is_marked(s, a)
                 and (not on or (s["p"] >= thr_pct and s["ev"] >= ENTRY_MIN_EV))
                 and stable_ok(s, a, now)), None)


def sniper_step(tick):
    """Dipanggil tiap siklus bot (0,25 dtk). Jika belum ada fokus tetapi ada area tertandai yang layak, kunci sebagai
    fokus. Limit lalu dipasang oleh jalur arm_entry yang sudah ada (spread, guard, level limit presisi)."""
    global PLAN_ACTIVE
    if not SNIPER_ON or not LAST_CTX:
        return
    now = time.time()
    if PLAN_ACTIVE is not None or PENDING["order"] or cache["open"]:
        return
    if now < LOCK_PAUSE["until"] or now - START_T < STARTUP_WARM_SEC:
        return
    x = _sniper_candidate(now, tick)
    if x is None:
        return
    a = float(LAST_CTX["a"])
    F = lock_focus(_sniper_setup(x, a, tick), int(LAST_CTX["T"][-1]), now, LAST_CTX["st5"], LAST_CTX["st15"])
    PLAN_ACTIVE = F
    LOCK_IDLE["since"] = 0.0
    _plan_log(now, F["id"],
              f"[SNIPER] FOKUS {F['side']} {F['name']} [{F['tf']}] {F['zone_lo']}-{F['zone_hi']} "
              f"P {F['p']}% kuat {F['strength']:.0f} RPS {x.get('rps', 0.5) * 100:.0f}% "
              f"jarak {F['dist_atr']} ATR. Limit dipasang di level presisi")


