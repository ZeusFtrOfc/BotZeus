def collect_pivots_k(df, mult):
    """Seperti collect_pivots, tetapi membawa jenis pivot: 'H' (high) atau 'L' (low)."""
    out = []
    if df is None:
        return out
    H, L = df.high.values, df.low.values
    A = atr(df).values
    nn = len(df)
    ph, pl = pivots(H, L, PIV)
    for kind, lst in (("H", ph), ("L", pl)):
        for i, p in lst:
            ai = A[i] if A[i] > 0 else 1.0
            if kind == "H":
                seg = L[i + 1:i + 11]
                react = (p - seg.min()) / ai if len(seg) else 0.0
            else:
                seg = H[i + 1:i + 11]
                react = (seg.max() - p) / ai if len(seg) else 0.0
            age = (nn - i) * mult
            rec = 0.5 + 0.5 * math.exp(-age / ZONE_DECAY)
            w = TF_W[mult] * rec * (0.8 + 0.3 * min(react, 3.0))
            out.append((p, w, age, mult, kind))
    return out


def _tight_bands(pts, cap, max_zones=3):
    """Ambil band terpadat selebar maksimal `cap` dari sekumpulan pivot. Sisa pivot boleh membentuk band kedua/ketiga
    jika bobotnya cukup besar. Return (daftar band, sisa)."""
    rem = sorted(pts, key=lambda q: q[0])
    total = sum(max(q[1], 1e-6) for q in rem)
    out = []
    while rem and len(out) < max_zones:
        best, bw = None, -1.0
        for q in rem:
            win = [r for r in rem if q[0] <= r[0] <= q[0] + cap]
            w = sum(max(r[1], 1e-6) for r in win)
            if w > bw:
                best, bw = win, w
        if out and bw < 0.25 * total:
            break
        out.append(best)
        ids = {id(r) for r in best}
        rem = [r for r in rem if id(r) not in ids]
    return out, rem


def build_zones(m1, m5, m15, a):
    """v25: zona SR sempit tepat di wick pivot (bukan rata-rata melebar). Kekuatan tetap dikumpulkan dari cluster lebar,
    tetapi batas zona hanya band terpadat selebar <= ZONE_CAP_A1 x ATR M1. Chop hanya dihitung jika harga benar-benar
    keluar dari band (tidak lagi menurunkan kekuatan saat harga menempel di zona)."""
    pts = (collect_pivots_k(m1, 1) + collect_pivots_k(m5, 5) + collect_pivots_k(m15, 15)
           + [(p, w, ag, mm, "D") for p, w, ag, mm in daily_points(m15)])
    if not pts or not a > 0:
        return []
    a = float(a)
    pts.sort(key=lambda x: x[0])
    tol = ZONE_PIV_TOL_A1 * a
    groups, cur = [], [pts[0]]
    for q in pts[1:]:
        if q[0] - cur[-1][0] <= tol and q[0] - cur[0][0] <= 2 * tol:
            cur.append(q)
        else:
            groups.append(cur)
            cur = [q]
    groups.append(cur)
    ref = m5 if m5 is not None else m1
    H5, L5, C5 = ref.high.values[-300:], ref.low.values[-300:], ref.close.values[-300:]
    cap, pad, tr = ZONE_CAP_A1 * a, ZONE_PAD_A1 * a, 0.30 * a
    zones = []
    for g in groups:
        gw = sum(max(x[1], 1e-6) for x in g)
        bands, _ = _tight_bands(g, cap)
        for bi, band in enumerate(bands):
            prices = [x[0] for x in band]
            bw = sum(max(x[1], 1e-6) for x in band)
            lo, hi = min(prices) - pad, max(prices) + pad
            if hi - lo < ZONE_MIN_A1 * a:
                m_ = (lo + hi) / 2.0
                lo, hi = m_ - ZONE_MIN_A1 * a / 2.0, m_ + ZONE_MIN_A1 * a / 2.0
            mid = (lo + hi) / 2.0
            st = bw + (0.4 * (gw - bw) if bi == 0 else 0.0)
            ntf = len({x[3] for x in band})
            tfmax = max(x[3] for x in band)
            if ntf >= 3:
                st += 2.5
            elif ntf == 2:
                st += 1.5
            if abs(mid - round(mid / 10) * 10) <= tr:
                st += 2
            elif abs(mid - round(mid / 5) * 5) <= tr:
                st += 1
            if min(x[2] for x in band) <= 120:
                st += 1
            touch = (H5 >= lo) & (L5 <= hi)
            ep = (int(np.sum(touch[1:] & ~touch[:-1])) + int(touch[0])) if len(touch) else 0
            if ep >= 2:
                st += min(ZONE_EP_CAP, ZONE_EP_BONUS * ep)
            sgn = np.where(C5 > hi, 1, np.where(C5 < lo, -1, 0))
            nz = sgn[sgn != 0]
            crosses = int(np.sum(nz[1:] * nz[:-1] < 0)) if len(nz) > 1 else 0
            st -= min(ZONE_CHOP_CAP, ZONE_CHOP_STEP * max(0, crosses - ZONE_CHOP_FREE_M5))
            zones.append({"lo": float(lo), "hi": float(hi), "mid": float(mid), "st": float(max(st, 0.0)),
                          "touches": len(band), "tfs": ntf, "ep": int(ep),
                          "htf": bool(any(x[3] >= 5 for x in band)),
                          "tf": "M15" if tfmax >= 15 else "M5" if tfmax >= 5 else "M1",
                          "nh": int(sum(1 for x in band if x[4] == "H")),
                          "nl": int(sum(1 for x in band if x[4] == "L"))})
    return zones


