def _brk_score(df, a, j, d, kind, side, bias0, ctx):
    """Skor konfirmasi candle pemicu j untuk arah d (+1 BUY, -1 SELL). Dihitung di ruang bullish (mirror)."""
    H, L, O, C = mirror_df(df, d == 1)
    V = df["tick_volume"].values.astype(float)
    n = len(C)
    if j < 25 or j >= n:
        return 0.0, [], set(), 0.0
    rng = max(float(H[j] - L[j]), 1e-9)
    body = float(C[j] - O[j])
    clv = float(C[j] - L[j]) / rng
    score, why, kinds, need = 0.0, [], set(), 0.0

    def add(k, w, txt):
        nonlocal score
        score += w
        kinds.add(k)
        why.append(f"{txt} (+{w:g})")

    if kind == "body":
        if body >= BRK_BODY_ATR * a and clv >= 0.6:
            add("disp", 1.0, "candle breakout body kuat, close di ujung")
        elif body >= 0.35 * a and clv >= 0.5:
            add("disp", 0.4, "candle breakout cukup kuat")
    else:
        lw_ = float(min(O[j], C[j]) - L[j])
        if lw_ >= 0.4 * a and lw_ >= 1.5 * max(abs(body), 0.05 * a) and clv >= 0.6:
            add("disp", 1.6, "penolakan wick di garis pola (jebakan)")
        else:
            return 0.0, [], set(), 0.0
    base = V[max(0, j - 20):j]
    vr = float(V[j] / (base.mean() + 1e-9)) if len(base) >= 8 else 1.0
    if vr >= 1.5:
        add("vol", 1.2, f"volume {vr:.1f}x rata-rata")
    elif vr >= 1.2:
        add("vol", 0.6, f"volume {vr:.1f}x")
    for i in (j, j - 1):
        if (C[i] > O[i] and C[i - 1] < O[i - 1] and C[i] >= O[i - 1] and O[i] <= C[i - 1] + 0.05 * a
                and float(C[i] - O[i]) >= 0.3 * a):
            add("eng", 1.0, "engulfing searah")
            break
    own, ownw = rev_score(side)
    if own >= 0.25:
        add("rev", 0.6 * min(own / 0.6, 1.0), f"bukti pembalikan searah {own * 100:.0f}% ({', '.join(ownw[:2])})")
    opp_side = "SELL" if side == "BUY" else "BUY"
    opp, oppw = rev_score(opp_side)
    if opp >= BRK_OPP_VETO:
        return -9.0, [f"bukti pembalikan lawan {opp * 100:.0f}%"], kinds, 0.0
    if opp >= 0.35:
        score -= 1.2
        why.append(f"bukti pembalikan lawan {opp * 100:.0f}% (-1.2)")
    cons = float(ctx.get("cons", 0.0)) * d
    if cons >= 0.25:
        add("cons", 0.5, f"konsensus MTF searah ({cons:+.2f})")
    elif cons <= -0.35:
        score -= 1.0
        why.append(f"konsensus MTF melawan ({cons:+.2f}) (-1)")
    fa = fc_align(side)
    if fa >= 0.3:
        add("fc", 0.5, f"prediksi arah searah ({fa:+.2f})")
    elif fa <= -0.4:
        score -= 0.8
        why.append(f"prediksi arah melawan ({fa:+.2f}) (-0.8)")
    if ctx.get("htf") == side:
        add("htf", 0.4, "searah tren M15")
    if bias0 == side:
        add("bias", 0.6, "mengikuti bias pola")
    elif bias0 in ("BUY", "SELL"):
        need = BRK_AGAINST_EXTRA
        why.append("breakout MELAWAN bias pola, syarat skor dinaikkan")
    return score, why, kinds, need


def breakout_scan(tick):
    if not BRK_ON or not LAST_CTX or not PAT_LOCK or time.time() - PLAN_TS["t"] > 5:
        return None
    if cache["open"] or PENDING["order"] or time.time() - BRK_LAST["t"] < BRK_RETRY_SEC:
        return None
    ctx = LAST_CTX
    srv = srv_now()
    a1 = float(ctx["a"])
    spread = float(tick.ask - tick.bid)
    if spread > MAX_SPREAD or spread > MAX_SPREAD_R * SL_USD:
        return None
    best = None
    for tfn, Lk in list(PAT_LOCK.items()):
        if tfn not in BRK_TFS or float(Lk.get("quality", 0)) < BRK_MIN_Q:
            continue
        tf = _tfdf(ctx, tfn)
        if tf is None:
            continue
        df, a = tf["df"], (float(tf["a"]) or a1)
        T, sec = df.time.values, TF_SEC[tfn]
        cands = []
        if Lk.get("dir"):
            if Lk.get("break_t"):
                bt = int(Lk["break_t"])
                age = srv - (bt + sec)
                idx = np.where(T == bt)[0]
                if len(idx) and -5 <= age <= BRK_MAX_AGE_SEC[tfn]:
                    cands.append(("body", int(idx[0]), int(Lk["dir"]), bt))
        elif BRK_FAKE_ON and Lk.get("kind") == "lines" and len(T):
            j = len(T) - 1
            tj = int(T[j])
            if srv - (tj + sec) <= BRK_MAX_AGE_SEC[tfn]:
                u, l = _line_at(Lk["up"], tj), _line_at(Lk["lo"], tj)
                hj, lj, cj = float(df.high.values[j]), float(df.low.values[j]), float(df.close.values[j])
                if hj > u + BRK_FAKE_PIERCE_ATR * a and cj <= u:
                    cands.append(("wick", j, -1, tj))
                elif lj < l - BRK_FAKE_PIERCE_ATR * a and cj >= l:
                    cands.append(("wick", j, 1, tj))
        for kind, j, d, trig_t in cands:
            key = f"{tfn}|{Lk['code']}|{Lk['start']}|{kind}|{trig_t}"
            if key in BRK_DONE:
                continue
            side = "BUY" if d == 1 else "SELL"
            if Lk["kind"] == "lines":
                ln = _line_at(Lk["up"] if (d == 1) == (kind == "body") else Lk["lo"], srv)
            else:
                ln = _line_at(Lk["neck"], srv)
            px = float(tick.ask if d == 1 else tick.bid)
            moved = (px - ln) * d / a
            if moved < -0.15 or moved > BRK_MAX_CHASE_ATR:
                continue                                       # sudah kembali ke dalam / sudah terlalu jauh
            score, why, kinds, extra = _brk_score(df, a, j, d, kind, side, Lk.get("bias0", Lk.get("bias")), ctx)
            core = len(kinds & {"disp", "vol", "eng", "rev"})
            if score < BRK_MIN_SCORE + extra or core < BRK_MIN_KINDS:
                continue
            blocked = None
            for z in (ctx.get("strong") or []):
                if z["st"] < 6.0:
                    continue
                if d == 1 and 0 < z["lo"] - px < BRK_ROOM_ATR * a:
                    blocked = f"area resistance {z['lo']:.2f}-{z['hi']:.2f} tepat di depan"
                if d == -1 and 0 < px - z["hi"] < BRK_ROOM_ATR * a:
                    blocked = f"area support {z['lo']:.2f}-{z['hi']:.2f} tepat di depan"
            if blocked or mm_blocked(side, ln - 0.3 * a, ln + 0.3 * a, srv):
                continue
            if best is None or score > best[0]:
                best = (score, why, kind, d, side, tfn, Lk, key, ln, a)
    if best is None:
        return None
    score, why, kind, d, side, tfn, Lk, key, ln, a = best
    info = mt5.symbol_info(SYMBOL)
    if info is None:
        return None
    pw = min(0.85, 0.45 + 0.06 * score)
    ev = LEARNER.ev_r(pw, (spread + SLIPPAGE_USD + FEE_USD) / SL_USD)
    nm = ("Breakout " if kind == "body" else "Jebakan ") + Lk["name"]
    f = dict(id=f"BO{int(srv)}", side=side, code="BO", name=nm, tf=tfn, score=int(round(score * 10)),
             p=round(pw * 100, 1), ev=round(ev, 2), n=0, tags=[nm] + why[:5], regime=ctx["regime"],
             zone_lo=round(ln - 0.3 * a, 2), zone_hi=round(ln + 0.3 * a, 2), atr=round(float(ctx["a"]), 3),
             anchored=True, bias=ctx["bias"], ep=0, prio=3, rr=0.0, exec=False,
             tk=f"{nm} [{tfn}]: " + ", ".join(why[:3]))
    BRK_LAST["t"] = time.time()
    log(f"[BREAKOUT] {side} {nm} [{tfn}] garis {ln:.2f}, skor {score:.1f}, P~{pw * 100:.0f}%: " + "; ".join(why[:6]))
    msg = open_market(f, f, info)
    if f.get("exec"):
        BRK_DONE[key] = time.time()
        for k in [k for k, t in BRK_DONE.items() if time.time() - t > 7200]:
            BRK_DONE.pop(k, None)
    return msg


