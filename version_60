def pattern_against(s):
    """Pola garis (segitiga, wedge, channel, rectangle) di M5/M15 yang MASIH TERBENTUK dan berbias lawan.
    BUY ditolak jika zona ada di paruh ATAS pola berbias SELL (mis. Rising Wedge).
    SELL ditolak jika zona ada di paruh BAWAH pola berbias BUY (mis. Falling Wedge).
    Return teks alasan, atau None."""
    if not PAT_AGAINST_ON:
        return None
    a = float(s.get("atr") or 1.0)
    mid = (float(s["zone_lo"]) + float(s["zone_hi"])) / 2.0
    for tf, Lk in list(PAT_LOCK.items()):
        if Lk.get("kind") != "lines" or Lk.get("dir") != 0:
            continue
        if tf not in ("M5", "M15") or float(Lk.get("quality", 0)) < PAT_AGAINST_MIN_Q:
            continue
        if Lk.get("bias") not in ("BUY", "SELL") or Lk["bias"] == s["side"]:
            continue
        lo, hi = float(Lk["zone_lo"]), float(Lk["zone_hi"])
        if hi - lo <= 0 or not (lo - 0.5 * a <= mid <= hi + 0.5 * a):
            continue
        frac = (mid - lo) / (hi - lo)
        if s["side"] == "BUY" and frac >= 0.5:
            return (f"melawan pola {Lk['name']} [{tf}] berbias SELL: zona di paruh atas pola "
                    f"({frac * 100:.0f}%), tunggu konfirmasi atau breakout")
        if s["side"] == "SELL" and frac <= 0.5:
            return (f"melawan pola {Lk['name']} [{tf}] berbias BUY: zona di paruh bawah pola "
                    f"({frac * 100:.0f}%), tunggu konfirmasi atau breakout")
    return None

def _line_at(g, t):
    t1, t2 = g["t1"], g["t2"]
    if t2 == t1:
        return float(g["p1"])
    return float(g["p1"]) + (float(g["p2"]) - float(g["p1"])) * (t - t1) / (t2 - t1)


def _pat_dead(nm, x, a):
    now = time.time()
    PAT_DEAD[:] = [d for d in PAT_DEAD if d["until"] > now]
    return any(d["tf"] == nm and d["code"] == x["code"]
               and x["zone_lo"] <= d["hi"] + a and d["lo"] <= x["zone_hi"] + a for d in PAT_DEAD)


