def _bounce_stats(df, a_tf, zlo, zhi, buy, win=12, target=0.9):
    """Riwayat reaksi harga di zona yang PERSIS sama. Tiap kali harga masuk zona dari sisi datang:
    bertahan = pantul >= target ATR sebelum close menembus; gagal = close menembus lebih dulu.
    Return (bertahan, gagal, rata2 pantulan USD, pantulan terbesar USD)."""
    H, L, O, C = mirror_df(df, buy)
    zl, zh = (zlo, zhi) if buy else (-zhi, -zlo)
    n = len(C)
    if n < 60 or not a_tf > 0:
        return 0, 0, 0.0, 0.0
    touch = (L <= zh) & (H >= zl)
    holds = fails = 0
    mfes = []
    i = 1
    while i < n - 1:
        if touch[i] and (not touch[i - 1]) and C[i - 1] > zh:
            low_run, best, held, failed = float(L[i]), 0.0, False, False
            for j in range(i, min(i + win, n - 1) + 1):
                low_run = min(low_run, float(L[j]))
                if (not held) and C[j] < zl - 0.3 * a_tf:
                    failed = True
                    break
                best = max(best, float(H[j]) - low_run)
                if j > i and best >= target * a_tf:
                    held = True
            if held:
                holds += 1
                mfes.append(best)
            elif failed:
                fails += 1
            i += max(win // 2, 3)
        else:
            i += 1
    return holds, fails, (float(np.mean(mfes)) if mfes else 0.0), (float(max(mfes)) if mfes else 0.0)


_DOSS_CACHE = {"bar": 0, "d": {}}


def zone_dossier(side, zlo, zhi, ctx):
    bar = int(ctx["T"][-1])
    if _DOSS_CACHE["bar"] != bar:
        _DOSS_CACHE.update(bar=bar, d={})
    key = (side, round(float(zlo), 2), round(float(zhi), 2))
    hit = _DOSS_CACHE["d"].get(key)
    if hit is not None:
        return hit
    buy = side == "BUY"
    t5, t15 = _tfdf(ctx, "M5"), _tfdf(ctx, "M15")
    a1 = float(ctx["a"])
    a5 = float(t5["a"]) if t5 else 1.5 * a1
    a5 = a5 if a5 > 0 else 1.5 * a1
    a15 = float(t15["a"]) if t15 else 2.0 * a1
    h = f = mfe_sum = mfe_w = mx = 0.0
    for df, a_tf, wt in ((ctx["m1"], a1, 0.6),
                         (t5["df"] if t5 else None, a5, 1.0),
                         (t15["df"] if t15 else None, a15, 1.5)):
        if df is None or not a_tf > 0:
            continue
        ho, fa, avg_usd, mx_usd = _bounce_stats(df, a_tf, zlo, zhi, buy)
        h += wt * ho
        f += wt * fa
        if ho:
            mfe_sum += wt * ho * avg_usd
            mfe_w += wt * ho
        mx = max(mx, mx_usd)
    n = h + f
    d = dict(hold=h, fail=f, n=n, hr=(h + 1.0) / (n + 2.0),
             avg=(mfe_sum / mfe_w / a5) if mfe_w > 0 else 0.0, mx=mx / a5)
    _DOSS_CACHE["d"][key] = d
    return d


def area_conviction(x, ctx, s=None):
    """Keyakinan 0-100 bahwa zona ini akan MEMBALIKKAN harga. Hanya bukti struktural (tanpa momentum M1/M5)."""
    side = x["side"]
    sg = 1 if side == "BUY" else -1
    a = float(ctx["a"])
    zlo, zhi = float(x["zone_lo"]), float(x["zone_hi"])
    d = zone_dossier(side, zlo, zhi, ctx)
    parts, notes = {}, []
    parts["struktur"] = 22.0 * _c((float(x.get("ss", 0.0)) - 20.0) / 65.0, 0.0, 1.0)
    if d["n"] >= 1.0:
        react = 0.6 * d["hr"] + 0.4 * _c(d["avg"] / 3.0, 0.0, 1.0)
        notes.append(f"pantulan: {d['hr'] * 100:.0f}% bertahan dari {d['n']:.0f} sentuhan (rata2 {d['avg']:.1f} ATR M5)")
    else:
        react = 0.50 if x.get("code") in ("SD", "OB") else 0.42
        notes.append("zona segar / belum pernah diuji")
    parts["reaksi"] = 24.0 * react
    parts["asal"] = 12.0 * _c(d["mx"] / 4.0, 0.0, 1.0)
    if d["mx"] >= 2.0:
        notes.append(f"pernah memantulkan harga {d['mx']:.1f} ATR M5")
    v = sg * (1.0 * _sg(ctx["t60"]) + 1.5 * _sg(ctx["htf"]) + 1.0 * _sg(ctx["st15"]["s"]))
    parts["htf"] = 14.0 * _c((v + 3.5) / 7.0, 0.0, 1.0)
    cf = 0.22 * len(x.get("confl") or [])
    if s:
        cf += 0.25 * len(s.get("combo") or [])
    z = _zone_for(x, ctx, a)
    if z:
        cf += 0.30 * (1 if z.get("h1") else 0) + 0.12 * max(0, int(z.get("tfs", 1)) - 1)
        if z.get("h1"):
            notes.append("berimpit pivot H1")
    parts["konfluens"] = 12.0 * min(1.0, cf)
    pdx = float(s.get("pdx", 0.5)) if s else 0.5
    fx = (s.get("fx") or {}) if s else {}
    loc = (0.45 * pdx + 0.30 * _c(float(fx.get("liq", 0.0)), 0.0, 1.0)
           + 0.25 * _c((float(fx.get("value", 0.0)) + 1.0) / 2.0, 0.0, 1.0))
    parts["lokasi"] = 10.0 * loc
    parts["ruang"] = 6.0 * (1.0 if (s is None or s.get("room_ok", True)) else 0.3)
    cv = _c(sum(parts.values()), 0.0, 100.0)
    return float(cv), parts, notes


