            if prev is None:
                cv = raw
            else:
                tau = COMMIT_CV_RISE_TAU if raw > prev else COMMIT_CV_FALL_TAU
                cv = prev + (1.0 - math.exp(-dt / tau)) * (raw - prev)
            if x.get("commit"):
