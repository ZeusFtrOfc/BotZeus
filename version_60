def _tfdf(ctx, name):
    return next((t for t in ctx["tfs"] if t["name"] == name), None)


def _area_tf(s):
    tf = str(s.get("tf") or "M5")
    return tf if tf in ("M1", "M5", "M15") else "M5"


def _same_zone(x, side, code, lo, hi, a):
    return (x["side"] == side and x["code"] == code
            and lo <= x["zone_hi"] + 0.3 * a and x["zone_lo"] <= hi + 0.3 * a)


def _gap(k, x):
    return max(k["zone_lo"] - x["zone_hi"], x["zone_lo"] - k["zone_hi"], 0.0)


def _area_q(x):
    tfw = {"M15": 6.0, "M5": 3.0, "M1": 0.0}.get(x["tf"], 0.0)
    prio = (6 - STRAT_PRIO.get(x["code"], 5)) * 0.8
    return 0.5 * x["ss"] + 0.5 * x["ps"] + tfw + prio + (6.0 if x.get("shown") else 0.0)


def _birth_ok(s, a, bar, now):
    lo, hi = float(s["zone_lo"]), float(s["zone_hi"])
    p = next((q for q in AREA_PEND if q["side"] == s["side"] and q["code"] == s["code"]
              and lo <= q["hi"] + 0.3 * a and q["lo"] <= hi + 0.3 * a), None)
    if p is None:
        p = dict(side=s["side"], code=s["code"], lo=lo, hi=hi, n=1, bar=bar, t=now)
        AREA_PEND.append(p)
    elif p["bar"] != bar:
        p["n"] += 1
        p["bar"] = bar
    p["t"] = now
    return float(s.get("dist_atr", 0.0)) >= MARK_BIRTH_FAR_ATR or p["n"] >= MARK_BIRTH_BARS


def registry_update(setups, ctx, now):
    """Dipanggil tiap analisis setelah semua penilaian. Mencocokkan setup ke area yang sudah ada,
    MEMBEKUKAN batas zona (zona tidak bergeser), memperbarui P/kekuatan (smooth), dan melahirkan area baru."""
    a = float(ctx["a"])
    bar = int(ctx["T"][-1])
    AREA_PEND[:] = [q for q in AREA_PEND if now - q["t"] < 180][-60:]
    for s in setups:
        side, code = s["side"], s["code"]
        lo, hi = float(s["zone_lo"]), float(s["zone_hi"])
        x = next((q for q in AREA_REG if _same_zone(q, side, code, lo, hi, a)), None)
        if x is None:
            if float(s.get("strength", 0.0)) < MARK_MIN_STRENGTH or float(s["p"]) < MARK_ENTER_P * 100:
                continue
            if not _birth_ok(s, a, bar, now):
                continue
            AREA_SEQ["n"] += 1
            x = dict(aid=f"{side[0]}{code}{round(lo * 100)}", seq=AREA_SEQ["n"], side=side, code=code,
                     tf=_area_tf(s), name=s["name"], zone_lo=round(lo, 2), zone_hi=round(hi, 2),
                     born=now, last_seen=now, elig_t=0.0, touches=0, ps=float(s["p"]),
                     ss=float(s.get("strength", 0.0)), chk_t=0, chk1=0, in_touch=False, setup=None,
                     shown=False, hidden=True, q=0.0, dist_atr=float(s.get("dist_atr", 0.0)))
            AREA_REG.append(x)
        else:
            al = 1.0 - math.exp(-max(0.0, now - x["last_seen"]) / AREA_P_TAU)
            x["ps"] += al * (float(s["p"]) - x["ps"])
            x["ss"] += al * (float(s.get("strength", 0.0)) - x["ss"])
            x["last_seen"] = now
            x["name"] = s["name"]
            tf = _area_tf(s)
            if TF_RANK.get(tf, 0) > TF_RANK.get(x["tf"], 0):
                x["tf"] = tf
        # bekukan geometri: setup yang dipakai fokus/limit memakai zona yang sama dengan tanda di chart
        zlo, zhi = x["zone_lo"], x["zone_hi"]
        ent = zhi if side == "BUY" else zlo
        slp, _sld, _ok = structural_sl(side, zlo, zhi, ent, float(s.get("atr") or a))
        s.update(zone_lo=zlo, zone_hi=zhi, entry=round(ent, 2), sl=round(slp, 2), id=x["aid"])
        x["setup"] = s
        if s["eligible"]:
            x["elig_t"] = now


def registry_sticky(setups, ctx, now):
    """Histeresis eligibility: area yang baru saja lolos tidak gugur karena gerbang lunak yang bergoyang."""
    a = float(ctx["a"])
    for s in setups:
        if s["eligible"]:
            continue
        x = next((q for q in AREA_REG if _same_zone(q, s["side"], s["code"], s["zone_lo"], s["zone_hi"], a)), None)
        if x is None or now - x["elig_t"] > AREA_STICKY_SEC:
            continue
        if float(s.get("dist_atr", 0.0)) > MAX_DIST_ATR * 1.5:
            continue
        if [g for g in s["gates"] if g.startswith(HARD_GATES)]:
            continue
        s["gates_soft"] = list(s["gates"])
        s["gates"] = []
        s["eligible"] = True
        s["room_ok"] = True
        s["tags"] = list(s["tags"]) + [f"eligibilitas dipertahankan (lolos {now - x['elig_t']:.0f} dtk lalu)"]


def _area_check(x, ctx):
    """Satu-satunya cara area dinyatakan tembus: CLOSE candle (TF area, atau M1 sangat dalam). Hitung juga sentuhan."""
    buy = x["side"] == "BUY"
    lo, hi = x["zone_lo"], x["zone_hi"]
    a1 = float(ctx["a"])
    m1 = ctx["m1"]
    T1, C1, H1, L1 = m1.time.values, m1.close.values, m1.high.values, m1.low.values
    tf = _tfdf(ctx, x["tf"]) or _tfdf(ctx, "M5")
    df = tf["df"]
    T, C = df.time.values, df.close.values
    if not x.get("chk1") or not x.get("chk_t"):
        x["chk1"], x["chk_t"] = int(T1[-1]), int(T[-1])
        return None
    reason = None
    for j in np.where(T1 > x["chk1"])[0]:
        c = float(C1[j])
        touch = bool(L1[j] <= hi and H1[j] >= lo)
        if touch and not x.get("in_touch"):
            x["touches"] = int(x.get("touches", 0)) + 1
        x["in_touch"] = touch
        if (buy and c < lo - AREA_FAST_BREAK_ATR * a1) or ((not buy) and c > hi + AREA_FAST_BREAK_ATR * a1):
            reason = "close M1 menembus dalam"
    x["chk1"] = int(T1[-1])
    atf = float(tf["a"]) if float(tf["a"]) > 0 else a1
    brk = AREA_BREAK_ATR.get(x["tf"], 0.35) * atf
    for j in np.where(T > x["chk_t"])[0]:
        c = float(C[j])
        if (buy and c < lo - brk) or ((not buy) and c > hi + brk):
            reason = reason or f"close {x['tf']} menembus sisi jauh"
    x["chk_t"] = int(T[-1])
    return reason


def registry_maintain(ctx, now, new_bar):
    a = float(ctx["a"])
    px = float(ctx["m1"].close.iloc[-1])
    if new_bar:
        for x in list(AREA_REG):
            try:
                why = _area_check(x, ctx)
            except Exception:
                log_exc("area_check")
                why = None
            if why:
                AREA_REG.remove(x)
                BROKEN.append({"side": x["side"], "zone_lo": x["zone_lo"], "zone_hi": x["zone_hi"],
                               "until": now + BROKEN_BLOCK_MIN * 60})
                log(f"[AREA] TEMBUS {x['side']} {x['name']} [{x['tf']}] {x['zone_lo']}-{x['zone_hi']}: {why}")
    for x in list(AREA_REG):
        miss = now - x["last_seen"]
        consumed = (x["touches"] > 0 and x["code"] in ("BR", "RBS", "SBR", "OB", "SD", "PL")
                    and miss > AREA_CONSUMED_SEC)
        if miss > AREA_GRACE_SEC.get(x["tf"], 600) or consumed:
            AREA_REG.remove(x)
            log(f"[AREA] HILANG {x['side']} {x['name']} [{x['tf']}] {x['zone_lo']}-{x['zone_hi']}: "
                f"{'sudah terpakai (disentuh lalu hilang)' if consumed else 'tidak terdeteksi lagi'}")
    for x in AREA_REG:
        buy = x["side"] == "BUY"
        x["dist_atr"] = max(0.0, (px - x["zone_hi"]) if buy else (x["zone_lo"] - px)) / a
        x["q"] = _area_q(x)
    AREA_REG.sort(key=lambda q: -q["q"])
    del AREA_REG[60:]
    kept, cnt, gap = [], {}, MARK_CLUSTER_ATR * a
    for x in AREA_REG:
        show = x["setup"] is not None
        thr = (MARK_KEEP_P if x.get("shown") else MARK_ENTER_P) * 100
        if x["ps"] < thr:
            show = False
        if x["dist_atr"] > AREA_VIEW_MAX_ATR.get(x["tf"], 20.0):
            show = False
        if show and any(k["side"] == x["side"] and _gap(k, x) <= gap for k in kept):
            show = False                                   # ada area sesisi yang lebih kuat di dekatnya
        key = (x["tf"], x["side"])
        if show and cnt.get(key, 0) >= AREA_MAX_PER_TF_SIDE:
            show = False
        if show:
            kept.append(x)
            cnt[key] = cnt.get(key, 0) + 1
            if not x.get("logged"):
                x["logged"] = True
                log(f"[AREA] DITANDAI {x['side']} {x['name']} [{x['tf']}] {x['zone_lo']}-{x['zone_hi']} "
                    f"P {x['ps']:.0f}% kuat {x['ss']:.0f} jarak {x['dist_atr']:.1f} ATR")
