def plan_supply_demand(H, L, O, C, Av, a, n):
    """Zona supply-demand (ruang bullish = DEMAND; SELL sudah dicerminkan = SUPPLY).
    Base 1-3 candle kecil, lalu candle departure besar yang menembus high terdekat (BOS), harga menjauh
    minimal SD_MOVE_ATR, zona belum jebol, dan diuji paling banyak SD_MAX_TOUCH kali (zona segar = terkuat).
    Return [(zl, zh, depart_atr, jumlah_tes)]."""
    out = []
    if n < 40 or not a > 0:
        return out
    for j in range(n - 3, max(n - 3 - SD_MAX_AGE, 25), -1):
        body = C[j] - O[j]
        if body < SD_DEPART_ATR * Av[j]:
            continue
        base = []
        for m in range(1, SD_BASE_MAX + 1):
            i = j - m
            if i < 1:
                break
            if (H[i] - L[i]) <= 0.9 * body and abs(C[i] - O[i]) <= 0.7 * body:
                base.append(i)
            else:
                break
        if not base:
            continue
        b0 = base[-1]
        lo_i = max(0, b0 - SD_BREAK_BARS)
        if b0 - lo_i < 3 or C[j] <= H[lo_i:b0].max():
            continue                                   # departure harus menembus high terdekat
        zl = float(min(L[i] for i in base))
        zh = float(max(max(O[i], C[i]) for i in base))
        zh = max(zh, zl + 0.2 * a)
        if zh - zl > SD_MAX_W_ATR * a:
            continue
        depart = (float(H[j:min(n - 1, j + 4)].max()) - zh) / a
        if depart < SD_MOVE_ATR:
            continue
        if (C[j + 1:n - 1] < zl - 0.3 * a).any():
            continue                                   # zona sudah jebol
        seg = L[j + 3:n - 1]
        ep = 0
        if len(seg):
            touch = seg <= zh
            ep = int(np.sum(touch[1:] & ~touch[:-1])) + int(touch[0])
        if ep > SD_MAX_TOUCH:
            continue
        if any(zl <= q[1] + 0.3 * a and q[0] <= zh + 0.3 * a for q in out):
            continue
        out.append((zl, zh, float(depart), ep))
        if len(out) >= 3:
            break
    return out
 
 
def pattern_entry_zones(side, ctx):
    """Area entry yang diturunkan dari chart pattern terkunci, hanya untuk sisi yang SEJALAN dengan bias pola.
    - Rising wedge / desc triangle / desc channel (bias SELL): SELL di garis ATAS (tolakan harga).
    - Falling wedge / asc triangle / asc channel (bias BUY): BUY di garis BAWAH.
    - Double/Triple Bottom & Inverse H&S yang sedang terbentuk: BUY di retest dasar ke-2/terakhir.
    - Pola yang sudah breakout: entry di retest garis/neckline yang ditembus."""
    out = []
    if not PL_ON:
        return out
    buy = side == "BUY"
    t_now = int(ctx["T"][-1]) + 60
    for tf, Lk in list(PAT_LOCK.items()):
        q = float(Lk.get("quality", 0))
        if q < PL_MIN_Q:
            continue
        bias = Lk.get("bias")
        if bias in ("BUY", "SELL") and bias != side:
            continue
        a_tf = next((float(x["a"]) for x in ctx["tfs"] if x["name"] == tf), float(ctx["a"]))
        a_tf = a_tf if a_tf > 0 else float(ctx["a"])
        zl = zh = None
        why = ""
        if Lk["kind"] == "lines":
            u, l = _line_at(Lk["up"], t_now), _line_at(Lk["lo"], t_now)
            if u <= l:
                continue
            if Lk["dir"] == 0:
                if buy:
                    zl, zh, why = l - 0.25 * a_tf, l + 0.35 * a_tf, "tolakan garis bawah pola"
                else:
                    zl, zh, why = u - 0.35 * a_tf, u + 0.25 * a_tf, "tolakan garis atas pola"
            elif Lk["dir"] == 1 and buy:
                zl, zh, why = u - 0.35 * a_tf, u + 0.25 * a_tf, "retest garis atas setelah breakout"
            elif Lk["dir"] == -1 and not buy:
                zl, zh, why = l - 0.25 * a_tf, l + 0.35 * a_tf, "retest garis bawah setelah breakdown"
        else:
            nk = _line_at(Lk["neck"], t_now)
            if Lk["dir"] == 0:
                ext = Lk.get("ext")
                if ext is None:
                    continue
                if buy:
                    zl, zh, why = ext - 0.1 * a_tf, ext + 0.5 * a_tf, "retest dasar pola (prediksi pembalikan naik)"
                else:
                    zl, zh, why = ext - 0.5 * a_tf, ext + 0.1 * a_tf, "retest puncak pola (prediksi pembalikan turun)"
            else:
                zl, zh, why = nk - 0.3 * a_tf, nk + 0.3 * a_tf, "retest neckline setelah breakout"
        if zl is None:
            continue
        out.append(dict(zl=float(zl), zh=float(zh), tf=tf, q=q, name=Lk["name"], why=why, anch=tf != "M1"))
    return out
 
 
def pattern_against(s, ctx):
    """Tolak entry yang melawan chart pattern terkunci (M1/M5/M15).
    - Pola garis berbias SELL (mis. Rising Wedge) masih terbentuk: BUY ditolak kecuali zonanya sudah
      >= PAT_ESCAPE_ATR di BAWAH garis bawah pola (target breakdown). Cermin untuk pola berbias BUY.
    - Pola reversal (DB/TB/IHS dan kebalikannya): sisi lawan ditolak di dalam rentang pola.
    - Pola sudah breakout: seluruh sisi lawan ditolak selama pola masih disimpan."""
    if not PAT_AGAINST_ON:
        return None
    side = s["side"]
    buy = side == "BUY"
    mid = (float(s["zone_lo"]) + float(s["zone_hi"])) / 2.0
    t_now = int(ctx["T"][-1]) + 60
    for tf, Lk in list(PAT_LOCK.items()):
        if float(Lk.get("quality", 0)) < PAT_AGAINST_MIN_Q:
            continue
        bias = Lk.get("bias")
        if bias not in ("BUY", "SELL") or bias == side:
            continue
        a_tf = next((float(x["a"]) for x in ctx["tfs"] if x["name"] == tf), float(ctx["a"]))
        nm = Lk["name"]
        if Lk["dir"] != 0:
            return f"melawan breakout {nm} [{tf}] ke arah {bias}"
        if Lk["kind"] == "lines":
            u, l = _line_at(Lk["up"], t_now), _line_at(Lk["lo"], t_now)
            if buy and mid > l - PAT_ESCAPE_ATR * a_tf:
                return f"BUY melawan pola {nm} [{tf}] berbias SELL, cari area SELL di garis atas pola"
            if (not buy) and mid < u + PAT_ESCAPE_ATR * a_tf:
                return f"SELL melawan pola {nm} [{tf}] berbias BUY, cari area BUY di garis bawah pola"
        else:
            ext = Lk.get("ext")
            if ext is None:
                continue
            nk = _line_at(Lk["neck"], t_now)
            if bias == "BUY" and (not buy) and ext - 0.2 * a_tf <= mid <= nk + 0.5 * a_tf:
                return f"SELL melawan pola {nm} [{tf}] berbias BUY (pembalikan naik sedang terbentuk)"
            if bias == "SELL" and buy and nk - 0.5 * a_tf <= mid <= ext + 0.2 * a_tf:
                return f"BUY melawan pola {nm} [{tf}] berbias SELL (pembalikan turun sedang terbentuk)"
            
def refine_setups(setups, ctx):
    """Dipanggil setelah BUY dan SELL dipindai. v16:
    1) konsensus MTF (tren + struktur + chart pattern) menolak sisi yang berlawanan,
    2) probabilitas dikoreksi: posisi di range (makin ekstrem makin besar), konsensus, dan pelajaran dari
       sinyal bayangan (bucket kode+arah+posisi range, kode+kekuatan),
    3) pola garis/reversal yang berlawanan menolak entry, guard whipsaw setelah kalah,
    4) hanya area terbaik yang dipertahankan (area bertumpuk digabung ke yang terbaik)."""
    allowed = ctx.get("allowed")
    a = float(ctx["a"])
    cons, ctxt = mtf_consensus(ctx)
    ctx["cons"], ctx["cons_txt"] = cons, ctxt
    _log_cons(cons, ctxt)
    cost_usd = float(ctx["spread"]) + SLIPPAGE_USD + FEE_USD
    for s in setups:
        buy = s["side"] == "BUY"
        align = cons * (1 if buy else -1)
        s["align"] = round(align, 2)
        s["strength"] = area_strength(s)
        counter = bool(allowed) and s["side"] != allowed
        s["counter_trend"] = counter
 
        # --- probabilitas v16
        e = zone_extremity(s["side"], s["zone_lo"], s["zone_hi"], ctx)
        s["pdx"], s["pdb"], s["stb"] = round(e, 2), pd_band(e), st_band(s["strength"])
        pd_adj_v = PD_P_MAX * (2.0 * e - 1.0)
        learned = LEARNER.ctx_delta(s["code"], s["side"], s["pdb"], s["stb"])
        pw = float(s["pw"]) + pd_adj_v + CONS_P * align + learned
        pw = min(0.90, max(0.20, pw))
        ev = LEARNER.ev_r(pw, cost_usd / max(float(s["sl_d"]), 0.5))
        s["pw"], s["p"], s["ev"] = pw, round(pw * 100, 1), round(ev, 2)
        if abs(pd_adj_v) >= 0.02:
            s["tags"].append(f"{'discount' if buy else 'premium'} {e * 100:.0f}% dari range ({pd_adj_v * 100:+.0f}% P)")
        if abs(learned) >= 0.01:
            s["tags"].append(f"belajar hasil/bayangan ({learned * 100:+.0f}% P)")
 
        # --- gerbang
        gates = [g for g in s["gates"] if not g.startswith("probabilitas")]
        if FIXED_MODE:
            gates = [g for g in gates if not g.startswith("pola ini terbukti rugi")]
        pmin = SMART_MIN_P if SMART_MODE else eff_min_p(MIN_P)
        if pw < pmin:
            gates.append(f"probabilitas {pw * 100:.0f}% < {pmin * 100:.0f}%")
        if s["strength"] < MIN_STRENGTH_ELIG:
            gates.append(f"kekuatan area {s['strength']:.0f} < {MIN_STRENGTH_ELIG:.0f}")
        if CONS_ON and align <= -CONS_GATE:
            gates.append(f"melawan {ctxt}")
        pa = pattern_against(s, ctx)
        if pa:
            gates.append(pa)
        wr = whipsaw_reason(s["side"], align)
        if wr:
            gates.append(wr)
 
        rank = (RANK_P_W * float(s["p"]) + RANK_STRENGTH_W2 * s["strength"] + RANK_SCORE_W * float(s["score"])
                + 0.5 * float(s.get("combo_w", 0.0)) + RANK_PRIO_W * (6 - int(s.get("prio", 5)))
                - RANK_DIST_W * min(float(s["dist_atr"]), 5.0) + CONS_RANK * align)
        if counter:
            rank -= COUNTER_RANK_PEN
            if s["strength"] < COUNTER_MIN_STRENGTH:
                gates.append(f"melawan tren M15: kekuatan {s['strength']:.0f} < {COUNTER_MIN_STRENGTH:.0f}")
        s["gates"] = gates
        s["eligible"] = not [g for g in gates if ROOM_HARD or not g.startswith("ruang")]
        s["blocked"] = False if FIXED_MODE else s.get("blocked", False)
        s["rank"] = round(rank, 2)
    smart_v17_refine(setups, ctx)
    relax_room_gate(setups, ctx)        # <- BARU v18
    # --- hanya simpan area terbaik; area bertumpuk digabung (fokus aktif selalu dipertahankan)
    setups.sort(key=lambda s: (not s["eligible"], -s["rank"]))
    P = PLAN_ACTIVE
    kept = []
    for s in setups:
        if P is not None and is_focus_candidate(P, s, a):
            kept.append(s)
            continue
        if any(same_area(k, s, a) for k in kept):
            continue
        kept.append(s)
    setups[:] = kept

