# ---------------------------------------------------------------- 2) LEVEL LIMIT PRESISI
def limit_level(P, a, live=False):
    """v25: limit di dekat tepi zona sempit. Makin yakin makin dangkal. Menempel ke magnet (POC/HVN/VWAP/likuiditas)
    jika ada di jendela sempit. BUY dikompensasi spread (ask = bid + spread). live=True: jika harga sudah melewati
    level dan keyakinan tinggi, pasang limit penangkap wick sedikit lebih dalam."""
    zlo, zhi = float(P["zone_lo"]), float(P["zone_hi"])
    buy = P["side"] == "BUY"
    w = max(zhi - zlo, 0.05 * a)
    conv = conviction(P)
    frac = LIMIT_DEPTH_BY_CODE.get(P.get("code"), LIMIT_DEPTH_FRAC) * (1.0 - LIMIT_CONV_SHALLOW * conv)
    dmax = LIMIT_DEPTH_MAX_ATR * a
    depth = min(frac * w, dmax)
    lvl = (zhi - depth) if buy else (zlo + depth)
    lvl = min(max(lvl, zlo), zhi)

    smx = LAST_CTX.get("smx") if LAST_CTX else None
    if V17_ON and V17_LIMIT_SNAP and smx:
        try:
            lo_w, hi_w = (max(zlo, zhi - dmax), zhi) if buy else (zlo, min(zhi, zlo + dmax))
            cands = [c for c in v17_limit_candidates(P, a, smx, lo_w, hi_w) if c[1] >= V17_LIMIT_MIN_W]
            if cands:
                edge = zhi if buy else zlo
                best = max(cands, key=lambda c: (round(c[1], 2), -abs(c[0] - edge)))
                lvl = min(max(best[0], zlo), zhi)
        except Exception:
            log_exc("limit_snap")

    if buy:
        spr = min(max(float(state.get("spread") or 0.0), 0.0), 0.4)
        lvl = min(lvl + LIMIT_SPREAD_COMP * spr, zhi + 0.05 * a)

    if live and conv >= LIMIT_CATCH_CONV:
        try:
            tk = mt5.symbol_info_tick(SYMBOL)
            if tk is not None:
                px = float(tk.ask if buy else tk.bid)
                inside = zlo - 0.1 * a <= px <= zhi + 0.1 * a
                passed = (px <= lvl + LIMIT_MIN_GAP) if buy else (px >= lvl - LIMIT_MIN_GAP)
                if inside and passed:
                    gap = max(LIMIT_MIN_GAP * 3, LIMIT_CATCH_ATR * a)
                    alt = max(px - gap, zlo) if buy else min(px + gap, zhi)
                    if abs(px - alt) >= LIMIT_MIN_GAP * 2:
                        return alt
        except Exception:
            log_exc("limit_catch")
    return lvl


# ---------------------------------------------------------------- 3) SKOR PANTULAN (RPS)
_REACT_CACHE = {"bar": 0, "d": {}}


def _react_multi(ctx, side, zlo, zhi):
    """Hold rate gabungan M1/M5/M15 untuk zona yang persis sama: berapa kali harga menyentuh lalu bertahan
    (memantul) dibanding menembus. Dikecilkan ke 50% saat data sedikit. Return (hold_rate, jumlah_sentuhan)."""
    bar = int(ctx["T"][-1])
    if _REACT_CACHE["bar"] != bar:
        _REACT_CACHE.update(bar=bar, d={})
    key = (side, round(zlo, 2), round(zhi, 2))
    if key in _REACT_CACHE["d"]:
        return _REACT_CACHE["d"][key]
    buy = side == "BUY"
    num = den = 0.0
    ntot = 0
    for nm, df, a_tf in (("M1", ctx["m1"], float(ctx["a"])),
                         ("M5", (_tfdf(ctx, "M5") or {}).get("df"), float((_tfdf(ctx, "M5") or {}).get("a", 0) or 0)),
                         ("M15", (_tfdf(ctx, "M15") or {}).get("df"), float((_tfdf(ctx, "M15") or {}).get("a", 0) or 0))):
        if df is None or not a_tf > 0:
            continue
        try:
            _, ne, hr = v17_reaction(df, zlo, zhi, a_tf, buy)
        except Exception:
            continue
        wt = V25_REACT_TF_W[nm]
        num += wt * (hr * (ne + 2.0) - 1.0)
        den += wt * ne
        ntot += ne
    res = ((num + 1.0) / (den + 2.0), ntot)
    _REACT_CACHE["d"][key] = res
    return res


def _zone_for(s, ctx, a):
    best, bo = None, -1e9
    for z in list(ctx.get("strong") or []) + list(ctx.get("flipz") or []):
        ov = min(z["hi"], s["zone_hi"]) - max(z["lo"], s["zone_lo"])
        if ov > bo:
            best, bo = z, ov
    return best if (best is not None and bo >= -0.2 * a) else None


def apply_v25(setups, ctx):
    """Skor pantulan (RPS) per setup: riwayat pantulan zona yang sama (M1+M5+M15), presisi zona, bobot timeframe,
    konfluensi, likuiditas, area penopang di belakang, dan kekuatan. RPS mengoreksi P (maks sekitar +-10%) dan peringkat.
    Zona yang terbukti sering jebol saat disentuh diberi gerbang keras."""
    if not setups:
        return
    a = float(ctx["a"])
    pmin = V17_MIN_P if V17_MIN_P is not None else (SMART_MIN_P if SMART_MODE else eff_min_p(MIN_P))
    for s in setups:
        try:
            side = s["side"]
            buy = side == "BUY"
            zlo, zhi = float(s["zone_lo"]), float(s["zone_hi"])
            hr, nrx = _react_multi(ctx, side, zlo, zhi)
            tight = _c(1.0 - ((zhi - zlo) / a - 0.10) / 0.35, 0.0, 1.0)
            tfw = {"M15": 1.0, "M5": 0.6, "M1": 0.25}.get(s.get("tf"), 0.4)
            conf = min(len(s.get("combo") or []), 3) / 3.0
            liq = _c(float((s.get("fx") or {}).get("liq", 0.0)), 0.0, 1.0)
            back = _c(float(s.get("back", 0.0)), 0.0, 1.0)
            st01 = _c(float(s.get("strength", 0.0)) / 100.0, 0.0, 1.0)
            rps = 0.34 * hr + 0.12 * tight + 0.14 * tfw + 0.10 * conf + 0.10 * liq + 0.08 * back + 0.12 * st01
            dp, tags = V25_RPS_W * (rps - V25_RPS_BASE), []
            if s["code"] == "SR":
