def handle_closed_losses(trades):
    """Posisi yang baru tutup: fokus dilepas, stop-out masuk memori kesalahan."""
    global PLAN_ACTIVE
    now_srv = srv_now()
    if not _LOSS_INIT["done"]:
        LOSS_SEEN.update(t["ticket"] for t in trades)
        _LOSS_INIT["done"] = True
        try:
            mm_rebuild(trades, now_srv)
        except Exception:
            log_exc("mm_rebuild")
        return
    for t in trades:
        if t["ticket"] in LOSS_SEEN:
            continue
        LOSS_SEEN.add(t["ticket"])
        meta = db["meta"].get(str(t["ticket"])) or {}
        if t["profit"] <= 0:
            if meta.get("zone_lo") is not None and meta.get("zone_hi") is not None:
                block_area(t["side"], meta["zone_lo"], meta["zone_hi"], AREA_REBLOCK_SEC)
