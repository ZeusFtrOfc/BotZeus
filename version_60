def _c(x, lo=-1.0, hi=1.0):
    return max(lo, min(hi, float(x)))
 
 
def v17_vol_profile(df, bin_size):
    """Volume profile dari tick_volume: volume tiap candle disebar rata sepanjang range high-low.
    Return dict (poc, vah, val, hvn, histogram halus) atau None."""
    if df is None or len(df) < 60 or not bin_size > 0:
        return None
    H = df.high.values.astype(float)
    L = df.low.values.astype(float)
    V = df.tick_volume.values.astype(float) + 1.0
    lo, hi = float(L.min()), float(H.max())
    nb = int(math.ceil((hi - lo) / bin_size)) + 1
    if nb < 8:
        return None
    i0 = np.clip(((L - lo) / bin_size).astype(int), 0, nb - 1)
    i1 = np.clip(((H - lo) / bin_size).astype(int), 0, nb - 1)
    hist = np.zeros(nb)
    for k in range(len(H)):
        hist[i0[k]:i1[k] + 1] += V[k] / (i1[k] - i0[k] + 1)
    sm = np.convolve(hist, [0.25, 0.5, 0.25], mode="same")
    tot = float(sm.sum())
    if tot <= 0:
        return None
    poc = int(np.argmax(sm))
    lo_i = hi_i = poc
    acc = float(sm[poc])
    while acc < 0.70 * tot and (lo_i > 0 or hi_i < nb - 1):      # value area 70%
        dn = float(sm[lo_i - 1]) if lo_i > 0 else -1.0
        up = float(sm[hi_i + 1]) if hi_i < nb - 1 else -1.0
        if up >= dn:
            hi_i += 1
            acc += float(sm[hi_i])
        else:
            lo_i -= 1
            acc += float(sm[lo_i])
    nz = sm[sm > 0]
    p75, p25 = float(np.percentile(nz, 75)), float(np.percentile(nz, 25))
    hvn = [lo + (i + 0.5) * bin_size for i in range(1, nb - 1)
           if sm[i] >= p75 and sm[i] >= sm[i - 1] and sm[i] >= sm[i + 1]]
    return dict(lo=lo, hi=hi, bin=bin_size, hist=sm, poc=lo + (poc + 0.5) * bin_size,
                vah=lo + (hi_i + 1) * bin_size, val=lo + lo_i * bin_size, p75=p75, p25=p25, hvn=hvn)
 
 
def v17_vp_score(prof, zlo, zhi, side):
    """-1..1. Zona di atas HVN/POC/batas value area = penerimaan harga (kuat). Zona di LVN = tipis (lemah)."""
    if prof is None or zhi < prof["lo"] or zlo > prof["hi"]:
        return 0.0, ""
    b, lo, h = prof["bin"], prof["lo"], prof["hist"]
    i0 = int(_c((zlo - lo) / b, 0, len(h) - 1))
    i1 = int(_c((zhi - lo) / b, 0, len(h) - 1))
    seg = h[i0:i1 + 1]
    mean_seg = float(seg.mean())
    dens = mean_seg / max(prof["p75"], 1e-9)
    s = _c((dens - 0.8), -0.5, 0.6)
    why = []
    if dens >= 1.0:
        why.append("HVN")
    if zlo - b <= prof["poc"] <= zhi + b:
        s += 0.3
        why.append("POC")
    edge = prof["val"] if side == "BUY" else prof["vah"]
    if zlo - b <= edge <= zhi + b:
        s += 0.3
        why.append("VAL" if side == "BUY" else "VAH")
    if mean_seg <= prof["p25"]:
        s -= 0.3
        why.append("LVN tipis")
    return _c(s), ("volume profile: " + ",".join(why)) if why else ""
 
 
def v17_vwap(df):
    """VWAP sesi (sejak 00:00 waktu server) dan simpangan baku berbobot volume."""
    T = df.time.values
    day0 = T[-1] - (T[-1] % 86400)
    m = T >= day0
    if int(m.sum()) < 30:
        m = np.zeros(len(T), dtype=bool)
        m[-150:] = True
    tp = ((df.high + df.low + df.close) / 3.0).values.astype(float)[m]
    v = df.tick_volume.values.astype(float)[m] + 1.0
    w = float(v.sum())
    vw = float((tp * v).sum() / w)
    sd = math.sqrt(max(float((((tp - vw) ** 2) * v).sum() / w), 1e-8))
    return vw, sd
 
 
def v17_liquidity(m5, m15, a5):
    """Kolam likuiditas: equal highs/lows (>=2 pivot berhimpit), PDH/PDL, dan high/low sesi hari ini."""
    H, L, T = m5.high.values, m5.low.values, m5.time.values
    nn = len(H)
    lo_i = max(0, nn - 200)
    ph, pl = pivots(H, L, 3)
    tol = 0.25 * a5
    pools = []
 
    def cluster(pts, kind):
        pts = sorted(pts, key=lambda q: q[1])
        i = 0
        while i < len(pts):
            grp, j = [pts[i]], i
            while j + 1 < len(pts) and pts[j + 1][1] - grp[0][1] <= tol:
                j += 1
                grp.append(pts[j])
            if len(grp) >= 2:
                price = max(g[1] for g in grp) if kind == "H" else min(g[1] for g in grp)
                pools.append(dict(p=float(price), kind=kind, w=min(len(grp), 4) / 4.0,
                                  t=int(T[max(g[0] for g in grp)])))
            i = j + 1
 
    cluster([q for q in ph if q[0] >= lo_i], "H")
    cluster([q for q in pl if q[0] >= lo_i], "L")
    dp = daily_points(m15)
    if len(dp) == 2:
        pools.append(dict(p=float(dp[0][0]), kind="H", w=1.0, t=0))
        pools.append(dict(p=float(dp[1][0]), kind="L", w=1.0, t=0))
    day0 = int(T[-1] - (T[-1] % 86400))
    m = T >= day0
    if int(m.sum()) >= 12:
        pools.append(dict(p=float(H[m].max()), kind="H", w=0.6, t=day0))
        pools.append(dict(p=float(L[m].min()), kind="L", w=0.6, t=day0))
    return pools
 
 
def v17_sweeps(m1, pools, a):
    """Sweep likuiditas terbaru di M1: wick menembus kolam lalu close kembali (stop run selesai)."""
    H, L, C, T = m1.high.values, m1.low.values, m1.close.values, m1.time.values
    n = len(C)
    lo_k = max(1, n - V17_SWEEP_BARS)
    out = []
    for pl in pools:
        for k in range(n - 1, lo_k - 1, -1):
            if T[k] <= pl["t"] + 300:
                break
            if pl["kind"] == "L":
                if L[k] < pl["p"] - 0.03 * a and C[k] > pl["p"] and float(C[k:].min()) > pl["p"] - 0.5 * a:
                    out.append(dict(bias="BUY", p=pl["p"], age=int(n - 1 - k)))
                    break
            else:
                if H[k] > pl["p"] + 0.03 * a and C[k] < pl["p"] and float(C[k:].max()) < pl["p"] + 0.5 * a:
                    out.append(dict(bias="SELL", p=pl["p"], age=int(n - 1 - k)))
                    break
    return out
 
 
def v17_liq_score(smx, side, zlo, zhi, a):
    """0..1. Sweep baru di dekat zona = bukti terkuat. Kolam stop tepat di balik sisi jauh zona = bukti sedang."""
    buy = side == "BUY"
    best, why = 0.0, ""
    for sw in smx["sweeps"]:
        if sw["bias"] != side:
            continue
        ok = (zlo - 1.5 * a <= sw["p"] <= zhi + 0.5 * a) if buy else (zlo - 0.5 * a <= sw["p"] <= zhi + 1.5 * a)
        if ok:
            v = 1.0 - 0.6 * sw["age"] / float(V17_SWEEP_BARS)
            if v > best:
                best, why = v, f"sweep likuiditas {sw['p']:.2f} (umur {sw['age']} candle)"
    for pl in smx["pools"]:
        if buy and pl["kind"] == "L" and zlo - 1.2 * a <= pl["p"] <= zlo + 0.2 * a:
            v = 0.35 + 0.25 * pl["w"]
        elif (not buy) and pl["kind"] == "H" and zhi - 0.2 * a <= pl["p"] <= zhi + 1.2 * a:
            v = 0.35 + 0.25 * pl["w"]
        else:
            continue
        if v > best:
            best, why = v, f"kolam stop {pl['p']:.2f} tepat di balik zona"
    return best, why
 
 
def v17_reaction(df5, zlo, zhi, a5, buy):
    """Riwayat reaksi harga di zona ini (M5). Tiap kali harga masuk zona dari atas (ruang bullish), lihat
    apa yang terjadi dalam V17_REACT_WIN candle: pantul >= target = bertahan, close tembus sisi jauh = gagal.
    Return (skor -1..1, jumlah_episode_terputuskan, tingkat_bertahan_terkoreksi)."""
    H, L, O, C = mirror_df(df5, buy)
    zl, zh = (zlo, zhi) if buy else (-zhi, -zlo)
    n = len(C)
    if n < 60 or not a5 > 0:
        return 0.0, 0, 0.5
    touch = (L <= zh) & (H >= zl)
    hold = fail = 0
    for i in range(1, n - 2):
        if (not touch[i]) or touch[i - 1] or C[i - 1] <= zh:
            continue
        low_run, res = float(L[i]), 0
        for j in range(i, min(i + V17_REACT_WIN, n - 1) + 1):
            low_run = min(low_run, float(L[j]))
            if C[j] < zl - V17_REACT_FAIL_ATR5 * a5:
                res = -1
                break
            if j > i and H[j] - low_run >= V17_REACT_TARGET_ATR5 * a5 and C[j] >= zl:
                res = 1
                break
        if res > 0:
            hold += 1
        elif res < 0:
            fail += 1
    ne = hold + fail
    hr = (hold + 1.0) / (ne + 2.0)                    # shrink ke 50% saat data sedikit
    return _c((hr - 0.5) * 2.0), ne, hr
 
 
def v17_approach(m1, buy, a, trig=False):
    """Kualitas pendekatan ke zona (M1). -1 = harga didorong momentum kuat (zona rawan jebol),
    +1 = tenaga habis / ada serapan (volume tinggi + ekor panjang). Ruang bullish; SELL dicerminkan."""
    d = m1.iloc[-30:]
    H, L, O, C = mirror_df(d, buy)
    V = d.tick_volume.values.astype(float) + 1.0
    if len(C) < 12 or not a > 0:
        return 0.0, ""
    k = 5
    drive = float(C[-k - 1] - C[-1]) / a
    rng = float(np.sum(H[-k:] - L[-k:])) + 1e-9
    eff = float(np.sum(np.abs(C[-k:] - O[-k:]))) / rng
    down = int(np.sum(C[-k:] < O[-k:]))
    vr = float(V[-3:].mean() / max(V[:-3].mean(), 1e-9))
    wick = float(min(O[-1], C[-1]) - L[-1]) / (float(H[-1] - L[-1]) + 1e-9)
    s, why = 0.0, []
    if drive >= 1.5:
        s -= 0.6 * min(1.0, (drive - 1.5) / 3.0) + 0.1
        if eff >= 0.65 and down >= 4:
            s -= 0.3
            why.append("dorongan searah kuat")
    elif drive <= 0.8:
        s += 0.1
    if vr >= 1.3 and wick >= 0.45:
        s += 0.6
        why.append("serapan: volume tinggi + ekor penolakan")
    elif vr >= 1.6 and C[-1] < O[-1]:
        s -= 0.3
        why.append("volume menekan tanpa penolakan")
    if trig:
        s += 0.3
        why.append("ada konfirmasi candle")
    return _c(s), ("pendekatan: " + ", ".join(why)) if why else ""
 
 
def v17_flow(m1, buy, a):
    """Proksi order-flow dari tick_volume: delta = CLV x volume. Divergensi: harga bikin low baru tetapi delta
    kumulatif tidak ikut turun = tekanan jual terserap. Ditambah tekanan 10 candle terakhir."""
    d = m1.iloc[-40:]
    H, L, O, C = mirror_df(d, buy)
    V = d.tick_volume.values.astype(float) + 1.0
    if len(C) < 30:
        return 0.0, ""
    rng = np.maximum(H - L, 1e-9)
    dl = ((C - L) - (H - C)) / rng * V
    cd = np.cumsum(dl)
    h = len(C) // 2
    i1 = int(np.argmin(L[:h]))
    i2 = h + int(np.argmin(L[h:]))
    div = float(cd[i2] - cd[i1]) / float(V.sum()) * 8.0
    lower = bool(L[i2] < L[i1] - 0.05 * a)
    press = float(dl[-10:].sum()) / float(V[-10:].sum())
    sc = 0.6 * (div if lower else 0.3 * div) + 0.5 * press
    why = []
    if lower and div > 0.25:
        why.append("divergensi delta searah")
    if press > 0.25:
        why.append("tekanan beli/jual searah")
    elif press < -0.25:
        why.append("tekanan berlawanan")
    return _c(sc), ("order-flow: " + ", ".join(why)) if why else ""
 
 
SMX_CACHE = {"bar": 0, "smx": None}
 
 
def build_smart_ctx(ctx):
    """Konteks pasar v17 (dihitung sekali per candle M1): volume profile, VWAP, kolam likuiditas, sweep."""
    bar = int(ctx["T"][-1])
    if SMX_CACHE["bar"] == bar and SMX_CACHE["smx"] is not None:
        return SMX_CACHE["smx"]
    m5 = next(tf["df"] for tf in ctx["tfs"] if tf["name"] == "M5")
    m15 = next(tf["df"] for tf in ctx["tfs"] if tf["name"] == "M15")
    a5 = float(next(tf["a"] for tf in ctx["tfs"] if tf["name"] == "M5"))
    a5 = a5 if a5 > 0 else float(ctx["a"]) * 1.5
    prof = v17_vol_profile(m5, max(0.1, V17_PROFILE_BIN_ATR5 * a5))
    vw, sd = v17_vwap(m5)
    pools = v17_liquidity(m5, m15, a5)
    smx = dict(m5=m5, a5=a5, prof=prof, vwap=vw, sd=max(sd, 0.25 * a5), pools=pools,
               sweeps=v17_sweeps(ctx["m1"], pools, float(ctx["a"])))
    SMX_CACHE.update(bar=bar, smx=smx)
    return smx
 
 
def v17_features(s, ctx, smx):
    """Fitur bernilai -1..+1 untuk satu setup. Return (dict fitur, daftar catatan)."""
    side = s["side"]
    buy = side == "BUY"
    a = float(ctx["a"])
    zlo, zhi = float(s["zone_lo"]), float(s["zone_hi"])
    mid = (zlo + zhi) / 2.0
    fx, notes = {}, []
    fx["struct"] = _c((float(s.get("strength", 50.0)) - 50.0) / 40.0)
    rs, ne, hr = v17_reaction(smx["m5"], zlo, zhi, smx["a5"], buy)
    fx["react"] = rs
    if ne:
        notes.append(f"reaksi historis: {hr * 100:.0f}% bertahan ({ne} sentuhan)")
    vs, vt = v17_vp_score(smx["prof"], zlo, zhi, side)
    fx["value"] = vs
    if vt:
        notes.append(vt)
    z = ((smx["vwap"] - mid) if buy else (mid - smx["vwap"])) / smx["sd"]
    fx["vwap"] = _c(z / 2.0)
    if abs(z) >= 1.0:
        notes.append(f"{abs(z):.1f} sigma {'di bawah' if z > 0 else 'di atas'} VWAP sesi")
    lq, lt = v17_liq_score(smx, side, zlo, zhi, a)
    fx["liq"] = lq
    if lt:
        notes.append(lt)
    fl, ft = v17_flow(ctx["m1"], buy, a)
    fx["flow"] = fl
    if ft:
        notes.append(ft)
    dist_atr = float(s.get("dist_atr", 0.0))
    prox = 1.0 if dist_atr <= 2.0 else max(0.0, 1.0 - (dist_atr - 2.0) / 2.5)
    ap, at = v17_approach(ctx["m1"], buy, a, bool(s.get("trig")))
    fx["appr"] = _c(ap * prox)
    if at and prox > 0:
        notes.append(at)
    fx["ctx"] = _c(float(s.get("align", 0.0)) / 0.6)
    fx["pd"] = _c((float(s.get("pdx", 0.5)) - 0.5) * 2.0)
    fx["time"] = _c(float(ctx.get("s_adj", 0)) / 4.0)
    fx["sl"] = 0.0          # SL tidak dinilai sama sekali, bot tetap entry di area berprobabilitas tinggi
    return {k: round(float(v), 3) for k, v in fx.items()}, notes
 
 
class SmartModel:
    """Model logistik: P(menang) = sigmoid(b + w . fitur). Bobot awal dari pengetahuan struktur pasar,
    lalu disesuaikan dari hasil nyata + sinyal bayangan dengan regresi logistik yang DITAHAN ke bobot awal
    (L2 ke prior), sehingga data sedikit tidak membuat model liar."""
 
    def __init__(self):
        self.w0 = np.array([V17_PRIOR_W[k] for k in V17_FEATS], dtype=float)
        self.b0 = float(V17_PRIOR_B)
        self.w, self.b = self.w0.copy(), self.b0
        self.n, self.t, self.sig = 0, 0.0, None
 
    def _x(self, fx):
        return np.array([float(fx.get(k, 0.0)) for k in V17_FEATS], dtype=float)
 
    def predict(self, fx):
        z = self.b + float(self.w @ self._x(fx))
        return 1.0 / (1.0 + math.exp(-max(-30.0, min(30.0, z))))
 
    def maybe_fit(self, trades):
        now = time.time()
        if now - self.t < V17_FIT_EVERY_SEC:
            return
        self.t = now
        rec = []
        with dblock:
            for s in db["shadow"]:
                if s.get("done") and s.get("r") is not None and s.get("fx"):
                    rec.append((s.get("close_time") or 0, s["fx"], float(s["r"]), SHADOW_W))
            for t in trades:
                m = db["meta"].get(str(t["ticket"])) or {}
                if m.get("fx") and t.get("r") is not None:
                    rec.append((t.get("close_time") or 0, m["fx"], float(t["r"]), 1.0))
        n = len(rec)
        self.n = n
        if n < V17_FIT_MIN_N:
            return
        sig = (n, round(sum(q[2] for q in rec), 2))
        if sig == self.sig:
            return
        self.sig = sig
        rec.sort(key=lambda q: q[0])
        X = np.array([self._x(q[1]) for q in rec])
        y = np.array([1.0 if q[2] >= LEARN_WIN_R else 0.0 for q in rec])
        w = np.array([(0.5 ** ((n - 1 - i) / V17_HALF_LIFE)) * rec[i][3] for i in range(n)])
        w = w / w.mean()
        Xb = np.hstack([X, np.ones((n, 1))])
        th0 = np.append(self.w0, self.b0)
        th = th0.copy()
        lam = V17_L2 / n
 
        def nll(t_):
            p_ = 1.0 / (1.0 + np.exp(-np.clip(Xb @ t_, -30, 30)))
            p_ = np.clip(p_, 1e-6, 1 - 1e-6)
            return float(np.mean(w * -(y * np.log(p_) + (1 - y) * np.log(1 - p_))))
 
        before = nll(th0)
        for _ in range(400):
            p = 1.0 / (1.0 + np.exp(-np.clip(Xb @ th, -30, 30)))
            g = Xb.T @ (w * (p - y)) / n + 2.0 * lam * (th - th0)
            th = th - V17_LR * g
        th = th0 + np.clip(th - th0, -V17_MAX_DEV, V17_MAX_DEV)
        self.w, self.b = th[:-1].copy(), float(th[-1])
        log(f"[SMART] model belajar dari {n} data: logloss {before:.3f} -> {nll(th):.3f}; bobot "
            + ", ".join(f"{k}={v:+.2f}" for k, v in zip(V17_FEATS, self.w)) + f", b={self.b:+.2f}")
 
 
SMART_MODEL = SmartModel()
 
 
def smart_v17_refine(setups, ctx):
    """Lapisan v17, dipanggil di akhir refine_setups (sebelum area bertumpuk digabung):
    1) hitung fitur bukti, 2) probabilitas model logistik dicampur probabilitas lama,
    3) gerbang: minimal V17_MIN_GROUPS kelompok bukti independen positif + veto reaksi/momentum buruk,
    4) peringkat ikut naik untuk setup dengan bukti beragam."""
    if not V17_ON or not setups:
        return
    try:
        smx = build_smart_ctx(ctx)
    except Exception:
        log_exc("build_smart_ctx")
        return
    ctx["smx"] = smx
    cost_usd = float(ctx["spread"]) + SLIPPAGE_USD + FEE_USD
    pmin = V17_MIN_P if V17_MIN_P is not None else (SMART_MIN_P if SMART_MODE else eff_min_p(MIN_P))
    for s in setups:
        try:
            fx, notes = v17_features(s, ctx, smx)
        except Exception:
            log_exc("v17_features")
            continue
        p_new = SMART_MODEL.predict(fx)
        p_old = float(s["pw"])
        pw = min(0.90, max(0.15, V17_MIX * p_new + (1.0 - V17_MIX) * p_old))
        gp = {g: sum(fx[k] for k in ks) / len(ks) for g, ks in V17_GROUPS.items()}
        npos = sum(1 for v in gp.values() if v >= V17_GROUP_POS)
        ev = LEARNER.ev_r(pw, cost_usd / max(float(s["sl_d"]), 0.5))
        gates = [g for g in s["gates"] if not g.startswith("probabilitas")]
        if pw < pmin:
            gates.append(f"probabilitas {pw * 100:.0f}% < {pmin * 100:.0f}%")
        if npos < V17_MIN_GROUPS:
            gates.append(f"bukti independen hanya {npos}/{len(V17_GROUPS)} kelompok (perlu {V17_MIN_GROUPS})")
        if fx["react"] <= V17_VETO_REACT:
            gates.append("riwayat reaksi zona buruk (sering jebol saat disentuh)")
        if fx["appr"] <= V17_VETO_APPR and not s.get("trig"):
            gates.append("harga didorong momentum kuat menuju zona, tunggu melambat atau ada serapan")
        grade = "A+" if (pw >= 0.70 and npos >= 4) else "A" if (pw >= 0.62 and npos >= 3) else "B"
        s["rank"] = round(float(s["rank"]) + RANK_P_W * (pw * 100.0 - float(s["p"]))
                          + V17_RANK_GROUP * (npos - 2), 2)
        s.update(pw=pw, p=round(pw * 100.0, 1), ev=round(ev, 2), gates=gates, fx=fx,
                 smart=dict(p_new=round(p_new, 3), p_old=round(p_old, 3), groups=npos, grade=grade,
                            gp={k: round(v, 2) for k, v in gp.items()}),
                 eligible=not [g for g in gates if ROOM_HARD or not g.startswith("ruang")])
        s["tags"] = list(s["tags"]) + [f"v17 {grade}: model {p_new * 100:.0f}% | {npos} kelompok bukti"] + notes[:4]
        s["why"] = (s.get("why", "") + f" v17: grade {grade}, model {p_new * 100:.0f}%, "
                    f"{npos} kelompok bukti positif. " + "; ".join(notes[:4]) + ".")
 
 
def v17_limit_candidates(P, a, smx, lo_w, hi_w):
    """Magnet di dalam jendela limit: POC, puncak HVN, VWAP (+/- sigma), kolam likuiditas. [(harga, bobot)]."""
    out = []
    prof = smx.get("prof")
    if prof:
        out.append((prof["poc"], 1.0))
        out += [(p, 0.8) for p in prof["hvn"]]
    out.append((smx["vwap"], 0.6))
    out.append((smx["vwap"] - smx["sd"] if P["side"] == "BUY" else smx["vwap"] + smx["sd"], 0.7))
    for pl in smx["pools"]:
        if (P["side"] == "BUY" and pl["kind"] == "L") or (P["side"] == "SELL" and pl["kind"] == "H"):
            out.append((pl["p"], 0.7 * (0.6 + 0.4 * pl["w"]) + 0.15))
    return [(float(p), float(w)) for p, w in out if lo_w <= p <= hi_w]

def limit_level(P, a):
    """Level limit di DALAM tepi dekat zona. Default per jenis area (v16); v17 menempelkan ke magnet terkuat."""
    zlo, zhi = float(P["zone_lo"]), float(P["zone_hi"])
    w = max(zhi - zlo, 0.1 * a)
    frac = LIMIT_DEPTH_BY_CODE.get(P.get("code"), LIMIT_DEPTH_FRAC)
    back = min(float(P.get("back", 0.0) or 0.0), 1.0)
    frac *= (1.0 - 0.35 * back)
    depth = min(frac * w, LIMIT_DEPTH_MAX_ATR * a)
    lvl = (zhi - depth) if P["side"] == "BUY" else (zlo + depth)
    base = min(max(lvl, zlo), zhi)
    if not (V17_ON and V17_LIMIT_SNAP):
        return base
    smx = LAST_CTX.get("smx") if LAST_CTX else None
    if not smx:
        return base
    try:
        dmax = LIMIT_DEPTH_MAX_ATR * a
        if P["side"] == "BUY":
            lo_w, hi_w = max(zlo, zhi - dmax), zhi
        else:
            lo_w, hi_w = zlo, min(zhi, zlo + dmax)
        cands = v17_limit_candidates(P, a, smx, lo_w, hi_w)
        cands = [c for c in cands if c[1] >= V17_LIMIT_MIN_W]
        if not cands:
            return base
        edge = zhi if P["side"] == "BUY" else zlo
        best = max(cands, key=lambda c: (round(c[1], 2), -abs(c[0] - edge)))
        return min(max(best[0], zlo), zhi)
    except Exception:
        log_exc("limit_snap")
        return base


def important_break_reason(P, anchor, C, a):
    """Fokus belum tersentuh, tetapi area HTF penting yang berada di antara harga dan area fokus
    baru saja DITEMBUS (close) menuju area fokus. Momentum melawan fokus, jadi analisis ulang.
    BUY: support HTF di atas area fokus tembus ke bawah. SELL: resistance HTF di bawah area fokus tembus ke atas."""
    if len(C) < 2:
        return None
    now_c, prev_c = float(C[-1]), float(C[-2])
    buy = P["side"] == "BUY"
    for z in anchor:
        if z["st"] < ZONE_KEY_ST:
            continue
        if buy:
            if z["lo"] <= float(P["zone_hi"]) + 0.2 * a:
                continue
            if prev_c >= z["lo"] and now_c < z["lo"] - IMPORTANT_BREAK_ATR * a:
                return (f"area penting {z['lo']:.2f}-{z['hi']:.2f} tembus ke bawah, "
                        f"momentum menuju area fokus")
        else:
            if z["hi"] >= float(P["zone_lo"]) - 0.2 * a:
                continue
            if prev_c <= z["hi"] and now_c > z["hi"] + IMPORTANT_BREAK_ATR * a:
                return (f"area penting {z['lo']:.2f}-{z['hi']:.2f} tembus ke atas, "
                        f"momentum menuju area fokus")
    return None


def try_switch_focus(ranked_all, elig_live, a, now, bar_t, st5, st15):
    """Ganti fokus ke area lain HANYA jika area itu jauh lebih kuat dan stabil.
    Syarat: fokus belum tersentuh, belum ada posisi, sudah dipegang SWITCH_MIN_HOLD_SEC, ada jeda
    SWITCH_COOLDOWN_SEC dari penggantian terakhir, dan peringkat kandidat >= peringkat fokus + margin."""
    global PLAN_ACTIVE
    P = PLAN_ACTIVE
    if not SWITCH_ON or P is None or P.get("exec") or P.get("touched") or cache["open"]:
        return False
    if PENDING.get("touched"):
        return False
    if now - P.get("since", now) < SWITCH_MIN_HOLD_SEC or now - SWITCH_STATE["t"] < SWITCH_COOLDOWN_SEC:
        return False
    cur = match_focus(P, ranked_all, a)
    on = learning_on()
    thr = lock_threshold(now) * 100
    best = next((s for s in elig_live
                 if not same_area(P, s, a)
                 and stable_ok(s, a, now)
                 and (not on or (s["p"] >= thr and s["ev"] >= ENTRY_MIN_EV))), None)
    if best is None:
        return False
    if cur is not None and cur["eligible"]:
        if best["rank"] < cur["rank"] + SWITCH_RANK_MARGIN:
            return False
        if (not FIXED_MODE and not SMART_MODE and best["p"] < cur["p"] + SWITCH_P_MARGIN
                and best["strength"] < cur["strength"] + 15.0):
            return False
    if PENDING["order"]:
        if not cancel_pending("diganti area yang lebih kuat", force=True, block=False):
            return False
    SWITCH_STATE["t"] = now
    cur_txt = (f"kekuatan {cur['strength']:.0f}, P {cur['p']}%, rank {cur['rank']}" if cur is not None
               else "area lama tidak terdeteksi lagi")
    _plan_log(now, P["id"],
              f"GANTI FOKUS {P['side']} {P['name']} ({P['zone_lo']}-{P['zone_hi']}) [{cur_txt}] -> "
              f"{best['side']} {best['name']} ({best['zone_lo']}-{best['zone_hi']}) "
              f"[kekuatan {best['strength']:.0f}, P {best['p']}%, rank {best['rank']}]")
    PLAN_ACTIVE = lock_focus(best, bar_t, now, st5, st15)
    LOCK_IDLE["since"] = 0.0
    return True

