_plan_br_v23 = plan_break_retest


def plan_break_retest(H, L, O, C, Av, a, n, T):
    out = _plan_br_v23(H, L, O, C, Av, a, n, T)
    cap = ZONE_CAP_BR_ATR * a
    for z in out:
        if z["zh"] - z["zl"] > cap:
            mid = (z["zl"] + z["zh"]) / 2.0
            z["zl"], z["zh"] = mid - cap / 2.0, mid + cap / 2.0
    return out


