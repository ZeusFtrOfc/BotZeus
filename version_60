    P = dict(best)
    P.update(id=f"P{PLAN_SEQ}", since=now, bar0=bar_t, st5n0=st5["note"], st15n0=st15["note"],
             exec=False, status="FOKUS", hold_min=0, ext=None, touched=False,
             bad_bars=0, out_n=0, brk_t=0.0)
    x = _area_by_id(best.get("aid")) if best.get("aid") else None
    if x is not None:
        x["commit"], x["commit_t"] = True, now
        x["commit_cv"] = float(x.get("cv", COMMIT_MIN_CV))
        P.update(commit=True, aid=x["aid"], cv=round(float(x["cv"]), 1), tier=x.get("tier", "-"))
        log(f"[KOMITMEN] {x['side']} {x['name']} [{x['tf']}] {x['zone_lo']}-{x['zone_hi']} "
            f"keyakinan {x['cv']:.0f} tier {x.get('tier')}: " + "; ".join((x.get("cv_notes") or [])[:3]))
    P["aksi"] = aksi_text(P["side"], "FOKUS", P["zone_lo"], P["zone_hi"], P["entry"])
    return P


def sniper_step(tick):
    """Tiap siklus bot: jika tidak ada fokus, komit area berkeyakinan terbaik."""
    global PLAN_ACTIVE
    if not SNIPER_ON or not LAST_CTX:
        return
    now = time.time()
    if PLAN_ACTIVE is not None or PENDING["order"] or cache["open"]:
        return
    if now < LOCK_PAUSE["until"] or now - START_T < STARTUP_WARM_SEC:
        return
    x = commit_pick(now, tick)
    if x is None:
        return
    a = float(LAST_CTX["a"])
    F = lock_focus(_sniper_setup(x, a, tick), int(LAST_CTX["T"][-1]), now, LAST_CTX["st5"], LAST_CTX["st15"])
    PLAN_ACTIVE = F
    LOCK_IDLE["since"] = 0.0
    _plan_log(now, F["id"],
              f"[KOMITMEN] FOKUS {F['side']} {F['name']} [{F['tf']}] {F['zone_lo']}-{F['zone_hi']} "
              f"keyakinan {F.get('cv', 0):.0f} tier {F.get('tier')} kuat {F['strength']:.0f} "
              f"jarak {F['dist_atr']} ATR. Limit dipasang di level presisi, tidak diganti kecuali area tembus")


