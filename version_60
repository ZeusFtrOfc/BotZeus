# ===================================================================
PAT_DEAD_FAILBREAK_BARS = 4     # candle blokir setelah breakout gagal (alasan lain tetap PAT_DEAD_BARS)
BOUNCE_ATR = 0.7                # zona dianggap "di batas channel" jika tengahnya sedekat ini (x ATR TF pola)
BOUNCE_MIN_STRENGTH = 60.0      # kekuatan area minimal untuk pantulan melawan bias channel
BOUNCE_CODES = ("CH_D", "CH_U", "RECT")   # hanya channel dan rectangle, bukan wedge atau segitiga


def pattern_against(s, ctx):
    """v23: sama seperti v18, ditambah pengecualian pantulan di batas channel/rectangle.
    Contoh: BUY di garis bawah Descending Channel diizinkan jika area kuat (>= BOUNCE_MIN_STRENGTH).
    Pola yang sudah breakout, wedge, dan segitiga tetap menolak sisi lawan."""
    if not PAT_AGAINST_ON:
        return None
    side = s["side"]
    buy = side == "BUY"
    mid = (float(s["zone_lo"]) + float(s["zone_hi"])) / 2.0
    t_now = int(ctx["T"][-1]) + 60
    strength = float(s.get("strength", 0.0))
    for tf, Lk in list(PAT_LOCK.items()):
        if float(Lk.get("quality", 0)) < PAT_AGAINST_MIN_Q:
            continue
        bias = Lk.get("bias")
        if bias not in ("BUY", "SELL") or bias == side:
            continue
        a_tf = next((float(x["a"]) for x in ctx["tfs"] if x["name"] == tf), float(ctx["a"]))
        nm = Lk["name"]
        if Lk["dir"] != 0:
            return f"melawan breakout {nm} [{tf}] ke arah {bias}"
        if Lk["kind"] == "lines":
            u, l = _line_at(Lk["up"], t_now), _line_at(Lk["lo"], t_now)
            if Lk.get("code") in BOUNCE_CODES and strength >= BOUNCE_MIN_STRENGTH:
                edge = l if buy else u            # BUY memantul di garis bawah, SELL di garis atas
                if abs(mid - edge) <= BOUNCE_ATR * a_tf:
                    continue
            if buy and mid > l - PAT_ESCAPE_ATR * a_tf:
                return f"BUY melawan pola {nm} [{tf}] berbias SELL, cari area SELL di garis atas pola"
            if (not buy) and mid < u + PAT_ESCAPE_ATR * a_tf:
                return f"SELL melawan pola {nm} [{tf}] berbias BUY, cari area BUY di garis bawah pola"
        else:
            ext = Lk.get("ext")
            if ext is None:
                continue
            nk = _line_at(Lk["neck"], t_now)
            if bias == "BUY" and (not buy) and ext - 0.2 * a_tf <= mid <= nk + 0.5 * a_tf:
                at_neck = mid >= nk - NECK_REJECT_ATR * a_tf
                if not (at_neck and strength >= NECK_REJECT_MIN_STRENGTH):
                    return f"SELL melawan pola {nm} [{tf}] berbias BUY (di tengah pola, bukan di neckline)"
            if bias == "SELL" and buy and nk - 0.5 * a_tf <= mid <= ext + 0.2 * a_tf:
                at_neck = mid <= nk + NECK_REJECT_ATR * a_tf
                if not (at_neck and strength >= NECK_REJECT_MIN_STRENGTH):
                    return f"BUY melawan pola {nm} [{tf}] berbias SELL (di tengah pola, bukan di neckline)"
    return None

