class NewsFeed:
    def __init__(self):
        self.events, self.t, self.ok = [], 0.0, False

    def refresh(self):
        if not NEWS_AUTO or time.time() - self.t < (3600 if self.ok else 900):
            return
        self.t = time.time()
        try:
            req = urllib.request.Request(NEWS_URL, headers={"User-Agent": "Mozilla/5.0"})
            with urllib.request.urlopen(req, timeout=8) as r:
                data = json.loads(r.read().decode("utf-8"))
            ev = []
            for e in data:
                if e.get("country") != "USD" or str(e.get("impact", "")).lower() != "high":
                    continue
                try:
                    ev.append((datetime.fromisoformat(e["date"]).astimezone(timezone.utc), str(e.get("title", ""))))
                except Exception:
                    continue
            self.events, self.ok = ev, True
        except Exception as e:
            self.ok = False
            print("berita otomatis gagal diambil (pakai NEWS_BLOCKS manual):", e)

    def blocked(self, now):
        for t, title in self.events:
            dt = (now - t).total_seconds()
            if -NEWS_BEFORE_MIN * 60 <= dt <= NEWS_AFTER_MIN * 60:
                return f"{title} {t:%H:%M} UTC"
        return None


