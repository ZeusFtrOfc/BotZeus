                if z and (z.get("nh", 0) + z.get("nl", 0)) > 0:
                    share = (z["nl"] if buy else z["nh"]) / float(z["nh"] + z["nl"])
                    if share == 0:
                        dp -= 0.04
                        tags.append("zona belum pernah jadi " + ("support" if buy else "resistance") + " (-4% P)")
                    elif share >= 0.5:
                        dp += 0.02
            pw = min(0.92, max(0.15, float(s["pw"]) + dp))
            gates = [g for g in s["gates"] if not g.startswith("probabilitas")]
            if pw < pmin:
                gates.append(f"probabilitas {pw * 100:.0f}% < {pmin * 100:.0f}%")
            if nrx >= V25_BAD_MIN_N and hr < V25_BAD_HOLD:
                gates.append(f"riwayat pantulan zona buruk: {hr * 100:.0f}% bertahan dari {nrx} sentuhan")
            tags.append(f"skor pantulan {rps * 100:.0f}% (bertahan {hr * 100:.0f}% dari {nrx} sentuhan, "
                        f"zona {zhi - zlo:.2f} USD) {dp * 100:+.0f}% P")
            s.update(pw=pw, p=round(pw * 100.0, 1), gates=gates, rps=round(rps, 3),
                     hold_rate=round(hr, 2), react_n=int(nrx),
                     rank=round(float(s["rank"]) + 20.0 * (rps - V25_RPS_BASE), 2),
                     tags=list(s["tags"]) + tags,
                     eligible=not [g for g in gates if ROOM_HARD or not g.startswith("ruang")])
        except Exception:
            log_exc("apply_v25")
    setups.sort(key=lambda s: (not s["eligible"], -s["rank"]))


