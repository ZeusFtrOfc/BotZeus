def true_range(df):
    pc = df["close"].shift()
    return pd.concat([df.high - df.low, (df.high - pc).abs(), (df.low - pc).abs()], axis=1).max(axis=1)


def atr(df, n=14):
    return true_range(df).ewm(alpha=1 / n, adjust=False).mean()


def adx(df, n=14):
    up, dn = df.high.diff(), -df.low.diff()
    pdm = pd.Series(np.where((up > dn) & (up > 0), up, 0.0), index=df.index)
    mdm = pd.Series(np.where((dn > up) & (dn > 0), dn, 0.0), index=df.index)
    a = true_range(df).ewm(alpha=1 / n, adjust=False).mean().replace(0, np.nan)
    pdi = 100 * pdm.ewm(alpha=1 / n, adjust=False).mean() / a
    mdi = 100 * mdm.ewm(alpha=1 / n, adjust=False).mean() / a
    dx = 100 * (pdi - mdi).abs() / (pdi + mdi).replace(0, np.nan)
    return dx.ewm(alpha=1 / n, adjust=False).mean()


def rsi(close, n=14):
    d = close.diff()
    up = d.clip(lower=0).ewm(alpha=1 / n, adjust=False).mean()
    dn = (-d.clip(upper=0)).ewm(alpha=1 / n, adjust=False).mean()
    rs = up / dn.replace(0, np.nan)
    return (100 - 100 / (1 + rs)).fillna(50)


def rates(tf, n=500):
    r = mt5.copy_rates_from_pos(SYMBOL, tf, 0, n)
    if r is None or len(r) < min(250, n):
        return None
    return pd.DataFrame(r).iloc[:-1]        # buang candle yang masih berjalan


def trend_of(close, lb=10):
    e50, e200 = ema(close, 50), ema(close, 200)
    slope = e50.iloc[-1] - e50.iloc[-1 - lb]
    c = close.iloc[-1]
    if e50.iloc[-1] > e200.iloc[-1] and c > e200.iloc[-1] and slope > 0:
        return "BUY"
    if e50.iloc[-1] < e200.iloc[-1] and c < e200.iloc[-1] and slope < 0:
        return "SELL"
    return "FLAT"


def pivots(H, L, n):
    """Swing high/low yang sudah terkonfirmasi: list (index, harga)."""
    ph, pl = [], []
    for i in range(n, len(H) - n):
        if H[i] == H[i - n:i + n + 1].max() and H[i] > H[i - 1]:
            ph.append((i, float(H[i])))
        if L[i] == L[i - n:i + n + 1].min() and L[i] < L[i - 1]:
            pl.append((i, float(L[i])))
    return ph, pl


def detect_regime(m5, A):
    adx5 = float(adx(m5).iloc[-1]) if m5 is not None else 20.0
    if not np.isfinite(adx5):
        adx5 = 20.0
    hot = float((A.iloc[-300:] < A.iloc[-1]).mean()) >= VOL_PCT
    regime = "TREND" if adx5 >= ADX_TREND else "RANGE" if adx5 < ADX_RANGE else "MIX"
    return regime, adx5, hot


def regime_adj(code, regime):
    if regime == "TREND":
        return (5, "regime trend cocok") if code in CONT else (-3, "regime trend kurang cocok")
    if regime == "RANGE":
        if code in ("SR", "LS"):
            return 5, "regime range cocok"
        if code in CONT:
            return -5, "regime range kurang cocok"
    return 0, None


def session_adj(h):
    if 12 <= h < 16:
        return 4, "overlap London-NY"
    if 7 <= h < 12 or 16 <= h < 20:
        return 2, "sesi aktif"
    if 0 <= h < 6 or h >= 22:
        return -3, "sesi sepi"
    return 0, None


